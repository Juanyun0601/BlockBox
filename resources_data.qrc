<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- 文本 / 数据类资源：开发时改动最频繁（QSS 样式、翻译、AI 提示词、题库等）。
             单独一个 qrc，改这里只会重新编译这一小块，不必重新生成几 MB 的图片资源代码。 -->
        <file>styles/style.qss</file>
        <!-- 只有简体中文和英文随安装包内置；其余语言的 .qm 作为语言包放在官网
             /assets/translations/，用户在「设置 > 语言」里选中时再下载（见 LanguageManager）。 -->
        <file>translations/BlockBox_zh.qm</file>
        <file>translations/BlockBox_en.qm</file>
        <file>utils/mod/mcmod_names.json</file>
        <file>resources/nonOccluding.json</file>
        <file>resources/projection_entity_models.json</file>
        <file>resources/command_database.json</file>
        <file>resources/bedrock_command_database.json</file>
        <file>resources/terracotta_version.json</file>
        <file>resources/gravitycone_version.json</file>
        <file>resources/ai_system_prompts.json</file>
        <file>resources/ai_models.json</file>
        <file>resources/ai_agent_tools.json</file>
        <!-- 离线崩溃规则库 -->
        <file>resources/crash_rules.json</file>
        <!-- 入站答题题库 -->
        <file>resources/quiz/quiz_bank.txt</file>
        <file>resources/quiz/quiz_bank_en.txt</file>
        <!-- 加载页「你知道吗」我的世界冷知识 -->
        <file>resources/trivia/mc_trivia.txt</file>
        <!-- DSH 桥接插件：设置 → AI 助手 → DeepSeek Harness 插件「一键安装」时释放到磁盘 -->
        <file>resources/dsh-plugin/index.js</file>
        <file>resources/dsh-plugin/package.json</file>
        <file>resources/dsh-plugin/cordis.patch.yml</file>
        <file>resources/dsh-plugin/icon.svg</file>
        <file>resources/dsh-plugin/README.md</file>
        <file>resources/dsh-plugin/locale/zh.json</file>
        <file>resources/dsh-plugin/locale/en.json</file>
        <file>resources/dsh-plugin/docs/DETAIL.md</file>
        <file>resources/dsh-plugin/docs/DETAIL.zh.md</file>
        <file>resources/dsh-plugin/docs/preview.svg</file>
        <!-- ZCode 桥接插件：设置 → AI 助手 → ZCode 插件「一键安装」时释放到磁盘 -->
        <file>resources/zcode-plugin/.zcode-plugin/plugin.json</file>
        <file>resources/zcode-plugin/dist/mcp/server.mjs</file>
        <file>resources/zcode-plugin/skills/blockbox-bridge/SKILL.md</file>
        <file>resources/zcode-plugin/README.md</file>
        <file>resources/zcode-plugin/marketplace.json</file>
    </qresource>
</RCC>
