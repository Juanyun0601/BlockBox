    color: @PRIMARY@;
}

/* 快捷键描�?�?12px 三级�?*/
QLabel#keyBindDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    margin-bottom: 12px;
