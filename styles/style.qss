    color: @TEXT_PRIMARY@;
}

/* 共享恢复默认按钮 �?玻璃态描�?*/
QPushButton#restoreDefaultsBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#restoreDefaultsBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 共享帮助按钮 �?圆形 28x28 */
QPushButton#helpButton {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    color: @TEXT_TERTIARY@;
}

QPushButton#helpButton:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

/* ============================================================
 * Section 37. 平台专属窗口控制按钮样式
 * ============================================================ */
/* macOS 窗口控制 �?12x12 圆形交通灯 */
QPushButton#macMinimizeBtn,
QPushButton#macMaximizeBtn,
QPushButton#macCloseBtn {
    border: none;
    border-radius: 999px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    margin: 0 4px;
}

QPushButton#macMinimizeBtn {
    background-color: #FFCC00;
}

QPushButton#macMaximizeBtn {
    background-color: #00CC00;
}

QPushButton#macCloseBtn {
    background-color: #FF3B30;
}

QPushButton#macCloseBtn:hover {
    background-color: @DANGER@;
}

QPushButton#macMinimizeBtn:hover {
    background-color: #FFCC00;
    border: 1px solid #E6B800;
}

QPushButton#macMaximizeBtn:hover {
    background-color: #00CC00;
    border: 1px solid #00B300;
}

/* Linux / HarmonyOS / 默认平台 窗口控制 �?�?Windows 视觉一�?*/
QPushButton#linuxMinimizeBtn,
QPushButton#linuxMaximizeBtn,
QPushButton#harmonyMinimizeBtn,
QPushButton#harmonyMaximizeBtn,
QPushButton#defaultMinimizeBtn,
QPushButton#defaultMaximizeBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#linuxMinimizeBtn:hover,
QPushButton#linuxMaximizeBtn:hover,
QPushButton#harmonyMinimizeBtn:hover,
QPushButton#harmonyMaximizeBtn:hover,
QPushButton#defaultMinimizeBtn:hover,
QPushButton#defaultMaximizeBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#linuxCloseBtn,
QPushButton#harmonyCloseBtn,
QPushButton#defaultCloseBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#linuxCloseBtn:hover,
QPushButton#harmonyCloseBtn:hover,
QPushButton#defaultCloseBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

QPushButton#linuxCloseBtn:pressed,
QPushButton#harmonyCloseBtn:pressed,
QPushButton#defaultCloseBtn:pressed {
    background-color: @DANGER_RGBA_38@;
}

