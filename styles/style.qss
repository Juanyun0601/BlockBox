}

/* 插件运行器对话框 */
QWidget#pluginRunnerDialog {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QLabel#pluginRunnerTitle {
    background-color: transparent;
