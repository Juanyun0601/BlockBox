    border: 1px solid @DANGER_BORDER@;
    border-radius: 9px;
    padding: 6px 16px;
    color: @DANGER@;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#localModelDelBtn:hover {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER@;
}

/* 本地模型拉取按钮 �?主色描边 */
QPushButton#localModelPullBtn {
    background-color: transparent;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 6px 16px;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#localModelPullBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
}

/* ------------------------------------------------------------
 * Section 35.3. LoadingOverlay / BlurLoadingOverlay 样式
 * ------------------------------------------------------------ */
/* 加载遮罩 �?半透明背景 */
QWidget#loadingOverlay,
QWidget#blurLoadingOverlay {
    background-color: @BLACK_RGBA_31@;
    border: none;
}

/* 加载中心组件 �?玻璃�?*/
QWidget#loadingCenterWidget,
QWidget#blurLoadingCenterWidget {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 32px;
}

/* 加载 spinner �?主色 */
QLabel#loadingSpinner {
    background-color: transparent;
    border: none;
    color: @ACCENT_TEXT@;
}

/* 加载进度�?�?主色 chunk */
QProgressBar#loadingProgressBar,
QProgressBar#blurLoadingProgressBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#loadingProgressBar::chunk,
QProgressBar#blurLoadingProgressBar::chunk {
    background-color: @PRIMARY@;
    border-radius: 4px;
}

/* 加载状态标�?*/
QLabel#loadingStatusLabel,
QLabel#blurLoadingProcessLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 14px;
    border: none;
}

/* 加载取消/诊断按钮 �?玻璃�?*/
QPushButton#loadingCancelButton,
QPushButton#blurLoadingDiagnoseBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#loadingCancelButton:hover,
QPushButton#blurLoadingDiagnoseBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 模糊加载进度�?进度条行 */
QWidget#blurLoadingProgressArea,
QWidget#blurLoadingBarRow {
    background-color: transparent;
    border: none;
}

/* 模糊加载百分�?�?16px 主色 */
QLabel#blurLoadingPercentLabel {
    background-color: transparent;
    color: @ACCENT_TEXT@;
    font-size: 16px;
    font-weight: 700;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 模糊加载错误标签 �?13px 危险�?*/
QLabel#blurLoadingErrorLabel {
    background-color: transparent;
    color: @DANGER@;
    font-size: 13px;
    border: none;
}

/* ------------------------------------------------------------
 * Section 35.4. SkillManagerDialog 样式
 * ------------------------------------------------------------ */
/* 技能管理卡�?�?玻璃�?*/
QWidget#skillManagerCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 20px;
}

/* 技能对话框标题 �?17px 800字重 */
QLabel#skillDialogTitle {
