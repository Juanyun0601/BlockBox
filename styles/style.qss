/* ============================================================
 * BlockBox QSS 样式�?�?对齐 HTML 原型设计语言
 * ----------------------------------------------
 * 设计语言：Minecraft-inspired Emerald + Light Glassmorphism
 * 主色：翡翠绿（由 @PRIMARY@ 占位符控制，默认 #2E7D32�?
 * 风格：玻璃拟态近�?+ 统一设计令牌 + 现代平滑过渡
 * 版本：v3.0 · 2026-08-11
 * ----------------------------------------------
 * 占位符体系：所有颜色使�?@PLACEHOLDER@ 形式�?
 *             �?ThemeManager::buildTokenTable() 在运行时替换�?
 *             不得引入新的占位符�?
 * ============================================================ */

/* ============================================================
 * 设计令牌参考表（Design Token Reference�?
 * ----------------------------------------------
 * 圆角（Radius）：
 *   --radius-xs:  4px   （微小元素）
 *   --radius-sm:  8px   （chip、badge、icon-btn�?
 *   --radius-md: 12px   （按钮、输入框、卡片）
 *   --radius-lg: 16px   （卡片容器、对话框�?
 *   --radius-xl: 22px   （大卡片、轮播）
 *   --radius-pill: 999px（胶囊按钮、switch�?
 *
 * 阴影（Shadow）：
 *   --shadow-sm:  0 1px 2px rgba(0,0,0,0.04)
 *   --shadow-md:  0 4px 16px rgba(0,0,0,0.08)
 *   --shadow-lg:  0 12px 40px rgba(0,0,0,0.1)
 *   --shadow-glow: 0 0 12px @PRIMARY_RGBA_26@
 *
 * 间距（Spacing）：
 *   --space-1:  4px   --space-2:  8px   --space-3: 12px
 *   --space-4: 16px   --space-5: 20px   --space-6: 24px
 *   --space-8: 32px   --space-10: 40px  --space-12: 48px
 *
 * 动效（Motion）：
 *   --ease-out:      cubic-bezier(0.16, 1, 0.3, 1)
 *   --ease-in-out:   cubic-bezier(0.65, 0, 0.35, 1)
 *   --ease-spring:   cubic-bezier(0.34, 1.56, 0.64, 1)
 *   --dur-fast:  150ms   --dur-base: 240ms
 *   --dur-slow:  380ms   --dur-page: 480ms
 *
 * Z-index�?
 *   --z-sidebar: 100   --z-subnav: 90
 *   --z-topbar: 200    --z-taskbar: 180
 *   --z-dropdown: 300  --z-modal: 1000  --z-tooltip: 1100
 * ============================================================ */

/* ============================================================
 * Section 3. 全局样式（QWidget、QMainWindow、QLabel、QFont�?
 * ============================================================ */
/* 全局 QWidget 基础样式
 * 注意：不在此处声�?background-color，否则所有未命名的布局容器（QWidget�?
 * 都会被涂�?@BG_BASE@，在自定义图�?纯色背景模式下会形成白色块挡住背景�?
 * 基础底色�?QMainWindow / #contentWrapper / 各显式规则提供；
 * �?QWidget 容器保持透明，让自定义背景完整透出�?*/
QWidget {
    color: @TEXT_PRIMARY@;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

/* 主窗口背�?*/
QMainWindow {
    background-color: @BG_BASE@;
}

/* 通用 QLabel 样式 */
QLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
}

/* 通用 QLabel 禁用�?*/
QLabel:disabled {
    color: @TEXT_DISABLED@;
}

/* 顶栏标题标签 */
QLabel#titleLabel {
    font-size: 13px;
    font-weight: normal;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
    border: none;
}

/* 顶栏账户名标�?*/
QPushButton#accountNameLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
}

QPushButton#accountNameLabel:hover {
    color: @PRIMARY@;
}

/* 页面顶部过滤/搜索操作条：微透明玻璃态卡片
 * （安装新实例、基岩版下载、Mod/内容下载、基岩内容、实例/基岩资源页共用） */
QWidget#filterCard {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#filterCard QLabel {
    background-color: transparent;
    border: none;
}

/* 章节标题标签 */
QLabel#sectionTitle {
    font-size: 22px;
    font-weight: bold;
    color: @TEXT_PRIMARY@;
    margin-bottom: 10px;
}

/* 设置页章节标题（对应原型 .settings-section-title 22px 800�?*/
SettingsPage QLabel#sectionTitle {
    font-size: 22px;
    font-weight: 800;
    color: @TEXT_PRIMARY@;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    padding-bottom: 2px;
}

/* 高级用户提示 */
QLabel#advancedHintLabel {
    font-size: 14px;
    font-weight: bold;
    color: @DANGER@;
    margin-bottom: 10px;
    padding: 10px 14px;
    background-color: @DANGER_BG@;
    border-radius: 12px;
    border-left: 4px solid @DANGER@;
}

/* 内存提示 */
QLabel#memoryHintLabel {
    font-size: 12px;
    color: @INFO@;
}

/* Java 版本提示 */
QLabel#javaVersionLabel {
    font-size: 12px;
    color: @PRIMARY@;
    margin-top: 5px;
}

/* ============================================================
 * Section 4. 顶栏样式（TopBar、titleCardContainer、funcCard、accountCard、gameCard�?
 * ============================================================ */
/* 顶栏容器 �?毛玻璃渐变近�?*/
TopBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.92),
        stop:1 rgba(255, 255, 255, 0.75));
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* 顶栏分隔�?*/
QFrame#topBarSeparator {
    background-color: @BORDER_LIGHT@;
    max-width: 1px;
    min-width: 1px;
}

/* 顶栏标题卡片容器 �?玻璃态近�?*/
QWidget#titleCardContainer {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QWidget#titleCardContainer:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 顶栏功能卡片 �?玻璃态近�?*/
QWidget#funcCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QWidget#funcCard:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 顶栏账户卡片 �?玻璃态近�?*/
QWidget#accountCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QWidget#accountCard:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 顶栏版本切换卡片 �?玻璃�?+ 版本色边框（Java 翠绿 / 基岩青） */
QWidget#editionCard {
    background-color: @BG_CARD@;
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 12px;
}

QWidget#editionCard:hover {
    background-color: @BG_HOVER@;
    border-color: rgba(16, 185, 129, 0.55);
}

QWidget#editionCard[javaEdition="false"] {
    border-color: rgba(6, 182, 212, 0.4);
}

QWidget#editionCard[javaEdition="false"]:hover {
    border-color: rgba(6, 182, 212, 0.55);
}

/* 版本切换卡片 �?光晕层（Java 翠绿渐变�?*/
QLabel#editionGlowJava {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(16, 185, 129, 0.16),
        stop:1 rgba(16, 185, 129, 0.02));
    border-radius: 12px;
}

/* 版本切换卡片 �?光晕层（基岩青色渐变�?*/
QLabel#editionGlowBedrock {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(6, 182, 212, 0.16),
        stop:1 rgba(6, 182, 212, 0.02));
    border-radius: 12px;
}

/* 版本切换卡片 �?Java 版文字（深绿�?*/
QLabel#editionJavaText {
    background-color: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #047857;
}

/* 版本切换卡片 �?基岩版文字（深青�?*/
QLabel#editionBedrockText {
    background-color: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #0E7490;
}

/* 版本切换卡片 �?文字裁剪容器 */
QScrollArea#editionTextWrap {
    background-color: transparent;
    border: none;
}

/* 版本切换卡片 �?状态圆点（Java 翠绿�?*/
QLabel#editionDot {
    background-color: #10B981;
    border: 2px solid rgba(16, 185, 129, 0.22);
    border-radius: 4px;
}

/* 版本切换卡片 �?状态圆点（基岩青） */
QLabel#editionDot[javaEdition="false"] {
    background-color: #06B6D4;
    border: 2px solid rgba(6, 182, 212, 0.22);
}

/* 顶栏游戏卡片 �?玻璃态近�?*/
QWidget#gameCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QWidget#gameCard:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 顶栏后退按钮 */
QPushButton#topBarBackBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#topBarBackBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#topBarBackBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 顶栏翻译按钮 */
QPushButton#topBarTranslateBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#topBarTranslateBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#topBarTranslateBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 顶栏前进按钮 */
QPushButton#topBarForwardBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#topBarForwardBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#topBarForwardBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 顶栏刷新按钮 */
QPushButton#topBarRefreshBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#topBarRefreshBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#topBarRefreshBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 帮助按钮 */
QToolButton#helpButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
}

QToolButton#helpButton:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QToolButton#helpButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 顶栏实例名标�?*/
QLabel#instanceNameLabel {
    font-size: 13px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
    padding: 0 4px;
}

/* 顶栏搜索图标按钮 */
QPushButton#topBarSearchBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
}

QPushButton#topBarSearchBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

/* 顶栏账户头像 */
QLabel#accountAvatar {
    background-color: @PRIMARY@;
    border-radius: 12px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
    font-size: 13px;
}

/* 顶栏窗口控制按钮 �?最小化 */
QPushButton#minimizeBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#minimizeBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 顶栏窗口控制按钮 �?最大化/还原 */
QPushButton#maximizeBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#maximizeBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 顶栏窗口控制按钮 �?关闭 */
QPushButton#closeBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#closeBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

QPushButton#closeBtn:pressed {
    background-color: @DANGER_RGBA_38@;
}

/* ============================================================
 * Section 5. 侧边栏样式（SideBar、parentNavButton、sidebarSelectionHighlight�?
 * ============================================================ */
/* 侧边栏容�?�?渐变背景近似毛玻�?*/
SideBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.85),
        stop:1 rgba(248, 250, 252, 0.9));
    border-right: 1px solid @BORDER_LIGHT@;
}

/* 侧边栏滚动区�?*/
SideBar QScrollArea {
    background-color: transparent;
    border: none;
}

SideBar QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

SideBar QScrollArea > QWidget {
    background-color: transparent;
}

/* 侧边栏分隔线 */
QFrame#sideSeparator {
    background-color: @BORDER_LIGHT@;
    max-width: 1px;
    min-width: 1px;
}

/* 侧边栏一级导航按�?�?默认�?*/
QPushButton#parentNavButton {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 8px 4px;
    color: @TEXT_TERTIARY@;
    text-align: center;
    font-size: 10px;
    font-weight: 500;
}

/* 侧边栏一级导航按�?�?悬停�?*/
QPushButton#parentNavButton:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

/* 侧边栏一级导航按�?�?选中态（主色渐变背景�?*/
QPushButton#parentNavButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @PRIMARY@;
}

/* 侧边栏选中指示�?�?3px 主色�?+ 辉光 */
QWidget#sidebarSelectionHighlight {
    background-color: @PRIMARY@;
    border-radius: 0 3px 3px 0;
    border: none;
    min-width: 3px;
    max-width: 3px;
}

/* 侧边栏导航图标标�?*/
QLabel#parentNavIconLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 侧边栏导航文字标�?*/
QLabel#parentNavTextLabel {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
}

/* 侧边栏导航徽�?*/
QLabel#parentNavBadgeLabel {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 600;
    padding: 0 4px;
    min-width: 16px;
    min-height: 16px;
}

/* 侧边栏底部版本徽�?*/
QLabel#sidebarVersionLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
    padding: 4px;
}

/* 侧边栏底�?展开子导�?按钮 �?子导航面板收起后显示 */
QPushButton#sidebarExpandBtn {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    color: @TEXT_TERTIARY@;
}

QPushButton#sidebarExpandBtn:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @PRIMARY@;
}

QPushButton#sidebarExpandBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* ============================================================
 * Section 6. 子导航样式（SubNavPanel、subNavButton、subNavHighlight�?
 * ============================================================ */
/* 子导航面板容�?�?玻璃态近�?*/
SubNavPanel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 16px;
}

/* 头部上缘随面板圆角收口，避免横线压在直角上 */
SubNavPanel #subNavHeader {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

/* 子导航面板滚动区�?*/
SubNavPanel QScrollArea {
    background-color: transparent;
    border: none;
}

SubNavPanel QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

SubNavPanel QScrollArea > QWidget {
    background-color: transparent;
}

/* 子导航分隔线 */
QFrame#subNavSeparator {
    background-color: @BORDER_LIGHT@;
    max-width: 1px;
    min-width: 1px;
}

/* 子导航分组标�?*/
QLabel#subNavGroupTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 12px 12px 4px 12px;
    text-transform: uppercase;
}

/* 子导航按�?�?默认�?*/
QPushButton#subNavButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    color: @TEXT_SECONDARY@;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

/* 子导航按�?�?悬停�?*/
QPushButton#subNavButton:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

/* 子导航按�?�?选中态（主色渐变背景�?*/
QPushButton#subNavButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @PRIMARY@;
}

/* 子导航选中指示�?�?3px 主色�?*/
QWidget#subNavHighlight {
    background-color: @PRIMARY@;
    border-radius: 0 3px 3px 0;
    border: none;
    min-width: 3px;
    max-width: 3px;
}

/* 子导航图标标�?*/
QLabel#subNavIconLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 子导航文字标�?*/
QLabel#subNavTextLabel {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 13px;
    font-weight: 500;
}

/* 子导航徽�?*/
QLabel#subNavBadgeLabel {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 600;
    padding: 0 6px;
    min-height: 16px;
}

/* ============================================================
 * Section 7. 页面容器样式（HomePage、ResourcesPage、SettingsPage 等）
 * ============================================================ */
/* 内容包装�?*/
QWidget#contentWrapper {
    background-color: @BG_BASE@;
}

/* 页面容器通用样式 */
HomePage, ResourcesPage, BrowsePage, SettingsPage, SearchPage {
    background-color: @BG_BASE@;
}

/* QStackedWidget 容器 */
QStackedWidget {
    background-color: @BG_BASE@;
    border: none;
}

/* 设置页右侧内容区 */
QFrame#settingsRightFrame {
    background-color: @BG_CONTENT@;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* 设置页右侧滚动区�?*/
SettingsPage QScrollArea {
    background-color: transparent;
    border: none;
}

SettingsPage QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 通用页面滚动区域 */
QScrollArea#pageScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#pageScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 消息�?*/
QFrame#messageBar {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
    padding: 8px 12px;
}

QLabel#messageBarLabel {
    background-color: transparent;
    color: @TEXT_ACCENT@;
    font-size: 13px;
}

QLabel#messageBarIcon {
    background-color: transparent;
    border: none;
}

/* 修改现有实例模式 */
QWidget#modifyBanner {
    background-color: @PRIMARY_RGBA_10@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
}

QLabel#modifyBannerLabel {
    background-color: transparent;
    border: none;
    color: @PRIMARY_TEXT@;
    font-size: 13px;
}

QWidget#modifyInfoBar {
    background-color: @PRIMARY_RGBA_10@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
}

QLabel#modifyInfoLabel {
    background-color: transparent;
    border: none;
    color: @PRIMARY_TEXT@;
    font-size: 13px;
}

/* ============================================================
 * Section 8. 按钮样式（通用 QPushButton、具名按钮）
 * ============================================================ */
/* 通用 QPushButton 默认样式 */
QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

/* 通用 QPushButton 悬停�?*/
QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 通用 QPushButton 按下�?*/
QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 通用 QPushButton 禁用�?*/
QPushButton:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 启动游戏按钮 �?主色渐变 + 阴影 */
/* TopBar launch button (instance card limits it to 32px high -> max 16px radius) */
QPushButton#launchGameBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 16px;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 600;
}

/* 启动游戏按钮 �?悬停态（阴影增强近似�?*/
QPushButton#launchGameBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
    padding: 7px 24px 9px 24px;
}

/* 启动游戏按钮 �?按下�?*/
QPushButton#launchGameBtn:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_PRESSED@,
        stop:1 @PRIMARY_DARK@);
    padding: 9px 24px 7px 24px;
}

/* 启动游戏按钮 �?禁用�?*/
QPushButton#launchGameBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 实例选择按钮 �?无边框图标按钮（与实例设�?助手按钮一致） */
QPushButton#instanceSelectBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#instanceSelectBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#instanceSelectBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 恢复默认按钮 �?幽灵按钮 */
QPushButton#restoreDefaultsBtn {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton#restoreDefaultsBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border-color: @BORDER_STRONG@;
}

/* 浏览按钮 */
QPushButton#browseBtn {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 13px;
}

QPushButton#browseBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY@;
    color: @PRIMARY@;
}

QPushButton#browseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 侧边工具按钮 */
QPushButton#sideToolBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
}

QPushButton#sideToolBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#sideToolBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 窗口控制按钮 �?通用 */
QPushButton#windowControlBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#windowControlBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 取消按钮 */
QPushButton#cancelButton {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#cancelButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 圆形图标按钮 */
QToolButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 999px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QToolButton#iconButton:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QToolButton#iconButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 卡片操作按钮 �?小号主按�?*/
QPushButton#cardPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#cardPrimaryBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QPushButton#cardPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 卡片操作按钮 �?小号次要按钮 */
QPushButton#cardSecondaryBtn {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#cardSecondaryBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 危险按钮 */
QPushButton#dangerBtn {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: @DANGER_HOVER@;
}

QPushButton#dangerBtn:pressed {
    background-color: @DANGER_PRESSED@;
}

/* 链接按钮 */
QPushButton#linkButton {
    background-color: transparent;
    color: @LINK@;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
    text-align: left;
}

QPushButton#linkButton:hover {
    color: @LINK_HOVER@;
    text-decoration: underline;
}

/* ============================================================
 * Section 9. 表单控件样式（QLineEdit、QComboBox、QSpinBox、QSlider、QCheckBox、QRadioButton�?
 * ============================================================ */
/* QLineEdit 文本输入�?�?默认�?*/
QLineEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

/* QLineEdit 悬停�?*/
QLineEdit:hover {
    border-color: @BORDER_STRONG@;
}

/* QLineEdit 聚焦�?�?主色边框 + 光晕近似 */
QLineEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
    background-color: @BG_CARD@;
}

/* QLineEdit 禁用�?*/
QLineEdit:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QLineEdit 只读�?*/
QLineEdit:read-only {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border-color: @BORDER@;
}

/* QLineEdit 占位符文�?*/
/* 注：Qt QSS 不支持属性选择�?`[attr!=""]`，该写法会导致整份样式表解析失败�?
   故移除。Qt 亦无 QSS 原生的占位符伪状态，占位符颜色交由控件内代码处理�?*/

/* QTextEdit 多行文本�?�?默认�?*/
QTextEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QTextEdit:hover {
    border-color: @BORDER_STRONG@;
}

QTextEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
}

QTextEdit:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QPlainTextEdit 纯文本编辑框 */
QPlainTextEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QPlainTextEdit:hover {
    border-color: @BORDER_STRONG@;
}

QPlainTextEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
}

/* QComboBox 下拉选择�?�?默认�?*/
QComboBox {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 32px 6px 12px;
    font-size: 13px;
    min-height: 20px;
}

/* QComboBox 悬停�?*/
QComboBox:hover {
    border-color: @BORDER_STRONG@;
}

/* QComboBox 聚焦�?�?主色边框 */
QComboBox:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 5px 31px 5px 11px;
}

/* QComboBox 禁用�?*/
QComboBox:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QComboBox 下拉按钮 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: transparent;
}

QComboBox::drop-down:hover {
    background-color: @BG_HOVER@;
}

/* QComboBox 下拉箭头 */
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    width: 0;
    height: 0;
}

QComboBox::down-arrow:hover {
    border-top-color: @PRIMARY@;
}

/* QComboBox 下拉列表视图 */
QComboBox QAbstractItemView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 12px;
    border-radius: 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
}

/* QSpinBox 数字输入�?�?默认�?*/
QSpinBox {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 32px 6px 12px;
    font-size: 13px;
    min-height: 20px;
}

QSpinBox:hover {
    border-color: @BORDER_STRONG@;
}

QSpinBox:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 5px 31px 5px 11px;
}

QSpinBox:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QSpinBox 上按�?*/
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 12px;
    background-color: transparent;
}

QSpinBox::up-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::up-button:pressed {
    background-color: @BG_PRESSED@;
}

/* QSpinBox 上箭�?*/
QSpinBox::up-arrow {
    width: 10px;
    height: 10px;
    background-color: @TEXT_TERTIARY@;
}

QSpinBox::up-button:hover > QSpinBox::up-arrow {
    background-color: @PRIMARY@;
}

/* QSpinBox 下按�?*/
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-bottom-right-radius: 12px;
    background-color: transparent;
}

QSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::down-button:pressed {
    background-color: @BG_PRESSED@;
}

/* QSpinBox 下箭�?*/
QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    background-color: @TEXT_TERTIARY@;
}

QSpinBox::down-button:hover > QSpinBox::down-arrow {
    background-color: @PRIMARY@;
}

/* QSlider 整体 �?清除 widget 背景 */
QSlider {
    background: transparent;
}

/* QSlider 滑块 �?凹槽 */
QSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?已填充部分（主色渐变�?*/
QSlider::sub-page:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 999px;
}

QSlider::sub-page:vertical {
    background-color: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?未填充部�?*/
QSlider::add-page:horizontal {
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider::add-page:vertical {
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?手柄（主色实�?+ 柔和光晕�?*/
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -8px 0;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
}

QSlider::handle:vertical {
    width: 20px;
    height: 20px;
    margin: 0 -8px;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
}

QSlider::handle:horizontal:hover {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.65 @PRIMARY_HOVER@,
        stop:0.85 @PRIMARY_RGBA_51@,
        stop:1 @PRIMARY_RGBA_12@);
}

QSlider::handle:vertical:hover {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.65 @PRIMARY_HOVER@,
        stop:0.85 @PRIMARY_RGBA_51@,
        stop:1 @PRIMARY_RGBA_12@);
}

QSlider::handle:horizontal:pressed {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_PRESSED@,
        stop:0.6 @PRIMARY_PRESSED@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
}

/* 线程数滑块定�?*/
QSlider#threadCountSlider::groove:horizontal {
    height: 8px;
}

QSlider#threadCountSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
}

/* 内存滑块定制 */
QSlider#memorySlider::groove:horizontal {
    height: 8px;
}

QSlider#memorySlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
}

/* QCheckBox 复选框 �?文字部分 */
QCheckBox {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    spacing: 8px;
    padding: 2px;
}

QCheckBox:hover {
    color: @TEXT_PRIMARY@;
}

QCheckBox:disabled {
    color: @TEXT_DISABLED@;
}

/* QCheckBox 指示�?�?未选中态（圆角胶囊近似�?*/
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid @BORDER_HOVER@;
    background-color: @BG_CARD@;
}

QCheckBox::indicator:hover {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}

QCheckBox::indicator:disabled {
    border-color: @BORDER_DISABLED@;
    background-color: @BG_DISABLED@;
}

/* QCheckBox 指示�?�?选中态（主色渐变�?*/
QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 2px solid @PRIMARY_DARK@;
    border-radius: 6px;
}

QCheckBox::indicator:checked:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
    border: 2px solid @PRIMARY@;
}

/* QCheckBox 三态指示器 */
QCheckBox::indicator:indeterminate {
    background-color: @PRIMARY_BG@;
    border: 2px solid @PRIMARY@;
    border-radius: 6px;
}

/* QRadioButton 单选按钮 - 现代化样式 */
QRadioButton {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    spacing: 8px;
    padding: 4px 2px;
    outline: none;
}

QRadioButton:hover {
    color: @PRIMARY@;
}

QRadioButton:disabled {
    color: @TEXT_DISABLED@;
}

/* QRadioButton 指示器 - 默认未选中状态 */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    border: 2px solid @BORDER_HOVER@;
    background-color: @BG_CARD@;
    margin: 0;
}

/* 悬停状态 - 边框变为主色 */
QRadioButton::indicator:hover {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}

/* 禁用状态 */
QRadioButton::indicator:disabled {
    border-color: @BORDER_DISABLED@;
    background-color: @BG_DISABLED@;
}

/* 选中状态 - 主色边框 + 内圆点 */
QRadioButton::indicator:checked {
    border: 2px solid @PRIMARY@;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.35 @PRIMARY@,
        stop:0.4 @BG_CARD@,
        stop:1 @BG_CARD@);
}

/* 选中悬停状态 - 边框加深 */
QRadioButton::indicator:checked:hover {
    border-color: @PRIMARY_HOVER@;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.35 @PRIMARY_HOVER@,
        stop:0.4 @BG_CARD@,
        stop:1 @BG_CARD@);
}

/* 焦点状态 - 添加外发光效果 */
QRadioButton:focus {
    color: @PRIMARY@;
}

QRadioButton:focus::indicator {
    border-color: @PRIMARY@;
    box-shadow: 0 0 0 3px @PRIMARY_RGBA_26@;
}

/* 伪态补�?*/
QSlider:focus::groove {
    border: 1px solid @PRIMARY@;
}

QSlider:disabled {
    color: @TEXT_DISABLED@;
}

QSlider:disabled::groove {
    background-color: transparent;
}

QSlider:disabled::handle:horizontal,
QSlider:disabled::handle:vertical {
    background-color: transparent;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border: 1px solid @PRIMARY@;
}

QCheckBox::indicator:indeterminate {
    background-color: @PRIMARY_RGBA_18@;
    border: 1px solid @PRIMARY@;
}

QComboBox:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QComboBox:on {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: @BG_MUTED@;
}

QLineEdit:readonly {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
}

QLineEdit:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QTabBar::tab:pressed {
    background-color: @PRIMARY_RGBA_38@;
}

QToolButton:disabled {
    color: @TEXT_DISABLED@;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    padding-right: 4px;
}

QProgressBar:busy::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 999px;
}

/* ============================================================
 * Section 10. 列表样式（QListWidget、QTreeWidget、QTableWidget�?
 * ============================================================ */
/* QListWidget 列表控件 */
QListWidget {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 8px 12px;
    border-radius: 8px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
}

QListWidget::item:selected:!active {
    background-color: @PRIMARY_RGBA_12@;
    color: @TEXT_PRIMARY@;
}

QListWidget::item:disabled {
    color: @TEXT_DISABLED@;
}

/* QTreeWidget 树形控件 */
QTreeWidget, QTreeView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QTreeWidget::item, QTreeView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 8px;
    border-radius: 8px;
    min-height: 20px;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: @BG_HOVER@;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
}

QTreeWidget::item:selected:!active, QTreeView::item:selected:!active {
    background-color: @PRIMARY_RGBA_12@;
    color: @TEXT_PRIMARY@;
}

/* QTreeWidget 分支指示�?*/
QTreeWidget::branch:has-siblings:!adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:has-siblings:adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    background-color: transparent;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    background-color: transparent;
    border-image: none;
}

/* QTableWidget 表格控件 */
QTableWidget, QTableView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    gridline-color: @BORDER_LIGHT@;
    outline: none;
    font-size: 13px;
}

QTableWidget::item, QTableView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 10px;
    border: none;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: @BG_HOVER@;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
}

/* QTableWidget 表头 */
QHeaderView::section {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid @BORDER_LIGHT@;
    border-bottom: 1px solid @BORDER_LIGHT@;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QHeaderView::section:pressed {
    background-color: @BG_PRESSED@;
}

/* QTableWidget 角落按钮 */
QTableCornerButton::section {
    background-color: @BG_MUTED@;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    border-right: 1px solid @BORDER_LIGHT@;
}

/* ============================================================
 * Section 11. 容器样式（QGroupBox、QTabWidget、QScrollArea、QStackedWidget�?
 * ============================================================ */
/* QGroupBox 分组容器 */
QGroupBox {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    font-size: 14px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
}

/* QGroupBox 标题 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: @BG_BASE@;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

/* QTabWidget 选项卡容�?*/
QTabWidget::pane {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
}

/* QTabWidget 选项卡栏 */
QTabBar::tab {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    margin: 2px 1px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QTabBar::tab:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
    font-weight: 600;
}

QTabBar::tab:selected:hover {
    background-color: @PRIMARY_RGBA_26@;
}

/* QTabBar 关闭按钮 */
QTabBar::close-button {
    image: none;
    subcontrol-position: right;
    border: none;
    border-radius: 4px;
    padding: 2px;
    background-color: transparent;
}

QTabBar::close-button:hover {
    background-color: @DANGER_BG@;
}

/* QScrollArea 滚动区域
 * 注意：此处不得声�?border/border-radius，否则所有未命名�?QScrollArea
 * （如 HomePage、SettingsPage 外层、ResourcesPage 等）
 * 会被一圈圆角灰边包围。需边框的滚动区�?#id 规则单独声明�?*/
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* QStackedWidget 堆栈窗口 */
QStackedWidget {
    background-color: transparent;
    border: none;
}

/* QFrame 通用框架 */
QFrame {
    background-color: transparent;
    border: none;
}

/* QProgressBar 进度�?*/
QProgressBar {
    background-color: @BG_TRACK@;
    color: @TEXT_PRIMARY@;
    border: none;
    border-radius: 999px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border-radius: 999px;
}

/* QProgressBar 大号进度�?*/
QProgressBar#largeProgressBar {
    min-height: 8px;
    max-height: 8px;
}

/* QProgressBar 卡片内进度条 */
QProgressBar#cardProgressBar {
    min-height: 4px;
    max-height: 4px;
}

/* ============================================================
 * Section 12. 对话框样式（QDialog、QMessageBox、QDialogButtonBox�?
 * ============================================================ */
/* QDialog 对话框容�?*/
QDialog {
    background-color: @BG_CARD@;
    border-radius: 16px;
}

/* QDialog 标签 */
QDialog QLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
}

/* QDialog 按钮 */
QDialog QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    min-width: 80px;
}

QDialog QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QDialog QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* QDialog 默认按钮（主操作�?*/
QDialog QPushButton#defaultButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

QDialog QPushButton#defaultButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QDialog QPushButton#defaultButton:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* QDialogButtonBox 按钮�?*/
QDialogButtonBox {
    background-color: transparent;
    border: none;
}

QDialogButtonBox QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    min-width: 80px;
}

QDialogButtonBox QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* QDialogButtonBox 确认按钮 */
QDialogButtonBox QPushButton[text="OK"],
QDialogButtonBox QPushButton[text="确定"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

/* QMessageBox 消息�?*/
QMessageBox {
    background-color: @BG_CARD@;
    border-radius: 16px;
}

QMessageBox QLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    min-width: 280px;
}

QMessageBox QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 20px;
    font-size: 13px;
    min-width: 72px;
}

QMessageBox QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QMessageBox QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* QMessageBox 信息图标 */
QMessageBox QLabel#iconLabel {
    background-color: transparent;
    border: none;
}

/* ============================================================
 * Section 13. 卡片体系样式（cardRole="container"/"icon"/"cover"/"iconOverlay"/"name"/"chip"/"actionBtn"/"favBtn"�?
 * ============================================================ */
/* 卡片容器 �?玻璃态近�?+ hover 上浮 */
QWidget[cardRole="container"] {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 12px;
}

/* 卡片容器 �?悬停态（背景提亮 + 边框泛主色；不使用负 margin，负 margin 会被 Qt 裁切导致卡片上移残缺�?*/
QWidget[cardRole="container"]:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 卡片图标 �?圆角方块�?*/
QLabel[cardRole="icon"] {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 卡片封面�?�?统一圆角 */
QLabel[cardRole="cover"] {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 12px;
    min-height: 80px;
}

/* 卡片图标叠加�?*/
QLabel[cardRole="iconOverlay"] {
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    padding: 8px;
}

/* 卡片标题（无边框） */
QLabel[cardRole="name"] {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 卡片英文�?*/
QLabel[cardRole="nameEnglish"] {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 400;
    border: none;
    padding: 0;
}

/* 卡片信息芯片（无边框胶囊，仅用淡主色底）
   注意：radius 必须不超过芯片高度一半，Qt QSS 不会像 CSS 那样
   自动收敛超大半径，999px 会被忽略渲染成直角 */
QLabel[cardRole="chip"] {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片描述文本 */
QLabel[cardRole="description"] {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    border: none;
    padding: 0;
}

/* 卡片下载�?*/
QLabel[cardRole="downloadCount"] {
    background-color: @BG_MUTED@;
    color: @TEXT_TERTIARY@;
    border: none;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片版本标签（无边框胶囊） */
QLabel[cardRole="version"] {
    background-color: @INFO_BG@;
    color: @INFO@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片标签（无边框胶囊） */
QLabel[cardRole="tag"] {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片操作按钮 �?图标式圆�?*/
QPushButton[cardRole="actionBtn"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton[cardRole="actionBtn"]:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton[cardRole="actionBtn"]:pressed {
    background-color: @BG_PRESSED@;
}

/* 卡片收藏按钮 �?主色圆角 */
QPushButton[cardRole="favBtn"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton[cardRole="favBtn"]:hover {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
}

QPushButton[cardRole="favBtn"]:pressed {
    background-color: @BG_PRESSED@;
}

/* 瀑布流内容卡片（contentCard：首页最近游�?/ 实例选择 / 模组瀑布流等�?
   banner 在代码中已内�?1px，边框不会被封面盖住，可安全�?1px 描边 */
QWidget#contentCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QWidget#contentCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 16px;
}

/* 实例选择页瀑布流卡片：无鼠标悬浮效果 */
QWidget#contentCard[flatCard="true"],
QWidget#contentCard[flatCard="true"]:hover {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 瀑布流内容卡片操作按�?�?图标式圆�?*/
QPushButton#contentCardActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#contentCardActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#contentCardActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 性能卡片进度�?*/
QProgressBar#perfProgressBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 999px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#perfProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border-radius: 999px;
}

/* ============================================================
 * 首页最近游玩卡片（recentPlay* 专属样式）
 * 不与 contentCard / modCard 系列共用，观感可独立调整
 * ============================================================ */
/* ── 卡片（固定一行四个） ── */
QWidget#recentPlayCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 0;
}

QWidget#recentPlayCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 16px;
}

/* 卡片名称 */
QLabel#recentPlayName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 卡片最近游玩时间行 */
QLabel#recentPlayTime {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
    padding: 0;
}

/* 卡片操作按钮（更多） */
QPushButton#recentPlayActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 5px;
    color: @TEXT_TERTIARY@;
}

QPushButton#recentPlayActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#recentPlayActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 卡片启动按钮（主色填充圆角，图标 + 文字）
 * 注意：Qt 对超过控件高度一半的圆角不做过 clamp，而是直接跳过圆角渲染
 * （同 overviewLaunchBtn 的注释）。按钮 min-height 22px，故半角为 11px。 */
QPushButton#recentPlayLaunchBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 11px;
    min-height: 22px;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#recentPlayLaunchBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#recentPlayLaunchBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

/* 网站推荐卡片 */
QWidget#websiteCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px 16px;
}

QWidget#websiteCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    margin: 0 2px 0 -2px;
}

/* 网站卡片名称 */
QLabel#websiteName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 网站卡片描述 */
QLabel#websiteUrl {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* ============================================================
 * Section 14. 任务栏样式（taskScrollArea、launchTaskCard、downloadTaskCard、aggregateTaskCard�?
 * ============================================================ */
/* 任务栏滚动区�?*/
QScrollArea#taskScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#taskScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 启动任务卡片 �?玻璃态近�?*/
QWidget#launchTaskCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    min-width: 240px;
}

QWidget#launchTaskCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* 启动任务卡片状态文�?*/
QWidget#launchTaskCard QLabel#statusTextLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 启动任务卡片消息文本 */
QWidget#launchTaskCard QLabel#messageLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
}

/* 启动任务卡片进度文本 */
QWidget#launchTaskCard QLabel#progressLabel {
    background-color: transparent;
    color: @PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片 �?玻璃态近�?*/
QWidget#downloadTaskCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    min-width: 240px;
}

QWidget#downloadTaskCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* 下载任务卡片实例�?*/
QWidget#downloadTaskCard QLabel#instanceNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片状态文�?*/
QWidget#downloadTaskCard QLabel#statusTextLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片进度文本 */
QWidget#downloadTaskCard QLabel#progressLabel {
    background-color: transparent;
    color: @INFO@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片速度文本 */
QWidget#downloadTaskCard QLabel#speedLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片加载器文�?*/
QWidget#downloadTaskCard QLabel#loadersLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片步骤文本 */
QWidget#downloadTaskCard QLabel#stepLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片大小文本 */
QWidget#downloadTaskCard QLabel#sizeLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 聚合任务卡片 �?玻璃态近�?*/
QWidget#aggregateTaskCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    min-width: 180px;
}

QWidget#aggregateTaskCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* 聚合任务卡片图标 */
QLabel#aggregateTaskIconLabel {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 16px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}

/* 聚合任务卡片名称 */
QLabel#aggregateTaskNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 聚合任务卡片计数 */
QLabel#aggregateTaskCountLabel {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 任务栏查看全部按�?*/
QPushButton#viewAllTaskBtn {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#viewAllTaskBtn:hover {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border-color: @PRIMARY_RGBA_38@;
}

/* 下载任务卡片取消按钮 */
QPushButton#cancelDownloadBtn {
    background-color: transparent;
    border: none;
    border-radius: 999px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
    min-width: 24px;
    min-height: 24px;
}

QPushButton#cancelDownloadBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

/* ============================================================
 * Section 15. 滚动条样式（QScrollBar:vertical、QScrollBar:horizontal�?
 * ============================================================ */
/* 垂直滚动条：窄轨�?+ 圆角半透明滑块 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.18@;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.32@;
}

QScrollBar::handle:vertical:pressed {
    background: @PRIMARY@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条：与垂直对�?*/
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background: @BLACK_RGBA_0.18@;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: @BLACK_RGBA_0.32@;
}

QScrollBar::handle:horizontal:pressed {
    background: @PRIMARY@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::corner {
    background: transparent;
    border: none;
}

QScrollBar:disabled {
    background: transparent;
}

QScrollBar:disabled::handle:vertical,
QScrollBar:disabled::handle:horizontal {
    background: @BG_MUTED@;
}

/* ============================================================
 * Section 16. 菜单与提示样式（QMenu、QToolTip、QStatusBar�?
 * ============================================================ */
/* QMenu：圆角卡片容�?+ 圆角菜单�?+ 主色高亮 */
QMenu {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 9px 26px;
    border-radius: 8px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background: @BG_HOVER@;
    color: @PRIMARY@;
}

QMenu::separator {
    height: 1px;
    background: @BORDER_LIGHT@;
    margin: 4px 10px;
}

QMenu::icon {
    width: 16px;
    margin-left: 4px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* QToolTip：圆角浮�?+ 主文字色 + 细边�?*/
QToolTip {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* QStatusBar：底部状态栏 + 顶部细分割线 */
QStatusBar {
    background: @BG_CARD@;
    border-top: 1px solid @BORDER_LIGHT@;
    padding: 4px 12px;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background: transparent;
    color: @TEXT_TERTIARY@;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: @BORDER_LIGHT@;
    margin: 4px 8px;
}

/* ============================================================
 * Section 17. 页面专属样式（HomePage 轮播、AiChatPage、SkinEditorPage 等）
 * ============================================================ */
/* --- 17.1 HomePage 轮播（参考原�?.carousel�?--- */
QWidget#carouselWidget {
    background: @BG_PRESSED@;
    border: 1px solid @BORDER@;
    border-radius: 22px;
    overflow: hidden;
}

QLabel#carouselPlaceholder {
    font-size: 16px;
    color: @TEXT_TERTIARY@;
    background: @BG_BASE@;
    border-radius: 16px;
    border: 2px dashed @BORDER_STRONG@;
}

/* 首页轮播右侧皮肤面板：无账户时的「添加首个账户」空态按钮 */
QPushButton#homeSkinAddBtn {
    background-color: transparent;
    border: none;
    border-radius: 16px;
}
QPushButton#homeSkinAddBtn:hover {
    background-color: @BG_HOVER@;
}

QLabel#carouselTag {
    background: @WHITE_RGBA_30@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 9px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#carouselTitle {
    font-size: 32px;
    font-weight: 800;
    color: @TEXT_ON_PRIMARY@;
}

QLabel#carouselDesc {
    font-size: 14px;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#carouselCtaBtn {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: none;
    border-radius: 999px;
    padding: 0 20px;
    min-height: 38px;
    max-height: 38px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#carouselCtaBtn:hover {
    background: @BG_HOVER@;
}

QPushButton#carouselDot {
    background: @BLACK_RGBA_64@;
    border: none;
    border-radius: 2px;
    min-width: 4px;
    max-width: 4px;
    min-height: 4px;
    max-height: 4px;
    margin: 0;
}

QPushButton#carouselDot[active="true"] {
    background: @PRIMARY@;
    min-width: 4px;
    max-width: 4px;
    min-height: 4px;
    max-height: 4px;
    border-radius: 2px;
}

QPushButton#carouselDot:hover {
    background: @BLACK_RGBA_115@;
}

QPushButton#carouselArrowBtn {
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    border-radius: 999px;
    background: @BLACK_RGBA_64@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

QPushButton#carouselArrowBtn:hover {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
}

QLabel#quickLinkIcon {
    background: transparent;
    border: none;
}

QLabel#quickLinkLabel {
    font-size: 13px;
    font-weight: 500;
    color: @TEXT_SECONDARY@;
}

QWidget#quickLinkCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#quickLinkCard:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* --- 17.2 AiChatPage AI 对话页（玻璃态近似：半透明背景 + 细边框） --- */
QWidget#aiChatTopBar {
    background: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QLabel#aiChatStatusDot {
    background: #94A3B8;
    border-radius: 4px;
}

QLabel#aiChatConvTitle {
    font-size: 15px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    letter-spacing: 0.1px;
}

/* 左侧对话�?�?�?SubNavPanel 一致的子导航样�?*/
QFrame#aiChatLeftPanel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QFrame#aiChatLeftPanel > QWidget {
    background: transparent;
}

/* 面板头部（模式切�?+ 收起按钮）�?�?SubNavPanel 头部一�?*/
QWidget#subNavHeader {
    background: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* 模式切换 �?轨道 + 滑动滑块（与 HTML 一致） */
QWidget#aiChatModeBar {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 11px;
    padding: 0;
}

QPushButton#aiChatModeBtn {
    background: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    margin: 1px 2px;
}

QPushButton#aiChatModeBtn:hover {
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatModeBtn:checked {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-weight: 600;
}

QPushButton#aiChatModeBtn:checked:hover {
    color: @TEXT_PRIMARY@;
}

QWidget#aiChatModeIndicator {
    background-color: @BG_CARD@;
    border: none;
    border-radius: 8px;
}

QPushButton#aiChatNewConvBtn {
    background: transparent;
    border: 1px dashed @PRIMARY_RGBA_64@;
    border-radius: 10px;
    color: @PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    min-height: 40px;
}

QPushButton#aiChatNewConvBtn:hover {
    background: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
}

QPushButton#aiChatNewConvBtn:pressed {
    background: @PRIMARY_RGBA_38@;
}

QPushButton#aiChatToggleConvBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 0;
}

QPushButton#aiChatToggleConvBtn:hover {
    background: @BLACK_RGBA_0.06@;
}

QPushButton#aiChatToggleConvBtn:checked {
    background: @PRIMARY_RGBA_31@;
}

QScrollArea#aiChatConvScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#aiChatConvScrollArea > QWidget {
    background: transparent;
}

QScrollArea#aiChatConvScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#aiChatConvScrollArea QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#aiChatConvScrollArea QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#aiChatConvScrollArea QScrollBar::add-line:vertical,
QScrollArea#aiChatConvScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#aiChatConvScrollArea QScrollBar::add-page:vertical,
QScrollArea#aiChatConvScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollArea#aiChatMessageArea {
    background: @BG_MSG@;
    border: none;
}

QScrollArea#aiChatMessageArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#aiChatMessageArea QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#aiChatMessageArea QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#aiChatMessageArea QScrollBar::add-line:vertical,
QScrollArea#aiChatMessageArea QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#aiChatMessageArea QScrollBar::add-page:vertical,
QScrollArea#aiChatMessageArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#aiChatWelcomeWidget {
    background: transparent;
}

QLabel#aiChatWelcomeTitleLabel {
    font-size: 26px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    letter-spacing: 0.5px;
}

QLabel#aiChatWelcomeDescLabel {
    font-size: 14px;
    color: @TEXT_TERTIARY@;
    letter-spacing: 0.3px;
    padding: 0 24px;
}

QWidget#aiChatWelcomeQuickBtns {
    background: transparent;
}

QPushButton#aiChatQuickBtn {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 500;
    min-width: 120px;
    max-width: 220px;
}

QPushButton#aiChatQuickBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY@;
    color: @PRIMARY@;
}

QPushButton#aiChatQuickBtn:pressed {
    background: @BG_PRESSED@;
}

QWidget#aiChatBubbleContainer {
    background: transparent;
}

QWidget#bubbleActionsWidget {
    background: transparent;
}

QFrame#aiChatUserBubble {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#aiChatUserBubble QLabel#msgContent {
    color: @TEXT_SECONDARY@;
    background: transparent;
    font-size: 14px;
}

QFrame#aiChatAiBubble {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#aiChatAiBubble QLabel#msgContent {
    color: @TEXT_PRIMARY@;
    background: transparent;
    font-size: 14px;
}

QFrame#aiChatAiBubble QLabel#msgContent a {
    color: @LINK@;
    text-decoration: none;
}

QFrame#aiChatAiBubble QLabel#msgContent code {
    background: @BG_MUTED@;
    color: @CODE_TEXT@;
    font-family: Consolas, "Courier New", monospace;
    padding: 1px 4px;
    border-radius: 4px;
}

QFrame#aiChatAiBubble QLabel#msgContent pre {
    background: @CODE_BG@;
    border: 1px solid @CODE_BORDER@;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 4px 0;
}

QLabel#aiChatStatsLabel {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
}

QPushButton#bubbleActionBtn {
    background: transparent;
    border: none;
    padding: 0;
}

QPushButton#bubbleActionBtn:hover {
    background: @BLACK_RGBA_0.06@;
    border-radius: 14px;
}

QPushButton#bubbleActionBtn[active="true"] {
    background: @LINK_RGBA_0.10@;
    border-radius: 14px;
}

/* AI 回答过程行（思考/搜索/工具调用）：一轮一行纯文字样式 */
QPushButton#thinkingHeaderRow {
    background: transparent;
    border: none;
    padding: 2px 0px;
    text-align: left;
}

QLabel#thinkingTitle {
    font-size: 12px;
    color: @WARNING_HOVER@;
    font-weight: 600;
    background: transparent;
}

QLabel#thinkingStatusText {
    font-size: 12px;
    background: transparent;
}

QLabel#thinkingStatusText[type="info"] {
    color: @WARNING@;
}

QLabel#thinkingStatusText[type="success"] {
    color: @SUCCESS@;
}

QLabel#thinkingPreview {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background: transparent;
}

QLabel#thinkingContent {
    font-size: 13px;
    color: @WARNING_TEXT_DARK@;
    background: transparent;
}

QWidget#aiChatInputPanel {
    background: @BG_CARD@;
    border-top: 1px solid @BORDER@;
}

QFrame#aiChatInputBox {
    background: @BG_MUTED@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
}

QFrame#aiChatInputBox:hover {
    border: 1.5px solid @BORDER_STRONG@;
}

QFrame#aiChatInputBox[focused="true"] {
    border: 1.5px solid @PRIMARY@;
}

QTextEdit#aiChatInputEdit {
    background: transparent;
    border: none;
    padding: 6px 8px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QTextEdit#aiChatInputEdit:focus {
    border: none;
    background: transparent;
}

QPushButton#aiChatToolIconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    font-size: 14px;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatToolIconBtn:hover {
    background: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatToolIconBtn[active="true"] {
    background: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
}

QPushButton#aiChatWorkspaceBtn {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#aiChatWorkspaceBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatWorkspaceBtn[active="true"] {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_STRONG@;
}

QPushButton#aiChatSendBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 0;
}

QPushButton#aiChatSendBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#aiChatSendBtn:pressed {
    background: @PRIMARY_PRESSED@;
}

QPushButton#aiChatSendBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_TERTIARY@;
}

QPushButton#aiChatModelBtn {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}

QPushButton#aiChatModelBtn:hover {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_HOVER@;
}

QWidget#aiChatRefChipsWidget {
    background: transparent;
}

QWidget#aiChatBubbleRefChips {
    background: transparent;
    margin-top: 6px;
}

QFrame#aiChatRefChip {
    background: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_LIGHT@;
    border-radius: 999px;
}

QLabel#aiChatRefChipLabel {
    background: transparent;
    color: @TEXT_ACCENT@;
    font-size: 12px;
}

QPushButton#aiChatRefChipClose {
    background: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    font-size: 13px;
}

QPushButton#aiChatRefChipClose:hover {
    color: @DANGER_TEXT@;
}

QPushButton#refAddFileBtn {
    background: transparent;
    color: @PRIMARY@;
    border: 1.5px solid @PRIMARY_LIGHT@;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton#refAddFileBtn:hover {
    background: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
}

QTreeWidget#refTree {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QTreeWidget#refTree::item {
    padding: 4px 2px;
}

QTreeWidget#refTree::item:selected {
    background: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QTabWidget#refTabs::pane {
    border: 1px solid @BORDER@;
    border-radius: 12px;
    background-color: @BG_CARD@;
}

/* 引用资源弹窗 �?居中卡片（与其它内置弹窗一致） */
QWidget#referenceDialogCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 20px;
}

QWidget#refDialogTitleBar {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
    min-height: 40px;
    max-height: 40px;
}

QLabel#refDialogTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

/* 引用确定/取消按钮 */
QPushButton#refOkBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 9px;
    padding: 7px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#refOkBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#refCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#refCancelBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QTabBar#refTabs_tabbar::tab {
    background: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar#refTabs_tabbar::tab:selected {
    background: @BG_CARD@;
    color: @TEXT_ACCENT@;
    border-bottom: 2px solid @PRIMARY@;
    font-weight: 600;
}

QTabBar#refTabs_tabbar::tab:hover:!selected {
    background: @PRIMARY_BG@;
}

QLineEdit#refNetSearchEdit, QLineEdit#refWebUrlEdit, QLineEdit#refWebTitleEdit {
    background: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 13px;
}

QLineEdit#refNetSearchEdit:focus, QLineEdit#refWebUrlEdit:focus, QLineEdit#refWebTitleEdit:focus {
    border: 1.5px solid @PRIMARY@;
}

QPushButton#refNetSearchBtn, QPushButton#refWebAddBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 9px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#refNetSearchBtn:hover, QPushButton#refWebAddBtn:hover {
    background: @PRIMARY_DARK@;
}

QPushButton#refNetSearchBtn:disabled, QPushButton#refWebAddBtn:disabled {
    background: @PRIMARY_LIGHT@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#refWebFetchBtn {
    background: @BG_CARD@;
    color: @PRIMARY@;
    border: 1.5px solid @PRIMARY_LIGHT@;
    border-radius: 9px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#refWebFetchBtn:hover {
    background: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
}

/* ============================================================
 * Section 18. 共享卡片列表项样式（modCard* 系列，影�?12+ 页面�?
 * ============================================================ */
/* Mod 卡片列表�?�?玻璃态近�?+ hover 上浮 */
QWidget#modCardListItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#modCardListItem:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 安装新实例页 / 实例选择页：列表项卡片无鼠标悬浮效果 */
QWidget#modCardListItem[flatCard="true"],
QWidget#modCardListItem[flatCard="true"]:hover {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

/* Mod 卡片图标 — 主色渐变（圆角与 cardRole="icon" 统一为 12px） */
QLabel#modCardIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 700;
    font-size: 16px;
}

/* Mod 卡片名称（无边框，与下方描述/芯片左对齐） */
QLabel#modCardName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* Mod 卡片英文�?*/
QLabel#modCardEnglishName {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* Mod 信息芯片（无边框胶囊，仅用淡主色底） */
QLabel#modChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* Mod 更新芯片（无边框胶囊） */
QLabel#modUpdateChip {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 瀑布流内容芯片（无边框胶囊） */
QLabel#contentChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 实例分类芯片（列表卡片 / 瀑布流卡片，无边框胶囊） */
QLabel#modChip[categoryChip="true"],
QLabel#contentChip[categoryChip="true"] {
    background-color: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 瀑布流卡片名称（无边框，主题令牌取色，深浅色主题通用） */
QLabel#contentCardName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 瀑布流卡片描述 / meta 行 */
QLabel#contentCardDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    padding: 0;
}

/* ── 视图切换分段控件（列表 / 瀑布流） ── */
QWidget#contentViewSwitch {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
}

QPushButton#contentViewSwitchBtn {
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QPushButton#contentViewSwitchBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#contentViewSwitchBtn[active="true"] {
    background-color: @BG_HOVER@;
}

/* Mod 卡片操作按钮 */
QPushButton#modCardActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#modCardActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#modCardActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* ============================================================
 * Section 19. 共享列表页组件样式（modBottomBar、filterLabel、modSearchEdit 等）
 * ============================================================ */
/* 底部操作栏 —— 微透明玻璃态卡片（实例管理本地资源各页共用） */
QWidget#modBottomBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 基岩资源页底部操作栏 —— 同款玻璃态卡片 */
QWidget#bedrockResBottomBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 底部操作栏操作按�?*/
QPushButton#bottomActionBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#bottomActionBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#bottomActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#bottomActionBtn:checked {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY@;
    color: @PRIMARY@;
}

/* 分类管理按钮（实例模组筛选栏�?*/
QPushButton#categoryManageBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#categoryManageBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#categoryManageBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 筛选栏标签 */
QLabel#filterLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 筛选栏下拉�?�?全应用统一筛选框样式
 * 覆盖：内容列�?/ 模组下载 / 详情页版本筛�?/ 搜索页排�?/ 实例模组筛�?
 *       （filterCombo / sortCombo / sourceCombo / instanceCombo /
 *         modDetailCombo / searchSortCombo / categoryCombo�?*/
QComboBox#filterCombo,
QComboBox#sortCombo,
QComboBox#sourceCombo,
QComboBox#instanceCombo,
QComboBox#modDetailCombo,
QComboBox#searchSortCombo,
QComboBox#categoryCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    min-height: 22px;
}

QComboBox#filterCombo:hover,
QComboBox#sortCombo:hover,
QComboBox#sourceCombo:hover,
QComboBox#instanceCombo:hover,
QComboBox#modDetailCombo:hover,
QComboBox#searchSortCombo,
QComboBox#categoryCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

QComboBox#filterCombo:focus,
QComboBox#sortCombo:focus,
QComboBox#sourceCombo:focus,
QComboBox#instanceCombo:focus,
QComboBox#modDetailCombo:focus,
QComboBox#searchSortCombo,
QComboBox#categoryCombo:focus {
    border: 1.5px solid @PRIMARY@;
}

QComboBox#filterCombo::drop-down,
QComboBox#sortCombo::drop-down,
QComboBox#sourceCombo::drop-down,
QComboBox#instanceCombo::drop-down,
QComboBox#modDetailCombo::drop-down,
QComboBox#searchSortCombo,
QComboBox#categoryCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#filterCombo::down-arrow,
QComboBox#sortCombo::down-arrow,
QComboBox#sourceCombo::down-arrow,
QComboBox#instanceCombo::down-arrow,
QComboBox#modDetailCombo::down-arrow,
QComboBox#searchSortCombo,
QComboBox#categoryCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    margin-right: 8px;
}

QComboBox#filterCombo QAbstractItemView,
QComboBox#sortCombo QAbstractItemView,
QComboBox#sourceCombo QAbstractItemView,
QComboBox#instanceCombo QAbstractItemView,
QComboBox#modDetailCombo QAbstractItemView,
QComboBox#searchSortCombo,
QComboBox#categoryCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
}

QComboBox#filterCombo QAbstractItemView::item,
QComboBox#sortCombo QAbstractItemView::item,
QComboBox#sourceCombo QAbstractItemView::item,
QComboBox#instanceCombo QAbstractItemView::item,
QComboBox#modDetailCombo QAbstractItemView::item,
QComboBox#searchSortCombo,
QComboBox#categoryCombo QAbstractItemView::item {
    padding: 6px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    border-radius: 4px;
}

QComboBox#filterCombo QAbstractItemView::item:hover,
QComboBox#sortCombo QAbstractItemView::item:hover,
QComboBox#sourceCombo QAbstractItemView::item:hover,
QComboBox#instanceCombo QAbstractItemView::item:hover,
QComboBox#modDetailCombo QAbstractItemView::item:hover,
QComboBox#searchSortCombo,
QComboBox#categoryCombo QAbstractItemView::item:hover {
    background-color: @BG_MUTED@;
}

QComboBox#filterCombo QAbstractItemView::item:selected,
QComboBox#sortCombo QAbstractItemView::item:selected,
QComboBox#sourceCombo QAbstractItemView::item:selected,
QComboBox#instanceCombo QAbstractItemView::item:selected,
QComboBox#modDetailCombo QAbstractItemView::item:selected,
QComboBox#searchSortCombo,
QComboBox#categoryCombo QAbstractItemView::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* 搜索输入�?*/
QLineEdit#modSearchEdit {
    background-color: @BG_CARD@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 8px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modSearchEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLineEdit#modSearchEdit:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 搜索按钮 */
QPushButton#modSearchBtn,
QPushButton#downloadSearchBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 7px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modSearchBtn:hover,
QPushButton#downloadSearchBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modSearchBtn:pressed,
QPushButton#downloadSearchBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 空状态占位提�?*/
QLabel#modPlaceholderLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
    padding: 48px 24px;
}

/* 拖入模式按钮 */
QPushButton#dragModeBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: @TEXT_PRIMARY@;
}

QPushButton#dragModeBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY@;
    color: @PRIMARY@;
}

QPushButton#dragModeBtn:pressed {
    background-color: @PRIMARY_RGBA_20@;
}

/* 拖入区域 */
QWidget#dropZone {
    background-color: transparent;
    border: 2px dashed @BORDER_STRONG@;
    border-radius: 12px;
    min-height: 200px;
}

QWidget#dropZone:hover {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_RGBA_8@;
}

/* 拖入区域图标 */
QLabel#dropZoneIcon {
    background-color: transparent;
    border: none;
}

/* 拖入区域提示文字 */
QLabel#dropZoneHint {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 600;
    border: none;
}

/* 拖入区域补充提示 */
QLabel#dropZoneSubHint {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 拖入状态标签 */
QLabel#dropStatusLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 500;
    border: none;
    padding: 12px;
}

/* 分页�?*/
QWidget#modPaginationBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 分页页码按钮 */
QPushButton#modPageBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    min-width: 32px;
}

QPushButton#modPageBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#modPageBtn:checked {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#modPageBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 分页当前页标�?*/
QLabel#modPageLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    padding: 0 8px;
}

/* ============================================================
 * Section 20. 统一对话框组件样式（appDialog*、appMsgBox* 系列�?
 * ============================================================ */
/* 对话框卡片容�?*/
QWidget#appDialogCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 对话框标�?*/
QLabel#appDialogTitleLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 18px;
    font-weight: 700;
    border: none;
    padding: 4px 0;
}

/* 对话框提示文�?*/
QLabel#appDialogPromptLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 对话框输入框 */
QLineEdit#appDialogLineEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#appDialogLineEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLineEdit#appDialogLineEdit:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 对话框下拉框 */
QComboBox#appDialogComboBox {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QComboBox#appDialogComboBox:focus {
    border: 2px solid @PRIMARY@;
}

/* 对话框数字框 */
QSpinBox#appDialogSpin {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QSpinBox#appDialogSpin:focus {
    border: 2px solid @PRIMARY@;
}

/* 对话框次按钮 */
QPushButton#appDialogBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 8px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#appDialogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#appDialogBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 对话框主按钮 */
QPushButton#appDialogBtnPrimary {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 8px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#appDialogBtnPrimary:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#appDialogBtnPrimary:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#appDialogBtnPrimary:disabled {
    background-color: @PRIMARY_LIGHT@;
    color: @TEXT_ON_PRIMARY@;
}

/* 对话框图标按�?*/
QPushButton#appDialogIconBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#appDialogIconBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

/* 对话框文件列�?*/
QListWidget#appFileList {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget#appFileList::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: @TEXT_PRIMARY@;
}

QListWidget#appFileList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#appFileList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* 对话框颜色预�?*/
QLabel#appColorPreview {
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    min-width: 60px;
    min-height: 30px;
}

/* 对话框颜色滑�?*/
QSlider#appColorSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider#appColorSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
}

QSlider#appColorSlider::handle:horizontal {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    margin: -8px 0;
}

/* 消息框卡�?*/
QWidget#appMsgBoxCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 消息框图�?*/
QLabel#appMsgBoxIconLabel {
    background-color: transparent;
    border: none;
    border-radius: 20px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
}

/* 消息框标�?*/
QLabel#appMsgBoxTitleLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    border: none;
}

/* 消息框详�?*/
QLabel#appMsgBoxTextLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
}

/* 消息框信息图�?�?主色 */
QLabel#appMsgBoxIconLabel[type="info"] {
    background-color: @INFO@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框警告图�?�?警告�?*/
QLabel#appMsgBoxIconLabel[type="warning"] {
    background-color: @WARNING@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框错误图�?�?危险�?*/
QLabel#appMsgBoxIconLabel[type="error"] {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框成功图�?�?主色 */
QLabel#appMsgBoxIconLabel[type="success"] {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框问题图�?�?链接�?*/
QLabel#appMsgBoxIconLabel[type="question"] {
    background-color: @LINK@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框补充信息文�?�?13px 三级�?*/
QLabel#appMsgBoxInformativeLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
    margin-top: 8px;
}

/* 消息框按钮行 �?横向布局 */
QWidget#appMsgBoxButtonRow {
    background-color: transparent;
    spacing: 8px;
}

/* 消息框按�?�?镜像 appDialogBtn */
QPushButton#appMsgBoxBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#appMsgBoxBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 21. ModDetailPage / ContentDetailPage 样式（modDetail* 系列�?
 * ============================================================ */
/* 详情页滚动区 */
QScrollArea#modDetailScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#modDetailScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 详情页内容容�?*/
QWidget#modDetailContent {
    background-color: transparent;
}

/* 详情页头�?*/
QWidget#modDetailHeader {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
    padding-bottom: 20px;
    margin-bottom: 24px;
}

/* 详情页大图标 �?72px（原�?hero 风格�?*/
QLabel#modDetailIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 16px;
    min-width: 72px;
    min-height: 72px;
    max-width: 72px;
    max-height: 72px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 28px;
}

/* 来源徽章（CurseForge / Modrinth / MC百科�?*/
QLabel#modDetailSourcePill {
    background-color: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_20@;
    border-radius: 7px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
}

/* Hero 下载按钮 */
QPushButton#modDetailHeroDownloadBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
    padding: 8px 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#modDetailHeroDownloadBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modDetailHeroDownloadBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 统计 chip */
QWidget#modDetailStatChip {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 999px;
}

QLabel#modDetailStatChipText {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

/* ---------- 详情�?Tab �?---------- */
QWidget#modDetailTabBar {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QPushButton#modDetailTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modDetailTab:hover {
    color: @TEXT_PRIMARY@;
}

QPushButton#modDetailTab:checked {
    color: @PRIMARY@;
    border-bottom: 2px solid @PRIMARY@;
}

QStackedWidget#modDetailTabStack {
    background-color: transparent;
    border: none;
}

QWidget#modDetailTabStack > QWidget {
    background-color: transparent;
}

/* 详情页中文名 */
QLabel#modDetailChineseName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 26px;
    font-weight: 800;
    border: none;
}

/* 详情页英文名 */
QLabel#modDetailEnglishName {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 详情页描�?*/
QLabel#modDetailDesc {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
}

/* 详情页左右分�?*/
QWidget#modDetailLeftPanel,
QWidget#modDetailRightPanel {
    background-color: transparent;
    border: none;
}

QWidget#modDetailBody {
    background-color: transparent;
    border: none;
}

/* 详情页信息块 */
QWidget#modDetailSection {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 16px;
}

/* 详情页信息块标题 */
QLabel#modDetailSectionTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 700;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
}

/* 详情页依赖项卡片 */
QWidget#modDetailDepCard {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 10px 12px;
}

QWidget#modDetailDepCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* 详情页依赖项名称 */
QLabel#modDetailDepName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 详情页依赖项标签 */
QLabel#modDetailDepTag {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
}

/* 详情页下载版本卡�?*/
QWidget#modDetailDownloadCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 10px 12px;
}

QWidget#modDetailDownloadCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 详情页下载版本号 */
QLabel#modDetailDownloadVer {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 详情页版本徽�?�?release（主色） */
QLabel#modDetailVersionBadge-release {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页版本徽�?�?beta（警告色�?*/
QLabel#modDetailVersionBadge-beta {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页版本徽�?�?alpha（危险色�?*/
QLabel#modDetailVersionBadge-alpha {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页下载按�?*/
QPushButton#modDetailDownloadBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modDetailDownloadBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modDetailDownloadBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#modDetailDownloadBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 详情页链接按�?*/
QPushButton#modDetailLinkBtn {
    background-color: transparent;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @LINK@;
    font-size: 12px;
}

QPushButton#modDetailLinkBtn:hover {
    background-color: @LINK_RGBA_0.10@;
    border: 1px solid @LINK@;
}

/* 详情页标签键 */
QLabel#modDetailTagKey {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 详情页标签�?*/
QLabel#modDetailTagValue {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 500;
    border: none;
}

/* 详情页信息芯�?*/
QLabel#modDetailChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 详情页描述浏览器 */
QTextBrowser#modDetailDescBrowser {
    background-color: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

/* 详情页截图容�?*/
QWidget#modDetailScreenshotContainer {
    background-color: transparent;
    border: none;
}

/* 详情页截图堆�?*/
QStackedWidget#modDetailScreenshotStack {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 详情页截�?*/
QLabel#modDetailScreenshot {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 12px;
}

/* 详情页截图遮�?*/
QLabel#modDetailScreenshotOverlay {
    background-color: transparent;
    border: none;
    border-radius: 12px;
}

/* 详情页截图前一张按�?*/
QPushButton#modDetailScreenshotPrev,
QPushButton#modDetailScreenshotNext {
    background-color: @BLACK_RGBA_31@;
    border: none;
    border-radius: 999px;
    padding: 8px;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#modDetailScreenshotPrev:hover,
QPushButton#modDetailScreenshotNext:hover {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
}

/* 详情页缩略图�?*/
QWidget#modDetailThumbStrip {
    background-color: transparent;
    border: none;
}

/* 详情页缩略图 */
QLabel#modDetailScreenshotThumb {
    background-color: @BG_MUTED@;
    border: 2px solid transparent;
    border-radius: 6px;
}

QLabel#modDetailScreenshotThumb[current="true"] {
    border: 2px solid @PRIMARY@;
}

/* 详情页收藏按�?*/
QPushButton#contentFavoriteBtn {
    background-color: transparent;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 999px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#contentFavoriteBtn:hover {
    background-color: @BG_HOVER@;
    color: @WARNING@;
    border: 1px solid @WARNING@;
}

QPushButton#contentFavoriteBtn:checked {
    background-color: @WARNING_BG@;
    color: @WARNING@;
    border: 1px solid @WARNING@;
}

QListWidget#refNetResultList, QListWidget#refWebList {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QListWidget#refNetResultList::item, QListWidget#refWebList::item {
    padding: 6px 4px;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QListWidget#refNetResultList::item:hover, QListWidget#refWebList::item:hover {
    background: @BG_MUTED@;
}

QListWidget#refLocalInstList {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QListWidget#refLocalInstList::item {
    padding: 9px 10px;
    border-bottom: 1px solid @BORDER_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QListWidget#refLocalInstList::item:hover {
    background: @BG_MUTED@;
}

QListWidget#refLocalInstList::item:selected {
    background: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QSplitter#refLocalSplitter::handle {
    background: transparent;
    width: 6px;
}

QComboBox#aiChatThinkingEffortCombo,
QComboBox#aiChatPermissionCombo {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 4px 8px 4px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
}

QComboBox#aiChatThinkingEffortCombo:hover,
QComboBox#aiChatPermissionCombo:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QComboBox#aiChatThinkingEffortCombo::drop-down,
QComboBox#aiChatPermissionCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#aiChatThinkingEffortCombo::down-arrow,
QComboBox#aiChatPermissionCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    width: 0;
    height: 0;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView,
QComboBox#aiChatPermissionCombo QAbstractItemView {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView::item,
QComboBox#aiChatPermissionCombo QAbstractItemView::item {
    padding: 6px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    border-radius: 4px;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView::item:hover,
QComboBox#aiChatPermissionCombo QAbstractItemView::item:hover {
    background: @BG_MUTED@;
}

QFrame#aiChatTypingIndicator {
    background: transparent;
    border: none;
    border-radius: 0;
}

QLabel#typingDot1 {
    color: @PRIMARY@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

QLabel#typingDot2 {
    color: @PRIMARY_MEDIUM@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

QLabel#typingDot3 {
    color: @PRIMARY_LIGHT@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

/* --- 17.3 SkinEditorPage 皮肤编辑�?--- */
#SkinEditorToolBar QPushButton {
    border: none;
    border-radius: 12px;
    padding: 4px;
    background: transparent;
    icon-size: 20px;
}

#SkinEditorToolBar QPushButton:hover {
    background: @BLACK_RGBA_0.06@;
}

#SkinEditorToolBar QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @PRIMARY@;
}

#SkinEditorPalette QPushButton {
    border: 1px solid @BORDER_STRONG@;
    border-radius: 4px;
    padding: 0;
    margin: 1px;
}

#SkinEditorPalette QPushButton:hover {
    border: 1px solid @TEXT_DISABLED@;
    margin: 0;
}

#SkinEditorPreviewContainer {
    background: @EDITOR_BG_ALT@;
    border-radius: 12px;
    border: 1px solid @BORDER_STRONG@;
}

#SkinEditorStatusBar {
    background: @EDITOR_BG@;
    border-top: 1px solid @BORDER_LIGHT@;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    padding: 4px 12px;
    font-family: Consolas, "Courier New", monospace;
}

#SkinEditorPanelTitle {
    color: @TEXT_TERTIARY@;
    font-weight: 600;
    font-size: 12px;
    padding: 4px 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* --- 17.4 InstanceAssistantWindow 快捷指令�?--- */
QLabel#contextLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 10px;
}

QPushButton#serverToggleBtn, QPushButton#redetectBtn {
    background: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#serverToggleBtn:hover, QPushButton#redetectBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#serverToggleBtn:pressed, QPushButton#redetectBtn:pressed {
    background: @BG_PRESSED@;
}

QPushButton#serverToggleBtn:checked {
    background: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#serverToggleBtn:checked:hover {
    background: @PRIMARY_DARK@;
    border: 1px solid @PRIMARY_DARK@;
}

/* --- 17.5 ModelDialog 模型选择对话�?--- */
QWidget#modelSelectCard {
    background: @BG_CARD@;
    border-radius: 20px;
    border: 1px solid @BORDER@;
}

QLabel#modelDialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    letter-spacing: 0.3px;
    background: transparent;
}

QPushButton#modelDialogCloseBtn {
    background: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    border-radius: 16px;
    font-size: 16px;
}

QPushButton#modelDialogCloseBtn:hover {
    background: @DANGER_BG@;
    color: @DANGER@;
}

QWidget#modelSearchContainer {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#modelSearchContainer:hover {
    background: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QWidget#modelSearchContainer > QLineEdit#modelSearchEdit {
    background: transparent;
    border: none;
    padding: 10px 16px 10px 4px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QWidget#modelSearchContainer > QLineEdit#modelSearchEdit:focus {
    border: none;
    background: transparent;
}

QLabel#modelSearchIcon {
    background: transparent;
    color: @TEXT_DISABLED@;
    font-size: 15px;
    border: none;
    padding: 0;
}

QScrollArea#modelDialogScroll {
    background: transparent;
    border: none;
}

QScrollArea#modelDialogScroll > QWidget {
    background: transparent;
}

QScrollArea#modelDialogScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#modelDialogScroll QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#modelDialogScroll QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#modelDialogScroll QScrollBar::add-line:vertical,
QScrollArea#modelDialogScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#modelDialogScroll QScrollBar::add-page:vertical,
QScrollArea#modelDialogScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#modelCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#modelCard:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#modelCardName {
    font-size: 14px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
}

QLabel#modelCardProvider {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
}

QLabel#modelCardDesc {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#modelCardAddBtn {
    background: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modelCardAddBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#modelCardAddBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_TERTIARY@;
}

QLabel#modelDialogHintLabel {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    padding: 8px 4px;
}

/* --- 17.6 AccountManagePage 账户管理�?--- */
QWidget#accountManageWidget > QWidget {
    background: transparent;
}

QLabel#accountNameTitle {
    font-size: 22px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    padding: 4px 0;
}

QListWidget#accountListWidget {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    min-width: 220px;
}

QListWidget#accountListWidget::item {
    padding: 14px 18px;
    border-radius: 12px;
    margin: 3px 4px;
    border: 1px solid transparent;
}

QListWidget#accountListWidget::item:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QListWidget#accountListWidget::item:selected {
    background: @PRIMARY_RGBA_20@;
    color: @TEXT_ACCENT@;
    border: 1px solid @PRIMARY@;
}

QListWidget#accountListWidget::item:selected:hover {
    background: @PRIMARY_RGBA_26@;
}

QLabel#skinDisplay {
    border: 2px solid @BORDER@;
    border-radius: 16px;
    background: @BG_CONTENT@;
}

QLabel#skinDisplay:hover {
    border: 2px solid @PRIMARY@;
}

/* --- 17.7 DetailsTextEdit 详情文本框滚动条 --- */
QTextEdit#detailsTextEdit QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QTextEdit#detailsTextEdit QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QTextEdit#detailsTextEdit QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QTextEdit#detailsTextEdit QScrollBar::add-line:vertical,
QTextEdit#detailsTextEdit QScrollBar::sub-line:vertical {
    height: 0;
}

QTextEdit#detailsTextEdit QScrollBar::add-page:vertical,
QTextEdit#detailsTextEdit QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ============================================================
 * Section 22. InstanceOverviewPage 样式（overview* 系列�?
 * ============================================================ */
/* 概览滚动�?*/
QScrollArea#overviewScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#overviewScrollContent {
    background-color: transparent;
}

/* 概览头部卡片 �?玻璃�?*/
QWidget#overviewHeaderCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 20px;
}

/* 概览大图�?�?64px 主色渐变 */
QLabel#overviewIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 24px;
}

/* 概览实例�?*/
QLabel#overviewInstanceName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 28px;
    font-weight: 800;
    border: none;
}

/* 概览标签芯片 */
QLabel#overviewTag {
    background-color: @PRIMARY_RGBA_20@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 500;
}

/* 概览副文�?*/
QLabel#overviewSubText {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 概览启动按钮 �?主色渐变胶囊 */
/* Overview launch button.
 * Qt does not clamp border-radius values larger than half the widget height;
 * it simply skips rounding. The button is fixed at 44px high, so the radius
 * must be 22px to render as a pill. */
QPushButton#overviewLaunchBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 22px;
    padding: 10px 32px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#overviewLaunchBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QPushButton#overviewLaunchBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 概览统计卡片 �?玻璃�?+ hover 上浮 */
QWidget#overviewStatCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 16px;
}

QWidget#overviewStatCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 概览统计图标 �?32px 主色半透明 */
QLabel#overviewStatIcon {
    background-color: @PRIMARY_BG@;
    border: none;
    border-radius: 8px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    color: @PRIMARY@;
}

/* 概览统计数字 �?24px 800字重主色 Consolas */
QLabel#overviewStatCount {
    background-color: transparent;
    color: @PRIMARY@;
    font-size: 24px;
    font-weight: 800;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 概览统计标题 �?11px 灰色大写 */
QLabel#overviewStatTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* 概览操作�?*/
QWidget#overviewActionsSection {
    background-color: transparent;
    border: none;
}

/* 概览区段标题 */
QLabel#overviewSectionTitle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 概览操作按钮 �?玻璃�?*/
QPushButton#overviewActionBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#overviewActionBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#overviewActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 概览路径�?�?玻璃�?*/
QWidget#overviewPathCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 10px 14px;
}

/* 概览路径图标 */
QLabel#overviewPathIcon {
    background-color: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
}

/* 概览路径文字 �?12px Consolas */
QLabel#overviewPathText {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* ============================================================
 * Section 23. SearchPage 样式（search* 系列�?
 * ============================================================ */
/* 搜索页输入框 */
QLineEdit#searchPageInput {
    background-color: @BG_CARD@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#searchPageInput:focus {
    border: 2px solid @PRIMARY@;
}

QLineEdit#searchPageInput:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 搜索筛�?chip */
QComboBox#searchFilterCombo,
QComboBox#searchSubFilterCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px 28px 4px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QComboBox#searchFilterCombo:hover,
QComboBox#searchSubFilterCombo:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QComboBox#searchFilterCombo:focus,
QComboBox#searchSubFilterCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#searchFilterCombo::drop-down,
QComboBox#searchSubFilterCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid @BORDER@;
}

QComboBox#searchFilterCombo::down-arrow,
QComboBox#searchSubFilterCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    width: 0;
    height: 0;
}

QComboBox#searchFilterCombo QAbstractItemView,
QComboBox#searchSubFilterCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @PRIMARY@;
    outline: none;
}

QComboBox#searchFilterCombo QAbstractItemView::item,
QComboBox#searchSubFilterCombo QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
    color: @TEXT_SECONDARY@;
    min-height: 20px;
}

QComboBox#searchFilterCombo QAbstractItemView::item:hover,
QComboBox#searchSubFilterCombo QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QComboBox#searchFilterCombo QAbstractItemView::item:selected,
QComboBox#searchSubFilterCombo QAbstractItemView::item:selected {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    font-weight: 600;
}

