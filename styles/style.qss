    border-radius: 9px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    color: @TEXT_ON_PRIMARY@;
}

QLabel#modelCheckInactive {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 9px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
