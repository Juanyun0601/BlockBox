/* ============================================================
 * Section 36. 跨页面共享标识符样式
 * ============================================================ */
/* 共享区块标题 �?通用语义保持 22px（与全局 QLabel#sectionTitle 一致）�?
 * 注意：早前此处曾重复定义 QLabel#sectionTitle �?16px 主色，与上方
 * line 110-115 �?22px 通用语义 specificity 相同却位置在后，导致所有非
 * SettingsPage 内的 sectionTitle 被覆盖成 16px 主色小标题，与原型中
 * "页面顶部大标�? 的语义冲突。现已移除此重复定义，统一�?22px 通用规则�?
 * 需�?16px 小标题语义的页面（InstanceJavaPage / InstanceJavaDownloadPage�?
 * 见下方页面级覆盖�?*/
InstanceJavaPage QLabel#sectionTitle,
InstanceJavaDownloadPage QLabel#sectionTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 600;
    border: none;
    margin-bottom: 12px;
}

/* 共享区块副标�?�?13px 三级�?*/
QLabel#sectionSubtitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
    margin-bottom: 8px;
}

/* 共享列表标题 �?对应原型 .list-title�?6px 700�?*/
QLabel#listTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    border: none;
}

/* 共享提示标签 �?12px 三级�?*/
QLabel#hintLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    padding: 4px 0;
}

/* 共享状态标�?�?12px 二级�?*/
QLabel#statusLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    border: none;
}

/* 共享主操作按�?�?主色渐变 */
QPushButton#primaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: @PRIMARY_HOVER@;
    margin: -1px;
}

QPushButton#primaryButton:pressed {
    background-color: @PRIMARY_DARK@;
}

/* 共享安装按钮 �?�?primaryButton 视觉一�?*/
QPushButton#installButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#installButton:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#installButton:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 共享安装进度�?�?玻璃态轨�?+ 主色渐变填充 */
QProgressBar#installProgressBar {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#installProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border-radius: 999px;
}

/* 共享启动按钮 �?�?primaryButton 视觉一�?*/
QPushButton#launchButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

/* 共享版本列表 �?玻璃态卡�?*/
QListWidget#versionListWidget {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

/* 安装新实例页：去掉大卡片容器，列表直接显示在背景上 */
QListWidget#versionListWidget[flatContainer="true"] {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QListWidget#versionListWidget[flatContainer="true"]::item:hover {
    background-color: transparent;
}

QListWidget#versionListWidget::item {
    padding: 8px 12px;
    border-radius: 8px;
}

QListWidget#versionListWidget::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#versionListWidget::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @ACCENT_TEXT@;
}

/* 共享存档信息�?�?13px 600字重 主色 */
QLabel#saveInfoValue {
    background-color: transparent;
    color: @ACCENT_TEXT@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 共享页面标题 �?18px 700字重 */
QLabel#pageTitleLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 18px;
    font-weight: 700;
    border: none;
}

/* 共享取消按钮 �?玻璃态描�?*/
QPushButton#cancelButton {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#cancelButton:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 共享恢复默认按钮 �?玻璃态描�?*/
QPushButton#restoreDefaultsBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
