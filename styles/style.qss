    padding: 4px;
    color: @TEXT_TERTIARY@;
}

QPushButton#topBarSearchBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

/* 顶栏账户头像 */
QLabel#accountAvatar {
    background-color: @PRIMARY@;
    border-radius: 12px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
    font-size: 13px;
}

/* 顶栏窗口控制按钮 �?最小化 */
QPushButton#minimizeBtn {
    background-color: transparent;
    border: none;
