}

/* 快捷键按�?�?玻璃�?*/
QPushButton#keyBindButton {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#keyBindButton:hover {
