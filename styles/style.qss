/* --- 39.5 设置页内容堆�?--- */
/* 设置页各内容�?�?透明无边框；内边距统一�?cpp �?setContentsMargins 控制
 * （settings/* 子页面均使用 setContentsMargins(24, 8, 24, 24) 等值）�?
 * 此处不再声明 padding，避免与 widget �?contentsMargins 叠加导致左右 48px�?
 * 顶部 32px 的过量留白�?*/
QWidget#settingsGeneralContent,
QWidget#settingsInterfaceContent,
QWidget#settingsGameContent,
QWidget#settingsInstanceContent,
QWidget#settingsJavaContent,
QWidget#settingsAdvancedContent,
QWidget#settingsKeyBindContent {
    background-color: transparent;
    border: none;
}

/* --- 39.6 ScreenshotViewer 缩略�?--- */
/* 截图缩略�?�?8px 圆角描边 */
QLabel#thumbnail {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

QLabel#thumbnail:hover {
    border: 1px solid @BORDER_HOVER@;
}

QLabel#thumbnail[selected="true"] {
    border: 2px solid @PRIMARY@;
}

/* ============================================================
 * Section 40. 跨组件状态与无障碍样�?
 * ============================================================ */
/* 通用按钮禁用�?�?灰化 + �?hover 反馈 */
QPushButton:disabled,
QPushButton:disabled:hover {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 通用输入控件禁用�?�?灰化 */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 通用列表/树禁用�?�?灰化文字 */
QListWidget:disabled::item,
QTreeWidget:disabled::item {
    color: @TEXT_DISABLED@;
}

/* 通用按钮聚焦�?�?主色边框 */
QPushButton:focus {
    border: 1px solid @PRIMARY@;
}

/* 错误态输入控�?�?危险色边�?+ 危险背景 */
QLineEdit[state="error"],
QComboBox[state="error"],
QSpinBox[state="error"] {
    border: 2px solid @DANGER@;
    background-color: @DANGER_BG@;
}

QLineEdit[state="error"]:focus,
QComboBox[state="error"]:focus,
QSpinBox[state="error"]:focus {
    border: 2px solid @DANGER@;
}

/* 通用列表/树选中态补�?�?主色半透明背景 */
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @PRIMARY@;
}

/* Task 8: 补充属性选择器规�?*/
QLabel#multiplayerLatencyLabel[status="good"] {
    color: @SUCCESS@;
}
QLabel#multiplayerLatencyLabel[status="medium"] {
    color: @WARNING@;
}
QLabel#multiplayerLatencyLabel[status="bad"] {
    color: @DANGER@;
}

QWidget#statusDot[status="running"] {
    background-color: @PRIMARY@;
}
QWidget#statusDot[status="idle"] {
    background-color: @TEXT_DISABLED@;
}
QWidget#statusDot[status="error"] {
    background-color: @DANGER@;
}

QLabel#localModStatus[status="enabled"] {
    color: @SUCCESS@;
}
QLabel#localModStatus[status="disabled"] {
    color: @TEXT_DISABLED@;
}

/* Task 9: 伪态与无障碍补�?*/
QCheckBox:focus, QRadioButton:focus {
    outline: 2px solid @PRIMARY@;
    outline-offset: 1px;
}

QProgressBar:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}
QProgressBar:disabled::chunk {
    background-color: @TEXT_DISABLED@;
}

QDoubleSpinBox {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QDoubleSpinBox:focus {
    border: 1px solid @PRIMARY@;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: @BG_MUTED@;
    border: none;
    width: 18px;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QTableView::item:hover {
    background-color: @BG_HOVER@;
}
QListView::item:focus {
    outline: 1px dashed @PRIMARY@;
    outline-offset: 1px;
}

/* ============================================================
 * Section 41. AI Agent 工具步骤卡片样式
 * ============================================================ */
QWidget#agentStepsContainer {
    background-color: transparent;
    border: none;
}

/* 工具/搜索过程行：一轮一行纯文字样式 */
QWidget#agentToolStepCard {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QPushButton#agentToolStepHeaderRow {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 1px 2px;
    text-align: left;
}

QPushButton#agentToolStepHeaderRow:hover {
    background-color: @BG_HOVER@;
}

QLabel#agentToolStepName {
    font-size: 12px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
}

QLabel#agentToolStepStatusText {
    font-size: 12px;
    background-color: transparent;
}

QLabel#agentToolStepStatusText[type="success"] {
    color: @SUCCESS@;
}

QLabel#agentToolStepStatusText[type="danger"] {
    color: @DANGER@;
}

QLabel#agentToolStepStatusText[type="info"] {
    color: @WARNING@;
}

QLabel#agentToolStepDuration {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
}

QLabel#agentToolStepSummary {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background-color: transparent;
}

/* 文件编辑行：行级增删统计（+N 绿 / -M 红） */
QLabel#agentToolStepDiffAdd {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    color: @SUCCESS@;
    background-color: transparent;
}

QLabel#agentToolStepDiffDel {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    color: @DANGER@;
    background-color: transparent;
}

QWidget#agentToolStepDetails {
    background-color: transparent;
    border: none;
    padding: 2px 0 2px 20px;
}

QLabel#agentToolStepArgs {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    background-color: transparent;
    border: none;
    padding: 0px;
    color: @TEXT_SECONDARY@;
}

QLabel#agentToolStepResult {
    font-size: 12px;
    background-color: transparent;
    border: none;
    padding: 0px;
    color: @TEXT_SECONDARY@;
}

QLabel#agentToolStepResult[status="danger"] {
    color: @DANGER@;
}

QWidget#taskListCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 10px 12px;
}

QProgressBar#taskListProgressBar {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 999px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#taskListProgressBar::chunk {
    border-radius: 999px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}

QWidget#taskListRow {
    background-color: transparent;
    min-height: 36px;
    max-height: 36px;
    padding: 0 8px;
}

QWidget#taskListRow:hover {
    background-color: @BG_HOVER@;
}

/* ============================================================
 * Section 42. LoaderDetailPage 样式
 * ============================================================ */
QLabel#loaderSectionLabel {
    font-size: 12px;
    font-weight: 600;
    color: @TEXT_TERTIARY@;
    letter-spacing: 1px;
    background-color: transparent;
}

QLineEdit#loaderInstanceNameEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 12px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY_RGBA_18@;
}

QLineEdit#loaderInstanceNameEdit:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#loaderPathCombo,
QComboBox#loaderSourceCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_PRIMARY@;
}

QComboBox#loaderPathCombo:focus,
QComboBox#loaderSourceCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#loaderPathCombo:hover,
QComboBox#loaderSourceCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

QPushButton#loaderAddFolderBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#loaderAddFolderBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QListWidget#loaderListWidget {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget#loaderListWidget::item {
    padding: 10px 12px;
    border-radius: 8px;
}

QListWidget#loaderListWidget::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#loaderListWidget::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @PRIMARY@;
}

QLabel#loaderMessageLabel {
    font-size: 13px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
    padding: 4px 0;
}

QWidget#selectedLoaderCard {
    background-color: @BG_CARD@;
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 12px;
}

QLabel#loaderSelectedCardName {
    font-size: 14px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
}

QLabel#loaderSelectedCardVersion {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
}

QLabel#loaderSelectedCardClose {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}

QLabel#loaderSelectedCardClose:hover {
    color: @DANGER@;
}

/* ============================================================
 * Section 43. CommandPack 对话框样�?
 * ============================================================ */
QTableWidget#packManagerTable {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    gridline-color: @BORDER_LIGHT@;
    outline: none;
}

QTableWidget#packManagerTable::item {
    padding: 6px 8px;
}

QTableWidget#packManagerTable::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @PRIMARY@;
}

QHeaderView::section {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid @BORDER@;
}

QHeaderView::section:hover {
    background-color: @BG_HOVER@;
}

QPushButton#packAddBtn,
QPushButton#packCreateBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#packAddBtn:hover,
QPushButton#packCreateBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#packAddBtn:pressed,
QPushButton#packCreateBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

QPushButton#packEditBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packEditBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packRemoveBtn {
    background-color: transparent;
    border: 1px solid @DANGER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @DANGER@;
}

QPushButton#packRemoveBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

QPushButton#packCloseBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packCloseBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packEditorSaveBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#packEditorSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#packEditorSaveAsBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packEditorSaveAsBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packEditorCancelBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_TERTIARY@;
}

QPushButton#packEditorCancelBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 44. 零散控件补充样式
 * ============================================================ */
QPushButton#launchButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
