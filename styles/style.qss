    border-radius: 10px;
    padding: 6px 14px;
    color: @DANGER@;
    font-size: 12px;
}

QPushButton#logoutButton:hover {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER@;
}

/* 动作选择分隔�?*/
QFrame#accountActionSeparator {
    background-color: @BORDER_LIGHT@;
    border: none;
    max-height: 1px;
    margin: 4px 0;
}

/* 动作选择标题 */
QLabel#accountActionTitle {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
    margin-top: 4px;
}

/* 动作选择下拉�?�?复用表单控件观感，紧凑适配右侧面板/皮肤预览�?*/
QComboBox#accountActionCombo,
QComboBox#skinActionCombo {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 30px 4px 10px;
    font-size: 12px;
    min-height: 18px;
}

QComboBox#accountActionCombo:hover,
QComboBox#skinActionCombo:hover {
    border-color: @BORDER_STRONG@;
}

QComboBox#accountActionCombo:focus,
QComboBox#skinActionCombo:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 8px;
    padding: 3px 29px 3px 9px;
}

QComboBox#accountActionCombo::drop-down,
QComboBox#skinActionCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: transparent;
}

QComboBox#accountActionCombo::down-arrow,
QComboBox#skinActionCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    width: 0;
    height: 0;
}

QComboBox#accountActionCombo QAbstractItemView,
QComboBox#skinActionCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QComboBox#accountActionCombo QAbstractItemView::item,
QComboBox#skinActionCombo QAbstractItemView::item {
    min-height: 28px;
    padding: 0 10px;
    border-radius: 6px;
    color: @TEXT_PRIMARY@;
}

QComboBox#accountActionCombo QAbstractItemView::item:hover,
QComboBox#skinActionCombo QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
}

QComboBox#accountActionCombo QAbstractItemView::item:selected,
QComboBox#skinActionCombo QAbstractItemView::item:selected {
    background-color: @PRIMARY_LIGHT@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 24.1 添加账户页（AccountManagePage 登录页）
 * 对照 HTML 原型 .account-add / .account-add-tabs / .account-add-form
 * ============================================================ */

/* 页面容器：透明，卡片由分段控件与表单面板绘制 */
QWidget#accountLoginPage {
    background-color: transparent;
    border: none;
}

/* 居中单列：表单卡片（自定义壁纸上保证对比度） */
QWidget#loginColumn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 20px;
}

/* 页面标题 / 副标题 */
QLabel#loginTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 22px;
    font-weight: 700;
}

QLabel#loginSubtitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}

/* 登录方式分段控件（segmented control：自绘按钮 + 隐藏 TabBar 的 QTabWidget） */
QTabWidget#loginMethodTabs {
    background-color: transparent;
    border: none;
}

QTabWidget#loginMethodTabs::pane {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QWidget#loginSegBar {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QPushButton#loginSegBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 10px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#loginSegBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#loginSegBtn:checked {
    background-color: @BG_CARD@;
    color: @PRIMARY@;
    font-weight: 600;
}

QPushButton#loginSegBtn:checked:hover {
    background-color: @BG_CARD@;
    color: @PRIMARY@;
}

/* 表单字段标签 */
QLabel#loginFieldLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 600;
}

/* 输入框 */
QLineEdit#loginInput {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}

QLineEdit#loginInput:hover {
    border: 1px solid @BORDER_HOVER@;
}

QLineEdit#loginInput:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLineEdit#loginInput:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 服务器下拉框（与输入框同形） */
QComboBox#loginCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 9px 34px 9px 14px;
    font-size: 14px;
    min-height: 20px;
    color: @TEXT_PRIMARY@;
}

QComboBox#loginCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

QComboBox#loginCombo:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QComboBox#loginCombo:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 服务器连通状态徽标 */
QLabel#loginStatusPill {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 5px 10px;
    font-size: 12px;
    color: @TEXT_TERTIARY@;
}

/* 表单提示条（能力 / 限制说明） */
QLabel#loginHint {
    background-color: @WARNING_BG@;
    border-left: 3px solid @WARNING@;
    border-radius: 8px;
    padding: 10px 12px;
    color: @WARNING_TEXT_DARK@;
    font-size: 12px;
}

/* 微软登录 hero：品牌图标 */
QLabel#loginHeroTile {
    background-color: rgba(0, 164, 239, 0.12);
    border: 1px solid rgba(0, 164, 239, 0.28);
    border-radius: 18px;
}

QLabel#loginHeroTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 700;
}

QLabel#loginHeroDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}

/* 能力标签 */
QLabel#loginChip {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 5px 11px;
    font-size: 12px;
    color: @TEXT_SECONDARY@;
}

/* 微软登录进度条 */
QProgressBar#microsoftProgressBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 4px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#microsoftProgressBar::chunk {
    background-color: @PRIMARY@;
    border-radius: 4px;
}

/* 微软登录状态 */
QLabel#microsoftStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 主按钮（主色渐变） */
QPushButton#loginPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    min-height: 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#loginPrimaryBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QPushButton#loginPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#loginPrimaryBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 确认按钮 �?主色 */
QPushButton#okBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 8px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#okBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* ============================================================
 * Section 25. ServerManagePage 样式
 * ============================================================ */
/* 资源卡片 �?玻璃�?+ hover 上浮 */
QWidget#resourceCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#resourceCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 服务器卡片图�?�?48x48 主色渐变 */
QLabel#serverCardIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 700;
    font-size: 18px;
}

/* 模组名称标签 */
QLabel#modNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 模组描述标签 */
QLabel#modDescLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 纯图标按�?*/
QPushButton#iconOnlyButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#iconOnlyButton:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#iconOnlyButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 对话框输入框 */
QLineEdit#dialogLineEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#dialogLineEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 对话框按�?�?玻璃�?*/
QPushButton#dialogButton {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#dialogButton:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 对话框标�?*/
QLabel#dialogLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
}

/* 对话框复选框 */
QCheckBox#dialogCheckBox {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    spacing: 8px;
}

/* ============================================================
 * Section 26. TaskDetailPage / TaskListPage 样式（现代化�?
 * ============================================================ */
/* 页面容器 */
QWidget#taskDetailPage {
    background-color: transparent;
}

/* 顶栏 */
QWidget#tdHeaderBar {
    background-color: @BG_CONTENT@;
    border-bottom: 1px solid @BORDER@;
}

QLabel#tdPageTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 700;
    border: none;
}

QPushButton#tdBackBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#tdBackBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    color: @PRIMARY@;
}

QPushButton#tdBackBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 滚动�?*/
QScrollArea#tdScroll,
QWidget#tdContent {
    background-color: transparent;
    border: none;
}

/* 状态胶�?*/
QLabel#tdStatusPill {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 13px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#tdStatusPill[state="paused"] {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT_DARK@;
    border: 1px solid @WARNING_BORDER@;
}

QLabel#tdStatusPill[state="done"] {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#tdStatusPill[state="failed"] {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
}

QLabel#tdStatusPill[state="queued"] {
    background-color: @BG_MUTED@;
    color: @TEXT_TERTIARY@;
    border: 1px solid @BORDER@;
}

/* Hero �?*/
QWidget#tdHero {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 @BG_CARD@, stop:1 @BG_CONTENT@);
    border: 1px solid @BORDER@;
    border-radius: 24px;
}

QLabel#tdTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 28px;
    font-weight: 800;
    border: none;
}

QLabel#tdSub {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
}

/* 元信息胶�?*/
QLabel#tdChip {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

/* 指标磁贴 */
QWidget#tdStatTile {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QWidget#tdStatTile:hover {
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#tdStatLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

QLabel#tdStatSpeed, QLabel#tdStatSize, QLabel#tdStatEta, QLabel#tdStatStage {
    background-color: transparent;
    color: @PRIMARY@;
    font-size: 18px;
    font-weight: 800;
    border: none;
}

/* 通用卡片 */
QWidget#tdCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

QLabel#tdCardTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
    border: none;
}

QLabel#tdCardSub {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 阶段胶囊 */
QLabel#tdStageChip {
    background-color: @BG_MUTED@;
    color: @TEXT_TERTIARY@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 600;
}

/* 大进度条 */
QLabel#tdBigPct {
    background-color: transparent;
    color: @PRIMARY@;
    font-size: 26px;
    font-weight: 800;
    border: none;
}

QProgressBar#tdBigBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 6px;
}

QProgressBar#tdBigBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 @PRIMARY_DARK@, stop:0.5 @PRIMARY@, stop:1 @INFO@);
    border-radius: 6px;
}

QLabel#tdFootLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

QLabel#tdFootMono {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 文件清单 */
QWidget#tdFileRow {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QLabel#tdFileName {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
}

QProgressBar#tdFileBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 3px;
}

QProgressBar#tdFileBar::chunk {
    background-color: @INFO@;
    border-radius: 3px;
}

QProgressBar#tdFileBar[done="true"]::chunk {
    background-color: @PRIMARY@;
    border-radius: 3px;
}

QLabel#tdFileState {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 任务信息 */
QLabel#tdInfoKey {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

QLabel#tdInfoVal {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 任务日志（深色终端） */
QPlainTextEdit#tdLog {
    background-color: #0B1220;
    color: #CBD5E1;
    border: none;
    border-radius: 14px;
    padding: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 12px;
    selection-background-color: rgba(16, 185, 129, 0.35);
}

QPlainTextEdit#tdLog QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QPlainTextEdit#tdLog QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.25);
    border-radius: 4px;
    min-height: 30px;
}

QPlainTextEdit#tdLog QScrollBar::add-line:vertical,
QPlainTextEdit#tdLog QScrollBar::sub-line:vertical {
    height: 0;
}

QPlainTextEdit#tdLog QScrollBar::add-page:vertical,
QPlainTextEdit#tdLog QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 操作按钮 */
QPushButton#tdActionPrimary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 9px 22px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#tdActionPrimary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 @PRIMARY_LIGHT@, stop:1 @PRIMARY@);
}

QPushButton#tdActionPrimary:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#tdActionPrimary:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

QPushButton#tdActionAccent {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 @INFO@, stop:1 @INFO_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 9px 22px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#tdActionAccent:hover {
    background-color: @INFO_HOVER@;
}

QPushButton#tdActionAccent:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

QPushButton#tdActionWarn {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 10px;
    padding: 8px 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#tdActionWarn:hover {
    background-color: @DANGER_LIGHT@;
    border: 1px solid @DANGER@;
}

QPushButton#tdActionWarn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

QPushButton#tdActionGhost {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#tdActionGhost:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 列表中的启动卡片 �?玻璃�?*/
QWidget#launchCardInList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#launchCardInList:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* --- 17.8 PresetMenu 预设菜单 --- */
QMenu#presetMenu {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
}

QMenu#presetMenu::item {
    padding: 8px 24px;
    border-radius: 8px;
    margin: 2px 4px;
}

QMenu#presetMenu::item:selected {
    background: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
}

QMenu#presetMenu::separator {
    height: 1px;
    background: @BORDER_LIGHT@;
    margin: 4px 8px;
}

/* ============================================================
