    border-radius: 16px;
}

/* 模型对话框标题栏 �?�?.dlg-head 一�?*/
QWidget#modelDialogTitleBar {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    min-height: 56px;
    max-height: 56px;
}

/* 模型对话框标�?�?17px 800字重 */
QLabel#modelDialogTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

/* 模型对话框本地按�?�?胶囊芯片 */
QPushButton#modelDialogLocalBtn {
    background-color: @PRIMARY_BG@;
