    border-radius: 12px;
    padding: 10px 12px;
}

QWidget#modelConfiguredItem:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 模型复选图�?�?active=主色 / inactive=灰色 */
