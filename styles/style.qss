}

/* 颜色标签 */
QLabel#colorLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 颜色滑块 */
QSlider#colorSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider#colorSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
}

QSlider#colorSlider::handle:horizontal {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    margin: -8px 0;
}

/* 颜色编辑�?*/
QLineEdit#colorEdit,
QLineEdit#colorHexEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    font-family: "Consolas", "Cascadia Code", monospace;
}

QLineEdit#colorEdit:focus,
QLineEdit#colorHexEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 预设�?*/
QWidget#presetGroup {
    background-color: transparent;
    border: none;
}

/* 预设色按�?�?999px 圆角 */
QPushButton#presetButton {
    background-color: @BG_CARD@;
    border: 2px solid transparent;
    border-radius: 999px;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
}

QPushButton#presetButton:hover {
    border: 2px solid @BORDER_STRONG@;
}

QPushButton#presetButton:checked {
    border: 2px solid @PRIMARY@;
}

/* 颜色按钮�?*/
QWidget#colorButtonBox {
    background-color: transparent;
    border: none;
}

/* ============================================================
 * Section 31. ModpackImportPage 样式
 * ============================================================ */
/* 整合包导�?Tab */
QTabWidget#modpackImportTabWidget {
    background-color: transparent;
    border: none;
}

QTabWidget#modpackImportTabWidget::pane {
    background-color: transparent;
    border: none;
}

/* 整合包拖放区 �?虚线边框 */
QWidget#modpackDropZone {
    background-color: @BG_MUTED@;
    border: 2px dashed @BORDER_STRONG@;
    border-radius: 12px;
    padding: 48px 24px;
}

QWidget#modpackDropZone[dragOver="true"] {
    background-color: @PRIMARY_BG@;
    border: 2px dashed @PRIMARY@;
}

/* 整合包信息组 �?玻璃�?*/
QWidget#modpackInfoGroup {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 16px;
}

/* 整合包实例名输入�?*/
QLineEdit#modpackInstNameEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modpackInstNameEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 整合包本地安装按�?�?主色渐变 */
QPushButton#modpackLocalInstallBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    padding: 10px 24px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modpackLocalInstallBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modpackLocalInstallBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 整合包远�?URL 输入�?*/
QLineEdit#modpackRemoteUrlEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modpackRemoteUrlEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 整合包远程下载按�?�?玻璃�?*/
QPushButton#modpackRemoteDownloadBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#modpackRemoteDownloadBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 整合包下载状�?*/
QLabel#modpackDownloadStatus {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 整合包下载进度条 �?INFO chunk */
QProgressBar#modpackDownloadProgress {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#modpackDownloadProgress::chunk {
    background-color: @INFO@;
    border-radius: 4px;
}

/* 整合包速度标签 */
QLabel#modpackSpeedLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 整合包远程信息组 �?玻璃�?*/
QWidget#modpackRemoteInfoGroup {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 16px;
}

/* 整合包远程实例名输入�?*/
QLineEdit#modpackRemoteInstNameEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modpackRemoteInstNameEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 整合包远程安装按�?�?主色渐变 */
QPushButton#modpackRemoteInstallBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    padding: 10px 24px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modpackRemoteInstallBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modpackRemoteInstallBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* ============================================================
 * Section 32. InstanceJavaPage / SettingsJavaPage 样式
 * 视觉方向：工具栏分层（主操作实心 / 次操作描边 / 下载软色），
 * 列表项 = 版本头像 + 标题/版本芯片 + 等宽路径 + 横向操作按钮。
 * ============================================================ */

/* ── 工具栏：浅底玻璃条，内边距收紧 ── */
QWidget#javaToolbar {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 10px 12px;
}

/* ── 检测：主操作，主色实心 ── */
QPushButton#javaDetectBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 10px;
    padding: 8px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12.5px;
    font-weight: 600;
}
QPushButton#javaDetectBtn:hover {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}
QPushButton#javaDetectBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}
QPushButton#javaDetectBtn:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* ── 手动添加：次操作，描边按钮 ── */
QPushButton#javaAddBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 8px 16px;
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
    font-weight: 500;
}
QPushButton#javaAddBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}
QPushButton#javaAddBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* ── 下载：软主色，弱化于检测 ── */
QPushButton#downloadJavaBtn {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 10px;
    padding: 8px 16px;
    color: @TEXT_ACCENT@;
    font-size: 12.5px;
    font-weight: 600;
}
QPushButton#downloadJavaBtn:hover {
    background-color: @PRIMARY_BG_SOFT@;
    border-color: @PRIMARY@;
}
QPushButton#downloadJavaBtn:pressed {
    background-color: @PRIMARY_BG@;
}

/* ── 列表区标题：左侧主色短条 + 14px 半粗 ── */
QLabel#javaListTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-left: 3px solid @PRIMARY@;
    border-radius: 1px;
    padding-left: 10px;
}

/* ── 列表面板：不再画容器卡片，Java 卡片直接铺在页面上（避免卡片套卡片） ── */
QListWidget#javaListWidget {
    background-color: transparent;
    border: none;
    padding: 0;
    outline: none;
}
QListWidget#javaListWidget::item {
    padding: 0;
    border-radius: 12px;
    color: @TEXT_PRIMARY@;
    margin-bottom: 6px;
}
QListWidget#javaListWidget::item:last {
    margin-bottom: 0;
}
QListWidget#javaListWidget::item:hover {
    background-color: transparent;
}
QListWidget#javaListWidget::item:selected {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
}

/* ── 空状态 ── */
QLabel#javaEmptyLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: 1px dashed @BORDER_DASHED@;
    border-radius: 12px;
    padding: 40px 28px;
    margin: 8px;
}

/* ── 全局默认 Java 卡片 ── */
QWidget#javaRuntimeFrame {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 16px;
}
QLabel#javaGlobalLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    font-weight: 600;
    border: none;
}
QComboBox#globalJavaCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}
QComboBox#globalJavaCombo:hover {
    border-color: @BORDER_HOVER@;
    background-color: @BG_HOVER@;
}
QComboBox#globalJavaCombo:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}
QComboBox#globalJavaCombo:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}
QComboBox#globalJavaCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 28px;
}
QComboBox#globalJavaCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 10px;
    border: none;
    margin-right: 10px;
}
QComboBox#globalJavaCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
    outline: none;
}
QComboBox#globalJavaCombo QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 8px;
    min-height: 28px;
}
QComboBox#globalJavaCombo QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
}

/* ── 列表项卡片 ── */
QWidget#javaItemFrame {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px 14px;
}
QWidget#javaItemFrame:hover {
    background-color: @BG_CARD@;
    border-color: @PRIMARY@;
}

/* 版本头像：圆角方块 + 大号主版本 */
QLabel#javaItemAvatar {
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 800;
    border: none;
    background-color: transparent;
}
QLabel#javaItemAvatar[kind="jdk"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}
QLabel#javaItemAvatar[kind="jre"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #F97316, stop:1 #C2410C);
}

/* 标题 */
QLabel#javaItemTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 700;
    border: none;
}

/* 路径：等宽、三级色、中间省略 */
QLabel#javaItemPath {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", "Courier New", monospace;
    border: none;
}

/* 版本芯片：中性底 + 二级文字（替代原主色 chip，避免对比过弱） */
QLabel#javaItemVersion {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}

/* 位数/来源小芯片（可选） */
QLabel#javaItemMeta {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
    padding: 0 0 0 6px;
}

/* ── 行内操作：横排、垂直居中 ── */
QPushButton#javaOpenFolderBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 9px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#javaOpenFolderBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}
QPushButton#javaOpenFolderBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#javaRemoveBtn {
    background-color: transparent;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 9px;
    padding: 6px 14px;
    color: @DANGER@;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#javaRemoveBtn:hover {
    background-color: @DANGER_BG@;
    border-color: @DANGER@;
}
QPushButton#javaRemoveBtn:pressed {
    background-color: @DANGER_BG@;
    border-color: @DANGER@;
    color: @DANGER@;
}

/* ============================================================
 * Section 33. InstanceResourcesPage / InstanceFilePage / LaunchDetailsPage 样式
 * ============================================================ */
/* 资源 Tab �?�?透明 */
QWidget#resourcesTabBar {
    background-color: transparent;
    border: none;
}

/* 资源 Tab 高亮�?�?3px 主色 */
QWidget#resourcesTabHighlight {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 0 3px 3px 0;
    min-width: 3px;
    max-width: 3px;
}

/* 资源 Tab 按钮 */
QPushButton#resourcesTabBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#resourcesTabBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#resourcesTabBtn:checked {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

/* 文件更新芯片 �?警告�?*/
QLabel#fileUpdateChip {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 未保存更改栏 �?警告色背�?*/
QWidget#unsavedChangesBar {
    background-color: @WARNING_BG@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 8px;
    padding: 10px 14px;
}

/* 未保存更改标�?*/
QLabel#unsavedChangesLabel {
    background-color: transparent;
    color: @WARNING_TEXT@;
    font-size: 13px;
    border: none;
}

/* 保存按钮 �?主色渐变 */
QPushButton#saveButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#saveButton:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#saveButton:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 加载器状态标�?*/
QLabel#loaderStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 状态点 �?8x8 圆形 running=主色 */
QWidget#statusDot {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
}

QWidget#statusDot[status="idle"] {
    background-color: @TEXT_TERTIARY@;
}

QWidget#statusDot[status="error"] {
    background-color: @DANGER@;
}

/* 日志状态标�?*/
QLabel#logStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 取消启动按钮 �?危险色边�?*/
QPushButton#cancelLaunchBtn {
    background-color: transparent;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @DANGER@;
    font-size: 13px;
}

QPushButton#cancelLaunchBtn:hover {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER@;
}

/* 清除日志按钮 �?玻璃�?*/
QPushButton#clearLogBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#clearLogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 导出日志按钮 */
QPushButton#exportLogBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#exportLogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 34. SettingsPage 子页面样�?
 * ============================================================ */
/* 设置内容堆栈 */
QStackedWidget#settingsContentStack {
    background-color: transparent;
    border: none;
}

/* 设置卡片 �?白色圆角容器（对应原�?.settings-card�?*/
QFrame#settingsCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-bottom: 12px;
}

/* 设置页标题栏卡片 �?标题 + 恢复默认值按钮 */
QFrame#settingsHeaderCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-bottom: 12px;
}

/* 卡片内标题重置外边距（去掉全局 sectionTitle 的底部留白） */
QFrame#settingsHeaderCard QLabel#sectionTitle {
    margin: 0px;
    padding: 0px;
    border: none;
    background-color: transparent;
}

/* 设置分区标题�?�?可点击的折叠/展开按钮（CollapsibleSectionCard�?*/
QPushButton#settingsSectionHeader {
    background-color: transparent;
    border: none;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 14px 24px;
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
    text-align: left;
}

QPushButton#settingsSectionHeader:hover {
    background-color: @BG_HOVER@;
}

QPushButton#settingsSectionHeader:pressed {
    background-color: @BG_PRESSED@;
}

/* 展开状态下标题栏底部显示分隔线 */
QPushButton#settingsSectionHeader:checked {
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* 设置信息�?�?对应原型 .setting-row */
QFrame#settingRow,
QWidget#settingRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QFrame#settingRow[lastRow="true"],
QWidget#settingRow[lastRow="true"] {
    border-bottom: none;
}

/* 设置信息包装 �?必须透明，否则继承全局 QWidget 背景覆盖白色卡片 */
QWidget#settingInfo {
    background-color: transparent;
    border: none;
}

/* 设置行标�?�?对应原型 .setting-info label�?3px 600�?*/
QLabel#settingTitle {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

/* 设置行描�?�?对应原型 .setting-info p�?2px 三级灰） */
QLabel#settingDesc {
    background-color: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

/* 设置行值标�?�?滑块等控件旁边的数�?*/
QLabel#settingValueLabel {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    min-width: 48px;
}

/* 设置行警告标�?�?超标提示 */
QLabel#settingWarningLabel {
    background-color: transparent;
    border: none;
    color: @DANGER@;
    font-size: 11px;
}

/* JVM参数编辑框（等宽字体，与全局输入框保持一致的圆角与内边距） */
QTextEdit#jvmParamsEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QTextEdit#jvmParamsEdit:hover {
    border-color: @BORDER_STRONG@;
}

QTextEdit#jvmParamsEdit:focus {
    border: 2px solid @PRIMARY@;
    padding: 7px 11px;
}

/* 颜色选择/调色板按�?�?玻璃�?*/
QPushButton#colorPickerBtn,
QPushButton#paletteBtn,
QPushButton#bgColorBtn,
QPushButton#bgPaletteBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#colorPickerBtn:hover,
QPushButton#paletteBtn:hover,
QPushButton#bgColorBtn:hover,
QPushButton#bgPaletteBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 收藏夹页 �?工具按钮（替代先前内联硬编码 #ffffff，深色主题可正常适配�?*/
QPushButton#favManageBtn {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#favManageBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#favManageBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 收藏夹页 �?刷新按钮�?4x34 圆角图标按钮�?*/
QPushButton#favRefreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0;
}

QPushButton#favRefreshBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QPushButton#favRefreshBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 子导航头 �?收起按钮�?4x24 纯图标按钮）
 * 防止通用 QPushButton �?8x16 padding/1px 边框挤偏 chevron 图标 */
QPushButton#subNavCollapseBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    color: @TEXT_TERTIARY@;
}

QPushButton#subNavCollapseBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#subNavCollapseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* Java 下载�?�?圆形返回按钮�?8x28，单字符 "�?�?*/
QPushButton#javaDownloadBackBtn {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    padding: 0;
    color: @TEXT_TERTIARY@;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#javaDownloadBackBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#javaDownloadBackBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 背景模糊滑块 / 旋转速度滑块 */
QSlider#bgBlurSlider::groove:horizontal,
QSlider#bgSpeedSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider#bgBlurSlider::sub-page:horizontal,
QSlider#bgSpeedSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
}

QSlider#bgBlurSlider::handle:horizontal,
QSlider#bgSpeedSlider::handle:horizontal {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    margin: -8px 0;
}

/* 快捷键名称标�?�?13px 600字重 */
QLabel#keyBindNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 快捷键按键标�?�?12px Consolas */
QLabel#keyBindKeyLabel {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
}

/* 快捷键按�?�?玻璃�?*/
QPushButton#keyBindButton {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#keyBindButton:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 快捷键重置按�?�?透明 */
QPushButton#keyBindResetButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#keyBindResetButton:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

/* 快捷键描�?�?12px 三级�?*/
QLabel#keyBindDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    margin-bottom: 12px;
}

/* Java 路径下拉�?*/
QComboBox#javaPathCombo {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QComboBox#javaPathCombo:focus {
    border: 2px solid @PRIMARY@;
}

/* Java 浏览/刷新按钮 �?玻璃�?*/
QPushButton#javaBrowseBtn,
QPushButton#javaRefreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#javaBrowseBtn:hover,
QPushButton#javaRefreshBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 内存模式下拉�?*/
QComboBox#memoryModeCombo {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QComboBox#memoryModeCombo:focus {
    border: 2px solid @PRIMARY@;
}

/* 自动内存信息标签 �?INFO �?*/
QLabel#autoMemoryInfoLabel {
    background-color: transparent;
    color: @INFO@;
    font-size: 11px;
    border: none;
}

/* 检查更新按�?�?主色渐变 */
QPushButton#checkUpdateBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#checkUpdateBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* 历史/管理实例按钮 �?玻璃�?*/
QPushButton#historyBtn,
QPushButton#manageInstancesBtn,
QPushButton#jumpToInstanceSettingsBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#historyBtn:hover,
QPushButton#manageInstancesBtn:hover,
QPushButton#jumpToInstanceSettingsBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 35. 组件专属样式
 * ============================================================ */

/* ------------------------------------------------------------
 * Section 35.1. ModelSelectDialog 补充样式
 * ------------------------------------------------------------ */
/* 模型列表项：扁平列表行（无卡片描边）+ hover 高亮 */
QWidget#modelConfiguredItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 7px 10px;
}

QWidget#modelConfiguredItem:hover {
    background-color: @BG_HOVER@;
    border: none;
}

/* 列表行分隔线 */
QFrame#modelItemSeparator {
    background-color: @BORDER@;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* 模型复选图�?�?active=主色 / inactive=灰色 */
QLabel#modelCheckActive {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 9px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    color: @TEXT_ON_PRIMARY@;
}

QLabel#modelCheckInactive {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 9px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    color: @TEXT_TERTIARY@;
}

/* 模型配置名称 �?13px 600字重 */
QLabel#modelConfigName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 列表项右侧悬浮信息（上下文/模态/推理）· 11px 弱化色 */
QLabel#modelMetaInfo {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
    padding-left: 12px;
}

/* 模型配置 key �?11px Consolas */
QLabel#modelConfigKey {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 模型使用按钮 �?主色渐变 */
QPushButton#modelUseBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modelUseBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* 模型删除按钮 �?危险色边�?*/
QPushButton#modelDelBtn {
    background-color: transparent;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 8px;
    padding: 0px;
    color: @DANGER@;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#modelDelBtn:hover {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER@;
}

/* 模型提供者项/�?�?卡片 + hover 主色描边 */
QWidget#modelProviderItem,
QWidget#modelRow {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 12px;
}

QWidget#modelProviderItem:hover,
QWidget#modelRow:hover {
    background-color: @PRIMARY_RGBA_10@;
    border: 1px solid @PRIMARY_RGBA_38@;
    margin: 0;
}

/* 模型/提供者打开链接按钮 �?链接�?*/
QPushButton#modelOpenLinkBtn,
QPushButton#providerOpenLinkBtn {
    background-color: transparent;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 5px 12px;
    color: @LINK@;
    font-size: 11px;
}

QPushButton#modelOpenLinkBtn:hover,
QPushButton#providerOpenLinkBtn:hover {
    background-color: @LINK_RGBA_0.10@;
    border: 1px solid @LINK@;
}

/* 模型热门网格 */
QWidget#modelHotGrid {
    background-color: transparent;
    border: none;
}

/* 模型热门按钮 �?胶囊芯片 */
QPushButton#modelHotBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 8px 18px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modelHotBtn:hover {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QPushButton#modelHotBtn:checked {
    background-color: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* 提供�?模型提供者标题行 �?12px 600字重 主色 */
QWidget#providerHeaderRow,
QLabel#modelProviderHeader {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
    letter-spacing: 0.01em;
}

/* 模型自定义输入行 */
QWidget#modelCustomInputRow {
    background-color: transparent;
    border: none;
}

/* 模型自定义名称输入框 */
QLineEdit#modelCustomNameInput {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modelCustomNameInput:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 模型获取按钮 �?玻璃�?*/
QPushButton#modelFetchBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#modelFetchBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 模型配置表单 �?圆角卡片 */
QWidget#modelConfigForm {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 18px;
}

/* 配置输入�?*/
QLineEdit#configNameEdit,
QLineEdit#configIdEdit,
QLineEdit#configUrlEdit,
QLineEdit#configKeyEdit {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#configNameEdit:focus,
QLineEdit#configIdEdit:focus,
QLineEdit#configUrlEdit:focus,
QLineEdit#configKeyEdit:focus {
    border: 1.5px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 配置取消按钮 �?次按�?*/
QPushButton#configCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 8px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#configCancelBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 配置保存按钮 �?主色渐变 */
QPushButton#configSaveBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 9px;
    padding: 8px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#configSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* 模型 JSON 编辑�?�?代码编辑器背�?*/
QTextEdit#modelJsonEdit,
QPlainTextEdit#modelJsonEdit {
    background-color: @EDITOR_BG@;
    border: 1px solid @EDITOR_BORDER@;
    border-radius: 12px;
    padding: 12px 14px;
    color: @EDITOR_TEXT@;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 12px;
}

/* JSON 导入/导出按钮 �?次按�?*/
QPushButton#jsonImportBtn,
QPushButton#jsonExportBtn,
QPushButton#jsonCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#jsonImportBtn:hover,
QPushButton#jsonExportBtn:hover,
QPushButton#jsonCancelBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* JSON 保存按钮 �?主色 */
QPushButton#jsonSaveBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 9px;
    padding: 7px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#jsonSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

