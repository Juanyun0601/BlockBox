}

/* --- 17.2.1 AiChatPage 紧凑模式（实例助�?450px 窄窗口覆盖） ---
 * 通过 AiChatPage::setCompactMode 设置动态属�?compactMode 触发�?
 * 缩小欢迎页标�?简介字号、快捷按钮尺寸、消息字号与输入区按钮内边距�?
 * �?AI 助手页在实例助手窄窗口下不换行、不溢出、视觉不拥挤�?*/
AiChatPage[compactMode="true"] QLabel#aiChatConvTitle {
    font-size: 13px;
}

AiChatPage[compactMode="true"] QLabel#aiChatWelcomeTitleLabel {
    font-size: 20px;
}

AiChatPage[compactMode="true"] QLabel#aiChatWelcomeDescLabel {
    font-size: 13px;
    padding: 0 8px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatQuickBtn {
    padding: 9px 12px;
    font-size: 12px;
    min-width: 96px;
    max-width: 200px;
}

AiChatPage[compactMode="true"] QFrame#aiChatUserBubble QLabel#msgContent,
AiChatPage[compactMode="true"] QFrame#aiChatAiBubble QLabel#msgContent {
    font-size: 13px;
}

AiChatPage[compactMode="true"] QTextEdit#aiChatInputEdit {
    font-size: 13px;
    padding: 5px 6px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatSendBtn {
    padding: 0;
}

AiChatPage[compactMode="true"] QPushButton#aiChatModelBtn {
    padding: 4px 8px;
    font-size: 11px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatWorkspaceBtn {
    padding: 0 8px;
    font-size: 11px;
}

AiChatPage[compactMode="true"] QComboBox#aiChatThinkingEffortCombo,
AiChatPage[compactMode="true"] QComboBox#aiChatPermissionCombo {
    padding: 4px 6px 4px 8px;
    font-size: 11px;
    min-height: 20px;
}

QDialog#localModelDialog,
QDialog#pluginSettingsDialog {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QWidget#pluginSettingsForm {
    background-color: transparent;
    padding: 16px;
}

QComboBox#refNetTypeCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_PRIMARY@;
}

QComboBox#refNetTypeCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#refNetTypeCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

/* ===== Section 45: InstanceGameSettingsPage 实例游戏设置�?===== */
QLabel#instanceInfoLabel {
    font-size: 14px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QComboBox#instanceJavaPathCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QComboBox#instanceJavaPathCombo:focus {
    border: 1px solid @PRIMARY@;
}
QComboBox#instanceJavaPathCombo::drop-down {
    border: none;
    width: 20px;
}

QSlider#instanceMemorySlider::groove:horizontal {
    height: 4px;
    background: transparent;
    border-radius: 999px;
}
QSlider#instanceMemorySlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    border-radius: 999px;
}
QSlider#instanceMemorySlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 999px;
}

QLineEdit#instanceJvmArgsEdit {
    font-family: Consolas, Monaco, "Courier New", monospace;
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceJvmArgsEdit:focus {
    border: 1px solid @PRIMARY@;
}

QLineEdit#instanceNameEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceNameEdit:focus {
    border: 1px solid @PRIMARY@;
}

QLabel#instanceIconPreview {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 24px;
}

QLineEdit#instanceMinMemoryEdit,
QLineEdit#instanceWindowWidthEdit,
QLineEdit#instanceWindowHeightEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceMinMemoryEdit:focus,
QLineEdit#instanceWindowWidthEdit:focus,
QLineEdit#instanceWindowHeightEdit:focus {
    border: 1px solid @PRIMARY@;
}

QPushButton#refreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}
QPushButton#refreshBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

/* ===== Section 46: MicrosoftLoginDialog 微软登录对话�?===== */
QLabel#loginStatusLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QProgressBar#loginProgressBar {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    height: 6px;
    text-align: center;
}
QProgressBar#loginProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    border-radius: 999px;
}

QPushButton#openBrowserButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton#openBrowserButton:hover {
    margin-top: -1px;
}
QPushButton#openBrowserButton:pressed {
    margin-top: 0px;
}

/* ===== Section 47: ShaderPackSettingsPage 光影包设置页 =====
 * 标题 / 副标�?/ 选项�?/ 按钮均复用设置页共享样式
 * （sectionTitle / sectionSubtitle / settingRow / restoreDefaultsBtn / saveButton）�?
 * 仅保留分页容器背景修正：选项行直接铺�?QTabWidget::pane 卡片上�?*/
