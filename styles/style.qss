}

/* Java 空提�?*/
QLabel#javaEmptyLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
    padding: 48px 24px;
}

/* Java 运行时框�?�?玻璃�?*/
QWidget#javaRuntimeFrame {
