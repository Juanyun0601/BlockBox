}

/* 官方新闻列表底部「加载更多」 */
QWidget#newsLoadMoreBar {
    background-color: transparent;
    border: none;
}

QPushButton#newsLoadMoreBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#newsLoadMoreBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    color: @TEXT_PRIMARY@;
}

QPushButton#newsLoadMoreBtn:pressed {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY@;
}

/* 官方新闻区标题旁的来源说明 */
QLabel#homeNewsSource {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 官方新闻加载 / 失败提示 */
QLabel#homeNewsStatus {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 性能详情对话�?卡片 �?玻璃�?*/
QWidget#perfDetailDialog,
QWidget#perfDetailCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 性能详情标题 �?16px 600字重 */
QLabel#perfDetailTitle {
    background-color: transparent;
