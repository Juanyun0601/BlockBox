    font-size: 13px;
    border: none;
    padding: 24px;
}

/* 模型热门标题 �?11px 700字重 大写 */
QLabel#modelHotTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    padding: 4px 2px;
}

/* 模型供应商内�?�?透明 */
QWidget#modelProviderContent {
    background-color: transparent;
    border: none;
}

/* 模型配置表单标题 �?15px 600字重 */
