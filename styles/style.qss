    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

/* 技能数量标�?�?主色 chip */
QLabel#skillCountLabel {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 技能描述标�?*/
QLabel#skillDescLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    line-height: 1.6;
    border: none;
}

/* 技能滚动区 */
QScrollArea#skillScrollArea {
    background-color: transparent;
    border: none;
}

/* 技能导�?刷新按钮 �?次按�?*/
QPushButton#skillImportBtn,
QPushButton#skillRefreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 6px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#skillImportBtn:hover,
QPushButton#skillRefreshBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 技能关闭按�?�?主色 */
QPushButton#skillCloseBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 9px;
    padding: 6px 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#skillCloseBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* 技能空提示 */
QLabel#skillEmptyLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
    padding: 48px 24px;
}

/* 技能项卡片 �?圆角卡片 + hover 上浮 */
QWidget#skillItemCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 14px;
}

QWidget#skillItemCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* ------------------------------------------------------------
 * Section 35.5. InstanceAssistantWindow 样式
 * ------------------------------------------------------------ */
/* 助手导航�?�?渐变背景 */
QWidget#assistantNavBar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @BG_MUTED@,
        stop:1 @BG_BASE@);
    border-right: 1px solid @BORDER_LIGHT@;
}

/* 助手导航滚动�?容器 */
QScrollArea#assistantNavScroll {
    background-color: transparent;
    border: none;
}

QWidget#assistantNavContainer {
    background-color: transparent;
}

/* 助手高亮�?�?3px 主色 */
QWidget#assistantHighlight {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 3px;
}

/* 助手堆栈 */
QStackedWidget#assistantStackedWidget,
QStackedWidget#assistantJavaStack {
    background-color: transparent;
    border: none;
}

/* 操作等级下拉�?*/
QComboBox#opLevelCombo {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QComboBox#opLevelCombo:focus {
    border: 2px solid @PRIMARY@;
}

/* 命令输入�?*/
QLineEdit#commandInput {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#commandInput:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 补全列表 �?玻璃�?*/
QListWidget#completionList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget#completionList::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: @TEXT_PRIMARY@;
}

QListWidget#completionList::item:hover {
    background-color: @BG_MUTED@;
}

QListWidget#completionList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* 英文输出 �?14px Consolas */
QTextEdit#englishOutput {
    background-color: @CODE_BG@;
    border: 1px solid @CODE_BORDER@;
    border-radius: 8px;
    padding: 10px;
    color: @CODE_TEXT@;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 14px;
}

/* 复制/注入按钮 */
QPushButton#copyBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#copyBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#injectBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#injectBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

/* 历史/包装/预设按钮 �?玻璃�?*/
QPushButton#packBtn,
QPushButton#presetBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#packBtn:hover,
QPushButton#presetBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 历史对话框列�?�?玻璃�?*/
QListWidget#historyDialogList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget#historyDialogList::item {
    padding: 8px 10px;
    border-radius: 4px;
    color: @TEXT_PRIMARY@;
}

QListWidget#historyDialogList::item:hover {
    background-color: @BG_MUTED@;
}

QListWidget#historyDialogList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* ------------------------------------------------------------
 * Section 35.6. TaskBar / TopBar 补充 / NewsCard / PerformanceDetailDialog / PluginRunnerDialog 样式
 * ------------------------------------------------------------ */
/* 任务�?�?玻璃�?*/
/* 任务栏外层透明：真正的玻璃托盘是 #taskBarTray，四周留白透出窗口背景 */
QWidget#taskBar {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 悬浮玻璃托盘：更通透底色 + 极淡描边，自然叠在内容上方 */
QWidget#taskBarTray {
    background-color: @BG_GLASS_TASKBAR@;
    border: 1px solid @BORDER_GLASS_TASKBAR@;
    border-radius: 18px;
}

/* 托盘上方的收起/展开按钮行：本身透明，只有按钮可见 */
QWidget#taskBarToggleRow {
    background-color: transparent;
}

/* 收起/展开小胶囊：收起后它就贴在窗口下沿，是唯一露出的入口 */
QPushButton#taskBarToggleBtn {
    background-color: @BG_GLASS_TASKBAR@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_GLASS_TASKBAR@;
    border-radius: 12px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#taskBarToggleBtn:hover {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border-color: @PRIMARY_RGBA_38@;
}

QPushButton#taskBarToggleBtn:pressed {
    background-color: @PRIMARY_RGBA_20@;
}

/* 活跃下载任务计数胶囊 */
QLabel#taskCountBadge {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 700;
}

/* 任务栏滚动区/内容 */
QScrollArea#taskBarScrollArea {
    background-color: transparent;
    border: none;
}

/* 横向滚动条收窄：托盘内只留 6px，避免出现任务时卡片整体上跳 */
QScrollArea#taskBarScrollArea QScrollBar:horizontal {
    height: 6px;
    margin: 0 10px;
}

QScrollArea#taskBarScrollArea QScrollBar::handle:horizontal {
    min-width: 40px;
    border-radius: 3px;
}

QWidget#taskBarCardsContent {
    background-color: transparent;
}

/* 查看全部任务按钮 �?玻璃�?*/
/* QPushButton#viewAllTaskBtn 的规则统一写在 Section 14 任务栏区块，避免两处定义互相覆盖 */

/* 顶栏滚动到顶按钮 */
QPushButton#topBarScrollToTopBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#topBarScrollToTopBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

/* 标题搜索图标 */
QLabel#titleSearchIcon {
    background-color: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
}

/* 实例设置/助手按钮 */
QPushButton#instanceSettingsBtn,
QPushButton#instanceAssistantBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#instanceSettingsBtn:hover,
QPushButton#instanceAssistantBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

/* 窗口控制卡片 */
QWidget#windowControlCard {
    background-color: transparent;
    border: none;
}

/* 新闻卡片 �?玻璃�?*/
QWidget#newsCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#newsCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 新闻标题 �?14px 600字重 */
QLabel#newsTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 新闻日期 �?11px 灰色 */
QLabel#newsDate {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 新闻摘要 �?12px 灰色 */
QLabel#newsSummary {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 新闻分类标签（胶囊底 + 主题色文字） */
