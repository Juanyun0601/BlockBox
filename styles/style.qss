}

/* 账户列表�?�?现代卡片行（hover 上浮 + 选中主色描边/左侧竖条�?*/
QPushButton#accountNavBtn {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    color: @TEXT_SECONDARY@;
