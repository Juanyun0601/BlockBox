}

/* Java 扫描/添加/检�?下载按钮 */
QPushButton#javaScanBtn,
QPushButton#javaAddBtn,
QPushButton#javaDetectBtn,
QPushButton#downloadJavaBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
