/* ===== Section 49: StartupProgressWidget 启动进度组件 ===== */
QLabel#startupTitleLabel {
    font-size: 22px;
    font-weight: 700;
    color: @PRIMARY@;
    background: transparent;
}

QLabel#startupStatusLabel {
    font-size: 13px;
    color: @TEXT_SECONDARY@;
    background: transparent;
