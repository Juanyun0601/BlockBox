}

/* ============================================================
 * Section 5. 侧边栏样式（SideBar、parentNavButton、sidebarSelectionHighlight�?
 * ============================================================ */
/* 侧边栏容�?�?渐变背景近似毛玻�?*/
/* 侧边栏容器渐变与顶栏一致，保证默认底色统一 */
SideBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.62),
        stop:1 rgba(255, 255, 255, 0.68));
    border-right: 1px solid @BORDER_LIGHT@;
}

/* 侧边栏滚动区�?*/
SideBar QScrollArea {
    background-color: transparent;
    border: none;
}

SideBar QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

SideBar QScrollArea > QWidget {
    background-color: transparent;
}

/* 侧边栏分隔线 */
QFrame#sideSeparator {
    background-color: @BORDER_LIGHT@;
    max-width: 1px;
    min-width: 1px;
}

/* 侧边栏一级导航按�?�?默认�?*/
QPushButton#parentNavButton {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 8px 4px;
    color: @TEXT_TERTIARY@;
    text-align: center;
    font-size: 10px;
    font-weight: 500;
}

/* 侧边栏一级导航按�?�?悬停�?*/
QPushButton#parentNavButton:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

/* 侧边栏一级导航按�?�?选中态（主色渐变背景�?*/
QPushButton#parentNavButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @ACCENT_TEXT@;
}

/* 侧边栏选中指示�?�?3px 主色�?+ 辉光 */
QWidget#sidebarSelectionHighlight {
    background-color: @PRIMARY@;
    border-radius: 0 3px 3px 0;
    border: none;
    min-width: 3px;
    max-width: 3px;
}

/* 侧边栏导航图标标�?*/
QLabel#parentNavIconLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 侧边栏导航文字标�?*/
QLabel#parentNavTextLabel {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
}

/* 侧边栏导航徽�?*/
QLabel#parentNavBadgeLabel {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 600;
    padding: 0 4px;
    min-width: 16px;
    min-height: 16px;
}

/* 侧边栏底部版本徽�?*/
QLabel#sidebarVersionLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
    padding: 4px;
}

/* 侧边栏底�?展开子导�?按钮 �?子导航面板收起后显示 */
QPushButton#sidebarExpandBtn {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    color: @TEXT_TERTIARY@;
}

QPushButton#sidebarExpandBtn:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @ACCENT_TEXT@;
}

QPushButton#sidebarExpandBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* ============================================================
 * Section 6. 子导航样式（SubNavPanel、subNavButton、subNavHighlight�?
 * ============================================================ */
/* 子导航面板容�?�?玻璃态近�?*/
SubNavPanel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 16px;
}

/* 头部上缘随面板圆角收口，避免横线压在直角上 */
SubNavPanel #subNavHeader {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

/* 子导航面板滚动区�?*/
SubNavPanel QScrollArea {
    background-color: transparent;
    border: none;
}

SubNavPanel QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

SubNavPanel QScrollArea > QWidget {
    background-color: transparent;
}

/* 子导航分隔线 */
QFrame#subNavSeparator {
    background-color: @BORDER_LIGHT@;
    max-width: 1px;
    min-width: 1px;
}

/* 子导航分组标�?*/
QLabel#subNavGroupTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 12px 12px 4px 12px;
    text-transform: uppercase;
}

/* 子导航按�?�?默认�?*/
QPushButton#subNavButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    color: @TEXT_SECONDARY@;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

/* 子导航按�?�?悬停�?*/
QPushButton#subNavButton:hover {
    background-color: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

/* 子导航按�?�?选中态（主色渐变背景�?*/
QPushButton#subNavButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @ACCENT_TEXT@;
}

/* 子导航选中指示�?�?3px 主色�?*/
QWidget#subNavHighlight {
    background-color: @PRIMARY@;
    border-radius: 0 3px 3px 0;
    border: none;
    min-width: 3px;
    max-width: 3px;
}

/* 子导航图标标�?*/
QLabel#subNavIconLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 子导航文字标�?*/
QLabel#subNavTextLabel {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 13px;
    font-weight: 500;
}

/* 子导航徽�?*/
QLabel#subNavBadgeLabel {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 600;
    padding: 0 6px;
    min-height: 16px;
}

/* ---------- 子导航顶部搜索框（过滤当前页面内容） ----------
 * 结构：subNavSearchRow（只负责外边距，让胶囊四边都离气泡边缘留白）
 *       └ subNavSearchContainer（胶囊本体：底色 + 1px 描边）
 *           ├ subNavSearchIcon（16x16，颜色由代码跟随主题/聚焦态）
 *           └ subNavSearchEdit（透明输入框）
 * 三态层层递进：常态淡底细描边 → 悬停描边加深 → 聚焦浅底 + 主色描边环。
 * 聚焦态由 SubNavPanel 的 eventFilter 置 searchFocus 动态属性驱动（Qt 无 :focus-within）。 */
QWidget#subNavSearchContainer {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    min-height: 32px;
    max-height: 32px;
}

QWidget#subNavSearchContainer:hover {
    background-color: @BG_MUTED@;
    border-color: @BORDER_HOVER@;
}

/* 聚焦：底色抬到卡片色、描边转主色，焦点位置一眼可见 */
QWidget#subNavSearchContainer[searchFocus="true"] {
    background-color: @BG_CARD@;
    border-color: @PRIMARY@;
}

/* 输入框本体透明，垂直方向撑满胶囊（整个高度都能点进焦点），
 * 也不再留额外的上下内边距，避免胶囊内出现偏下的空白条 */
QWidget#subNavSearchContainer > QLineEdit#subNavSearchEdit {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 30px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_26@;
    selection-color: @TEXT_PRIMARY@;
}

/* 聚焦时保持透明（覆盖全局 QLineEdit:focus 的主色边框与内边距） */
QWidget#subNavSearchContainer > QLineEdit#subNavSearchEdit:hover,
QWidget#subNavSearchContainer > QLineEdit#subNavSearchEdit:focus {
    border: none;
    background-color: transparent;
    padding: 0;
}

QLabel#subNavSearchIcon {
    background-color: transparent;
    border: none;
    padding: 0;
    color: @TEXT_TERTIARY@;
}

/* ============================================================
 * Section 7. 页面容器样式（HomePage、ResourcesPage、SettingsPage 等）
 * ============================================================ */
/* 内容包装�?*/
QWidget#contentWrapper {
    background-color: @BG_BASE@;
}

/* 页面容器通用样式 */
HomePage, ResourcesPage, BrowsePage, SettingsPage, SearchPage {
    background-color: @BG_BASE@;
}

/* QStackedWidget 容器 */
QStackedWidget {
    background-color: @BG_BASE@;
    border: none;
}

/* 设置页右侧内容区 */
QFrame#settingsRightFrame {
    background-color: @BG_CONTENT@;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* 设置页右侧滚动区�?*/
SettingsPage QScrollArea {
    background-color: transparent;
    border: none;
}

SettingsPage QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 通用页面滚动区域 */
QScrollArea#pageScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#pageScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 消息�?*/
QFrame#messageBar {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
    padding: 8px 12px;
}

QLabel#messageBarLabel {
    background-color: transparent;
    color: @TEXT_ACCENT@;
    font-size: 13px;
}

QLabel#messageBarIcon {
    background-color: transparent;
    border: none;
}

/* 修改现有实例模式 */
QWidget#modifyBanner {
    background-color: @PRIMARY_RGBA_10@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
}

QLabel#modifyBannerLabel {
    background-color: transparent;
    border: none;
    color: @PRIMARY_TEXT@;
    font-size: 13px;
}

QWidget#modifyInfoBar {
    background-color: @PRIMARY_RGBA_10@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
}

QLabel#modifyInfoLabel {
    background-color: transparent;
    border: none;
    color: @PRIMARY_TEXT@;
    font-size: 13px;
}

/* ============================================================
 * Section 8. 按钮样式（通用 QPushButton、具名按钮）
 * ============================================================ */
/* 通用 QPushButton 默认样式 */
QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

/* 通用 QPushButton 悬停�?*/
QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 通用 QPushButton 按下�?*/
QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 通用 QPushButton 禁用�?*/
QPushButton:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 启动游戏按钮 �?主色渐变 + 阴影 */
/* TopBar launch button (instance card limits it to 32px high -> max 16px radius) */
QPushButton#launchGameBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 16px;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 600;
}

/* 启动游戏按钮 �?悬停态（阴影增强近似�?*/
QPushButton#launchGameBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
    padding: 7px 24px 9px 24px;
}

/* 启动游戏按钮 �?按下�?*/
QPushButton#launchGameBtn:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_PRESSED@,
        stop:1 @PRIMARY_DARK@);
    padding: 9px 24px 7px 24px;
}

/* 启动游戏按钮 �?禁用�?*/
QPushButton#launchGameBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 实例选择按钮 �?无边框图标按钮（与实例设�?助手按钮一致） */
QPushButton#instanceSelectBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#instanceSelectBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#instanceSelectBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 恢复默认按钮 �?幽灵按钮 */
QPushButton#restoreDefaultsBtn {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton#restoreDefaultsBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border-color: @BORDER_STRONG@;
}

/* 浏览按钮 */
QPushButton#browseBtn {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 13px;
}

QPushButton#browseBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#browseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 侧边工具按钮 */
QPushButton#sideToolBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
}

QPushButton#sideToolBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#sideToolBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 窗口控制按钮 �?通用 */
QPushButton#windowControlBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_SECONDARY@;
}

QPushButton#windowControlBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 取消按钮 */
QPushButton#cancelButton {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#cancelButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* 圆形图标按钮 */
QToolButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 999px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QToolButton#iconButton:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QToolButton#iconButton:pressed {
    background-color: @BG_PRESSED@;
}

/* 卡片操作按钮 �?小号主按�?*/
QPushButton#cardPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#cardPrimaryBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QPushButton#cardPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 卡片操作按钮 �?小号次要按钮 */
QPushButton#cardSecondaryBtn {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#cardSecondaryBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 危险按钮 */
QPushButton#dangerBtn {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: @DANGER_HOVER@;
}

QPushButton#dangerBtn:pressed {
    background-color: @DANGER_PRESSED@;
}

/* 链接按钮 */
QPushButton#linkButton {
    background-color: transparent;
    color: @LINK@;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
    text-align: left;
}

QPushButton#linkButton:hover {
    color: @LINK_HOVER@;
    text-decoration: underline;
}

/* ============================================================
 * Section 9. 表单控件样式（QLineEdit、QComboBox、QSpinBox、QSlider、QCheckBox、QRadioButton�?
 * ============================================================ */
/* QLineEdit 文本输入�?�?默认�?*/
QLineEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

/* QLineEdit 悬停�?*/
QLineEdit:hover {
    border-color: @BORDER_STRONG@;
}

/* QLineEdit 聚焦�?�?主色边框 + 光晕近似 */
QLineEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
    background-color: @BG_CARD@;
}

/* QLineEdit 禁用�?*/
QLineEdit:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QLineEdit 只读�?*/
QLineEdit:read-only {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border-color: @BORDER@;
}

/* QLineEdit 占位符文�?*/
/* 注：Qt QSS 不支持属性选择�?`[attr!=""]`，该写法会导致整份样式表解析失败�?
   故移除。Qt 亦无 QSS 原生的占位符伪状态，占位符颜色交由控件内代码处理�?*/

/* QTextEdit 多行文本�?�?默认�?*/
QTextEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QTextEdit:hover {
    border-color: @BORDER_STRONG@;
}

QTextEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
}

QTextEdit:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QPlainTextEdit 纯文本编辑框 */
QPlainTextEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QPlainTextEdit:hover {
    border-color: @BORDER_STRONG@;
}

QPlainTextEdit:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 7px 11px;
}

/* QComboBox 下拉选择�?�?默认�?*/
QComboBox {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 32px 6px 12px;
    font-size: 13px;
    min-height: 20px;
}

/* QComboBox 悬停�?*/
QComboBox:hover {
    border-color: @BORDER_STRONG@;
}

/* QComboBox 聚焦�?�?主色边框 */
QComboBox:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 5px 31px 5px 11px;
}

/* QComboBox 禁用�?*/
QComboBox:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QComboBox 下拉按钮 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: transparent;
}

QComboBox::drop-down:hover {
    background-color: @BG_HOVER@;
}

/* QComboBox 下拉箭头 */
QComboBox::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 8px;
    border: none;
}

QComboBox::down-arrow:hover {
    border-top-color: @PRIMARY@;
}

/* QComboBox 下拉列表视图 */
QComboBox QAbstractItemView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 12px;
    border-radius: 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
}

/* QSpinBox 数字输入�?�?默认�?*/
QSpinBox {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px 32px 6px 12px;
    font-size: 13px;
    min-height: 20px;
}

QSpinBox:hover {
    border-color: @BORDER_STRONG@;
}

QSpinBox:focus {
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 5px 31px 5px 11px;
}

QSpinBox:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* QSpinBox 上按�?*/
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 12px;
    background-color: transparent;
}

QSpinBox::up-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::up-button:pressed {
    background-color: @BG_PRESSED@;
}

/* QSpinBox 上箭�?*/
QSpinBox::up-arrow {
    width: 10px;
    height: 10px;
    background-color: @TEXT_TERTIARY@;
}

QSpinBox::up-button:hover > QSpinBox::up-arrow {
    background-color: @PRIMARY@;
}

/* QSpinBox 下按�?*/
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-bottom-right-radius: 12px;
    background-color: transparent;
}

QSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::down-button:pressed {
    background-color: @BG_PRESSED@;
}

/* QSpinBox 下箭�?*/
QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    background-color: @TEXT_TERTIARY@;
}

QSpinBox::down-button:hover > QSpinBox::down-arrow {
    background-color: @PRIMARY@;
}

/* QSlider 整体 �?清除 widget 背景 */
QSlider {
    background: transparent;
}

/* QSlider 滑块 �?凹槽 */
QSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?已填充部分（主色渐变�?*/
QSlider::sub-page:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 999px;
}

QSlider::sub-page:vertical {
    background-color: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?未填充部�?*/
QSlider::add-page:horizontal {
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider::add-page:vertical {
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

/* QSlider 滑块 �?手柄（主色实�?+ 柔和光晕�?*/
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -8px 0;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
}

QSlider::handle:vertical {
    width: 20px;
    height: 20px;
    margin: 0 -8px;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
}

QSlider::handle:horizontal:hover {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.65 @PRIMARY_HOVER@,
        stop:0.85 @PRIMARY_RGBA_51@,
        stop:1 @PRIMARY_RGBA_12@);
}

QSlider::handle:vertical:hover {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.65 @PRIMARY_HOVER@,
        stop:0.85 @PRIMARY_RGBA_51@,
        stop:1 @PRIMARY_RGBA_12@);
}

QSlider::handle:horizontal:pressed {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY_PRESSED@,
        stop:0.6 @PRIMARY_PRESSED@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
}

/* 线程数滑块定�?*/
QSlider#threadCountSlider::groove:horizontal {
    height: 8px;
}

QSlider#threadCountSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
}

/* 内存滑块定制 */
QSlider#memorySlider::groove:horizontal {
    height: 8px;
}

QSlider#memorySlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
}

/* QCheckBox 复选框 �?文字部分 */
QCheckBox {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    spacing: 8px;
    padding: 2px;
}

QCheckBox:hover {
    color: @TEXT_PRIMARY@;
}

QCheckBox:disabled {
    color: @TEXT_DISABLED@;
}

/* QCheckBox 指示�?�?未选中态（圆角胶囊近似�?*/
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid @BORDER_HOVER@;
    background-color: @BG_CARD@;
}

QCheckBox::indicator:hover {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}

QCheckBox::indicator:disabled {
    border-color: @BORDER_DISABLED@;
    background-color: @BG_DISABLED@;
}

/* QCheckBox 指示�?�?选中态（主色渐变�?*/
QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 2px solid @PRIMARY_DARK@;
    border-radius: 6px;
}

QCheckBox::indicator:checked:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
    border: 2px solid @PRIMARY@;
}

/* QCheckBox 三态指示器 */
QCheckBox::indicator:indeterminate {
    background-color: @PRIMARY_BG@;
    border: 2px solid @PRIMARY@;
    border-radius: 6px;
}

/* QRadioButton 单选按钮 - 现代化样式
   注意：Qt 对 ::indicator 的 border-radius 只认像素值，写 999px 会被忽略导致圆点变方框，
   这里按「内容尺寸 16px + 2px 边框 = 20px 外径」把半径固定为 10px，保证是真圆。 */
QRadioButton {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    spacing: 10px;
    padding: 3px 6px;
    border-radius: 7px;
}

QRadioButton:hover {
    background-color: @PRIMARY_RGBA_10@;
}

/* 选中项整行带一层极淡主色，扫一眼就能看出当前选项 */
QRadioButton:checked {
    background-color: @PRIMARY_RGBA_12@;
}

QRadioButton:checked:hover {
    background-color: @PRIMARY_RGBA_18@;
}

QRadioButton:disabled {
    color: @TEXT_DISABLED@;
    background-color: transparent;
}

/* QRadioButton 指示器 - 默认未选中状态（20px 外径圆环） */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 10px;
    border: 2px solid @TEXT_TERTIARY@;
    background-color: @BG_CARD@;
    margin: 0;
}

/* 悬停状态 - 边框变为主色（只换颜色，不改粗细，避免尺寸跳动） */
QRadioButton::indicator:hover {
    border-color: @PRIMARY@;
}

/* 选中状态 - 主色圆环 + 居中实心圆点
   qradialgradient 必须显式写 fx/fy，否则焦点默认落在左上角、圆点会偏到角上。 */
QRadioButton::indicator:checked {
    border: 2px solid @PRIMARY@;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @PRIMARY@,
        stop:0.42 @PRIMARY@,
        stop:0.48 @BG_CARD@,
        stop:1 @BG_CARD@);
}

/* 选中悬停状态 - 圆环与圆点一起加深 */
QRadioButton::indicator:checked:hover {
    border-color: @PRIMARY_HOVER@;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @PRIMARY_HOVER@,
        stop:0.42 @PRIMARY_HOVER@,
        stop:0.48 @BG_CARD@,
        stop:1 @BG_CARD@);
}

/* 禁用状态 - 灰环灰点 */
QRadioButton::indicator:disabled {
    border-color: @BORDER_DISABLED@;
    background-color: @BG_DISABLED@;
}

QRadioButton::indicator:checked:disabled {
    border-color: @BORDER_DISABLED@;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @TEXT_DISABLED@,
        stop:0.42 @TEXT_DISABLED@,
        stop:0.48 @BG_DISABLED@,
        stop:1 @BG_DISABLED@);
}

/* 焦点状态：键盘 Tab 过来时文字与描边一起变主色 */
QRadioButton:focus {
    color: @ACCENT_TEXT@;
    background-color: @PRIMARY_RGBA_12@;
}

QRadioButton:focus::indicator {
    border-color: @PRIMARY@;
}

/* 伪态补�?*/
QSlider:focus::groove {
    border: 1px solid @PRIMARY@;
}

QSlider:disabled {
    color: @TEXT_DISABLED@;
}

QSlider:disabled::groove {
    background-color: transparent;
}

QSlider:disabled::handle:horizontal,
QSlider:disabled::handle:vertical {
    background-color: transparent;
}

QCheckBox::indicator:indeterminate {
    background-color: @PRIMARY_RGBA_18@;
    border: 1px solid @PRIMARY@;
}

QComboBox:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QComboBox:on {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: @BG_MUTED@;
}

QLineEdit:readonly {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
}

QLineEdit:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QTabBar::tab:pressed {
    background-color: @PRIMARY_RGBA_38@;
}

QToolButton:disabled {
    color: @TEXT_DISABLED@;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    padding-right: 4px;
}

QProgressBar:busy::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 999px;
}

/* ============================================================
 * Section 10. 列表样式（QListWidget、QTreeWidget、QTableWidget�?
 * ============================================================ */
/* QListWidget 列表控件 */
QListWidget {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 8px 12px;
    border-radius: 8px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
}

QListWidget::item:selected:!active {
    background-color: @PRIMARY_RGBA_12@;
    color: @TEXT_PRIMARY@;
}

QListWidget::item:disabled {
    color: @TEXT_DISABLED@;
}

/* QTreeWidget 树形控件 */
QTreeWidget, QTreeView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QTreeWidget::item, QTreeView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 8px;
    border-radius: 8px;
    min-height: 20px;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: @BG_HOVER@;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
}

QTreeWidget::item:selected:!active, QTreeView::item:selected:!active {
    background-color: @PRIMARY_RGBA_12@;
    color: @TEXT_PRIMARY@;
}

/* QTreeWidget 分支指示�?*/
QTreeWidget::branch:has-siblings:!adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:has-siblings:adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    background-color: transparent;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    background-color: transparent;
    border-image: none;
}

/* QTableWidget 表格控件 */
QTableWidget, QTableView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    gridline-color: @BORDER_LIGHT@;
    outline: none;
    font-size: 13px;
}

QTableWidget::item, QTableView::item {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    padding: 6px 10px;
    border: none;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: @BG_HOVER@;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
}

/* QTableWidget 表头 */
QHeaderView::section {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid @BORDER_LIGHT@;
    border-bottom: 1px solid @BORDER_LIGHT@;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QHeaderView::section:pressed {
    background-color: @BG_PRESSED@;
}

/* QTableWidget 角落按钮 */
QTableCornerButton::section {
    background-color: @BG_MUTED@;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    border-right: 1px solid @BORDER_LIGHT@;
}

/* ============================================================
 * Section 11. 容器样式（QGroupBox、QTabWidget、QScrollArea、QStackedWidget�?
 * ============================================================ */
/* QGroupBox 分组容器 */
QGroupBox {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    font-size: 14px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
}

/* QGroupBox 标题 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: @BG_BASE@;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

/* QTabWidget 选项卡容�?*/
QTabWidget::pane {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
}

/* QTabWidget 选项卡栏 */
QTabBar::tab {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    margin: 2px 1px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QTabBar::tab:selected {
    background-color: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

QTabBar::tab:selected:hover {
    background-color: @PRIMARY_RGBA_26@;
}

/* QTabBar 关闭按钮 */
QTabBar::close-button {
    image: none;
    subcontrol-position: right;
    border: none;
    border-radius: 4px;
    padding: 2px;
    background-color: transparent;
}

QTabBar::close-button:hover {
    background-color: @DANGER_BG@;
}

/* QScrollArea 滚动区域
 * 注意：此处不得声�?border/border-radius，否则所有未命名�?QScrollArea
 * （如 HomePage、SettingsPage 外层、ResourcesPage 等）
 * 会被一圈圆角灰边包围。需边框的滚动区�?#id 规则单独声明�?*/
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* QStackedWidget 堆栈窗口 */
QStackedWidget {
    background-color: transparent;
    border: none;
}

/* QFrame 通用框架 */
QFrame {
    background-color: transparent;
    border: none;
}

/* QProgressBar 进度�?*/
QProgressBar {
    background-color: @BG_TRACK@;
    color: @TEXT_PRIMARY@;
    border: none;
    border-radius: 999px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border-radius: 999px;
}

/* QProgressBar 大号进度�?*/
QProgressBar#largeProgressBar {
    min-height: 8px;
    max-height: 8px;
}

/* QProgressBar 卡片内进度条 */
QProgressBar#cardProgressBar {
    min-height: 4px;
    max-height: 4px;
}

/* ============================================================
 * Section 12. 对话框样式（QDialog、QMessageBox、QDialogButtonBox�?
 * ============================================================ */
/* QDialog 对话框容�?*/
QDialog {
    background-color: @BG_CARD@;
    border-radius: 16px;
}

/* QDialog 标签 */
QDialog QLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
}

/* QDialog 按钮 */
QDialog QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    min-width: 80px;
}

QDialog QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QDialog QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* QDialog 默认按钮（主操作�?*/
QDialog QPushButton#defaultButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

QDialog QPushButton#defaultButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QDialog QPushButton#defaultButton:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* QDialogButtonBox 按钮�?*/
QDialogButtonBox {
    background-color: transparent;
    border: none;
}

QDialogButtonBox QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    min-width: 80px;
}

QDialogButtonBox QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

/* QDialogButtonBox 确认按钮 */
QDialogButtonBox QPushButton[text="OK"],
QDialogButtonBox QPushButton[text="确定"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

/* QMessageBox 消息�?*/
QMessageBox {
    background-color: @BG_CARD@;
    border-radius: 16px;
}

QMessageBox QLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    min-width: 280px;
}

QMessageBox QPushButton {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 20px;
    font-size: 13px;
    min-width: 72px;
}

QMessageBox QPushButton:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QMessageBox QPushButton:pressed {
    background-color: @BG_PRESSED@;
}

/* QMessageBox 信息图标 */
QMessageBox QLabel#iconLabel {
    background-color: transparent;
    border: none;
}

/* ============================================================
 * Section 13. 卡片体系样式（cardRole="container"/"icon"/"cover"/"iconOverlay"/"name"/"chip"/"actionBtn"/"favBtn"�?
 * ============================================================ */
/* 卡片容器 �?玻璃态近�?+ hover 上浮 */
QWidget[cardRole="container"] {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 12px;
}

/* 卡片容器 �?悬停态（背景提亮 + 边框泛主色；不使用负 margin，负 margin 会被 Qt 裁切导致卡片上移残缺�?*/
QWidget[cardRole="container"]:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 卡片图标 �?圆角方块�?*/
QLabel[cardRole="icon"] {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 卡片封面�?�?统一圆角 */
QLabel[cardRole="cover"] {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 12px;
    min-height: 80px;
}

/* 卡片图标叠加�?*/
QLabel[cardRole="iconOverlay"] {
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    padding: 8px;
}

/* 卡片标题（无边框） */
QLabel[cardRole="name"] {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 卡片英文�?*/
QLabel[cardRole="nameEnglish"] {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 400;
    border: none;
    padding: 0;
}

/* 卡片信息芯片（无边框胶囊，仅用淡主色底）
   注意：radius 必须不超过芯片高度一半，Qt QSS 不会像 CSS 那样
   自动收敛超大半径，999px 会被忽略渲染成直角 */
QLabel[cardRole="chip"] {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片描述文本 */
QLabel[cardRole="description"] {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    border: none;
    padding: 0;
}

/* 卡片下载�?*/
QLabel[cardRole="downloadCount"] {
    background-color: @BG_MUTED@;
    color: @TEXT_TERTIARY@;
    border: none;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片版本标签（无边框胶囊） */
QLabel[cardRole="version"] {
    background-color: @INFO_BG@;
    color: @INFO@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片标签（无边框胶囊） */
QLabel[cardRole="tag"] {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

/* 卡片操作按钮 �?图标式圆�?*/
QPushButton[cardRole="actionBtn"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton[cardRole="actionBtn"]:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton[cardRole="actionBtn"]:pressed {
    background-color: @BG_PRESSED@;
}

/* 卡片收藏按钮 �?主色圆角 */
QPushButton[cardRole="favBtn"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton[cardRole="favBtn"]:hover {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
}

QPushButton[cardRole="favBtn"]:pressed {
    background-color: @BG_PRESSED@;
}

/* 瀑布流内容卡片（contentCard：首页最近游�?/ 实例选择 / 模组瀑布流等�?
   banner 在代码中已内�?1px，边框不会被封面盖住，可安全�?1px 描边 */
QWidget#contentCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QWidget#contentCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 16px;
}

/* 实例选择页瀑布流卡片：无鼠标悬浮效果 */
QWidget#contentCard[flatCard="true"],
QWidget#contentCard[flatCard="true"]:hover {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 瀑布流内容卡片操作按�?�?图标式圆�?*/
QPushButton#contentCardActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#contentCardActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#contentCardActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 性能卡片进度�?*/
QProgressBar#perfProgressBar {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 999px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#perfProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border-radius: 999px;
}

/* ============================================================
 * 首页最近游玩卡片（recentPlay* 专属样式）
 * 不与 contentCard / modCard 系列共用，观感可独立调整
 * ============================================================ */
/* ── 卡片（与好友 / 热门帖卡片同宽，一栏只摆一行） ── */
QWidget#recentPlayCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 0;
}

QWidget#recentPlayCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 16px;
}

/* 卡片名称 */
QLabel#recentPlayName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 卡片最近游玩时间行 */
QLabel#recentPlayTime {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
    padding: 0;
}

/* 卡片操作按钮（更多） */
QPushButton#recentPlayActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 5px;
    color: @TEXT_TERTIARY@;
}

QPushButton#recentPlayActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#recentPlayActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 固定按钮的固定态（主色浅底强调，提示已固定在最近游玩区域） */
QPushButton#recentPlayActionBtnPinned {
    background-color: @PRIMARY_RGBA_30@;
    border: none;
    border-radius: 8px;
    padding: 5px;
}

QPushButton#recentPlayActionBtnPinned:hover {
    background-color: @PRIMARY_RGBA_40@;
}

QPushButton#recentPlayActionBtnPinned:pressed {
    background-color: @PRIMARY_RGBA_51@;
}

/* 卡片启动按钮（主色填充圆角，图标 + 文字）
 * 注意：Qt 对超过控件高度一半的圆角不做过 clamp，而是直接跳过圆角渲染
 * （同 overviewLaunchBtn 的注释）。按钮 min-height 22px，故半角为 11px。 */
QPushButton#recentPlayLaunchBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 11px;
    min-height: 22px;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#recentPlayLaunchBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#recentPlayLaunchBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

/* 网站推荐卡片 */
QWidget#websiteCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px 16px;
}

QWidget#websiteCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    margin: 0 2px 0 -2px;
}

/* 网站卡片名称 */
QLabel#websiteName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 网站卡片描述 */
QLabel#websiteUrl {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* ============================================================
 * Section 14. 任务栏样式（taskScrollArea、launchTaskCard、downloadTaskCard、aggregateTaskCard�?
 * ============================================================ */
/* 任务栏滚动区�?*/
QScrollArea#taskScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#taskScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 启动任务卡片 �?玻璃态近�?*/
/* 卡片外观（玻璃卡面 / 状态徽章 / 底部进度轨）由 paintEvent 自绘，
 * 这里只声明对象名，不写 padding 与 border，避免样式表改变布局几何 */
QWidget#launchTaskCard,
QWidget#downloadTaskCard,
QWidget#aggregateTaskCard {
    background-color: transparent;
    border: none;
}

QWidget#launchTaskCard:hover,
QWidget#downloadTaskCard:hover,
QWidget#aggregateTaskCard:hover {
    background-color: transparent;
}

/* 启动任务卡片状态文�?*/
QWidget#launchTaskCard QLabel#statusTextLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 启动任务卡片消息文本 */
QWidget#launchTaskCard QLabel#messageLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
}

/* 启动任务卡片进度文本 */
QWidget#launchTaskCard QLabel#progressLabel {
    background-color: transparent;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片 �?玻璃态近�?*/

/* 下载任务卡片实例�?*/
QWidget#downloadTaskCard QLabel#instanceNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片状态文�?*/
QWidget#downloadTaskCard QLabel#statusTextLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片进度文本 */
QWidget#downloadTaskCard QLabel#progressLabel {
    background-color: transparent;
    color: @INFO@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 下载任务卡片速度文本 */
QWidget#downloadTaskCard QLabel#speedLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片加载器文�?*/
QWidget#downloadTaskCard QLabel#loadersLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片步骤文本 */
QWidget#downloadTaskCard QLabel#stepLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 下载任务卡片大小文本 */
QWidget#downloadTaskCard QLabel#sizeLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 聚合任务卡片 �?玻璃态近�?*/
QWidget#aggregateTaskCard {
    background-color: transparent;
    border: none;
}

QWidget#aggregateTaskCard:hover {
    background-color: transparent;
}

/* 聚合任务卡片图标 */
QLabel#aggregateTaskIconLabel {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 16px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}

/* 聚合任务卡片名称 */
QLabel#aggregateTaskNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 聚合任务卡片计数 */
QLabel#aggregateTaskCountLabel {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 任务栏查看全部按�?*/
QPushButton#viewAllTaskBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#viewAllTaskBtn:hover {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border-color: @PRIMARY_RGBA_38@;
}

QPushButton#viewAllTaskBtn:pressed {
    background-color: @PRIMARY_RGBA_20@;
}

/* 下载任务卡片取消按钮 */
QPushButton#cancelDownloadBtn {
    background-color: transparent;
    border: none;
    border-radius: 999px;
    padding: 4px;
    color: @TEXT_TERTIARY@;
    min-width: 24px;
    min-height: 24px;
}

QPushButton#cancelDownloadBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

/* ============================================================
 * Section 15. 滚动条样式（QScrollBar:vertical、QScrollBar:horizontal�?
 * ============================================================ */
/* 垂直滚动条：窄轨�?+ 圆角半透明滑块 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.18@;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.32@;
}

QScrollBar::handle:vertical:pressed {
    background: @PRIMARY@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条：与垂直对�?*/
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background: @BLACK_RGBA_0.18@;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: @BLACK_RGBA_0.32@;
}

QScrollBar::handle:horizontal:pressed {
    background: @PRIMARY@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::corner {
    background: transparent;
    border: none;
}

QScrollBar:disabled {
    background: transparent;
}

QScrollBar:disabled::handle:vertical,
QScrollBar:disabled::handle:horizontal {
    background: @BG_MUTED@;
}

/* ============================================================
 * Section 16. 菜单与提示样式（QMenu、QToolTip、QStatusBar�?
 * ============================================================ */
/* QMenu：圆角卡片容�?+ 圆角菜单�?+ 主色高亮 */
QMenu {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 9px 26px;
    border-radius: 8px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QMenu::separator {
    height: 1px;
    background: @BORDER_LIGHT@;
    margin: 4px 10px;
}

QMenu::icon {
    width: 16px;
    margin-left: 4px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* QToolTip：圆角浮�?+ 主文字色 + 细边�?*/
QToolTip {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* QStatusBar：底部状态栏 + 顶部细分割线 */
QStatusBar {
    background: @BG_CARD@;
    border-top: 1px solid @BORDER_LIGHT@;
    padding: 4px 12px;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background: transparent;
    color: @TEXT_TERTIARY@;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: @BORDER_LIGHT@;
    margin: 4px 8px;
}

/* ============================================================
 * Section 17. 页面专属样式（HomePage 轮播、AiChatPage、SkinEditorPage 等）
 * ============================================================ */
/* --- 17.1 HomePage 轮播（参考原�?.carousel�?--- */
QWidget#carouselWidget {
    background: @BG_PRESSED@;
    border: 1px solid @BORDER@;
    border-radius: 22px;
    overflow: hidden;
}

/* 首页轮播空态：预设封面还没下载、也没导入自己图片时的引导卡 */
QWidget#carouselEmpty {
    background: @BG_BASE@;
    border-radius: 16px;
    border: 2px dashed @BORDER_STRONG@;
}

QLabel#carouselEmptyIcon,
QLabel#carouselEmptyTitle,
QLabel#carouselEmptyDesc,
QLabel#carouselEmptyProgress {
    background: transparent;
    border: none;
}

QLabel#carouselEmptyTitle {
    font-size: 16px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
}

QLabel#carouselEmptyDesc {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
}

QLabel#carouselEmptyProgress {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#carouselEmptyPrimary {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: 1px solid @PRIMARY@;
    border-radius: 18px;
    padding: 0 22px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#carouselEmptyPrimary:hover {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

QPushButton#carouselEmptyPrimary:disabled {
    background-color: @BG_MUTED@;
    border-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QPushButton#carouselEmptyGhost {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 18px;
    padding: 0 22px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#carouselEmptyGhost:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 首页轮播右侧皮肤面板：无账户时的「添加首个账户」空态按钮 */
QPushButton#homeSkinAddBtn {
    background-color: transparent;
    border: none;
    border-radius: 16px;
}
QPushButton#homeSkinAddBtn:hover {
    background-color: @BG_HOVER@;
}

/* 首页好友栏（最近游玩下面一栏）：在线数 / 好友卡片 / 开房置顶的「一起玩」按钮 */
QLabel#homeFriendsCount {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

QWidget#homeFriendsListHost,
QWidget#homeFriendsState {
    background: transparent;
    border: none;
}

QFrame#homeFriendCard {
    background-color: @BG_PRESSED@;
    border: 1px solid transparent;
    border-radius: 10px;
}

QFrame#homeFriendCard:hover {
    background-color: @BG_HOVER@;
}

QFrame#homeFriendCard[roomActive="true"] {
    background-color: @PRIMARY_RGBA_12@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#homeFriendOnlineDot {
    background-color: @TEXT_TERTIARY@;
    border-radius: 3px;
}

QLabel#homeFriendOnlineDot[online="true"] {
    background-color: @SUCCESS@;
}

QLabel#homeFriendName {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

QLabel#homeFriendStatus {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    border: none;
}

QLabel#homeFriendStatus[roomActive="true"] {
    color: @ACCENT_TEXT@;
}

QPushButton#homeFriendPlayBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 13px;
    padding: 0 9px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#homeFriendPlayBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#homeFriendPlayBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QLabel#homeFriendsStateText {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

QPushButton#homeFriendsStateBtn {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: none;
    border-radius: 15px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#homeFriendsStateBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
}

/* 首页论坛热门帖栏（好友栏下面一栏）：帖子卡片（标题 + 板块 / 回复 / 时间） */
QWidget#homeHotThreadsListHost,
QWidget#homeHotThreadsState {
    background: transparent;
    border: none;
}

QFrame#homeHotThreadCard {
    background-color: @BG_PRESSED@;
    border: 1px solid transparent;
    border-radius: 10px;
}

QFrame#homeHotThreadCard:hover {
    background-color: @BG_HOVER@;
}

QLabel#homeHotThreadTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

QLabel#homeHotThreadBoard {
    background: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 10px;
}

QLabel#homeHotThreadMeta {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    border: none;
}

QLabel#carouselTag {
    background: @WHITE_RGBA_30@;
    color: @TEXT_ON_PRIMARY@;
    border-radius: 9px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#carouselTitle {
    font-size: 32px;
    font-weight: 800;
    color: @TEXT_ON_PRIMARY@;
}

QLabel#carouselDesc {
    font-size: 14px;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#carouselCtaBtn {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: none;
    border-radius: 999px;
    padding: 0 20px;
    min-height: 38px;
    max-height: 38px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#carouselCtaBtn:hover {
    background: @BG_HOVER@;
}

/* 首页轮播指示点：浮在封面图之上，与皮肤面板底部模式切换条同一水平位置 */
QWidget#carouselDotsPill {
    background: rgba(0, 0, 0, 0.28);
    border-radius: 8px;
}

QPushButton#carouselDot {
    background: rgba(255, 255, 255, 0.55);
    border: none;
    border-radius: 3px;
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    margin: 0;
}

QPushButton#carouselDot:hover {
    background: rgba(255, 255, 255, 0.9);
}

QPushButton#carouselDot[active="true"] {
    background: #ffffff;
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    border-radius: 3px;
}

/* 设置 → 界面设置 → 首页轮播图：已添加图片的缩略图（点击可移除） */
QToolButton#carouselThumb {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0;
}

QToolButton#carouselThumb:hover {
    border: 1px solid @PRIMARY@;
}

/* 首页公告栏（封面图 + 皮肤模型下方）：文字来自官网 announcement.json */
QWidget#homeAnnouncementBar {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QWidget#homeAnnounceBadge {
    background: @PRIMARY_BG@;
    border-radius: 8px;
}

QLabel#homeAnnounceBadgeText {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 11px;
    font-weight: 700;
}

QLabel#homeAnnounceText {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QLabel#homeAnnounceText[hovered="true"] {
    color: @ACCENT_TEXT@;
}

QLabel#homeAnnouncePage {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QPushButton#homeAnnounceNav {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

QPushButton#homeAnnounceNav:hover {
    background: @BG_HOVER@;
}

QPushButton#carouselArrowBtn {
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    border-radius: 999px;
    background: @BLACK_RGBA_64@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
}

QPushButton#carouselArrowBtn:hover {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
}

QLabel#quickLinkIcon {
    background: transparent;
    border: none;
}

QLabel#quickLinkLabel {
    font-size: 13px;
    font-weight: 500;
    color: @TEXT_SECONDARY@;
}

QWidget#quickLinkCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#quickLinkCard:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* --- 17.2 AiChatPage AI 对话页（玻璃态近似：半透明背景 + 细边框） --- */
QWidget#aiChatTopBar {
    background: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QLabel#aiChatStatusDot {
    background: #94A3B8;
    border-radius: 4px;
}

QLabel#aiChatConvTitle {
    font-size: 15px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    letter-spacing: 0.1px;
}

/* 左侧对话�?�?�?SubNavPanel 一致的子导航样�?*/
QFrame#aiChatLeftPanel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QFrame#aiChatLeftPanel > QWidget {
    background: transparent;
}

/* 面板头部（模式切�?+ 收起按钮）�?�?SubNavPanel 头部一�?*/
QWidget#subNavHeader {
    background: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* 模式切换 �?轨道 + 滑动滑块（与 HTML 一致） */
QWidget#aiChatModeBar {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 11px;
    padding: 0;
}

QPushButton#aiChatModeBtn {
    background: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    margin: 1px 2px;
}

QPushButton#aiChatModeBtn:hover {
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatModeBtn:checked {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-weight: 600;
}

QPushButton#aiChatModeBtn:checked:hover {
    color: @TEXT_PRIMARY@;
}

QWidget#aiChatModeIndicator {
    background-color: @BG_CARD@;
    border: none;
    border-radius: 8px;
}

QPushButton#aiChatNewConvBtn {
    background: transparent;
    border: 1px dashed @PRIMARY_RGBA_64@;
    border-radius: 10px;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    min-height: 40px;
}

QPushButton#aiChatNewConvBtn:hover {
    background: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
}

QPushButton#aiChatNewConvBtn:pressed {
    background: @PRIMARY_RGBA_38@;
}

/* 对话列表空提示 */
QLabel#aiChatConvEmptyHint {
    background: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    padding: 16px 12px;
}

QPushButton#aiChatToggleConvBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 0;
}

QPushButton#aiChatToggleConvBtn:hover {
    background: @BLACK_RGBA_0.06@;
}

QPushButton#aiChatToggleConvBtn:checked {
    background: @PRIMARY_RGBA_31@;
}

QScrollArea#aiChatConvScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#aiChatConvScrollArea > QWidget {
    background: transparent;
}

QScrollArea#aiChatConvScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#aiChatConvScrollArea QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#aiChatConvScrollArea QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#aiChatConvScrollArea QScrollBar::add-line:vertical,
QScrollArea#aiChatConvScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#aiChatConvScrollArea QScrollBar::add-page:vertical,
QScrollArea#aiChatConvScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 消息主栏跟随页面底色：经典模式下若自带 @BG_MSG@ 底色，会与页面其余区域
   （输入区、顶栏下的页面背景）形成色差，与其他页面也不一致。 */
QScrollArea#aiChatMessageArea {
    background: transparent;
    border: none;
}

QScrollArea#aiChatMessageArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#aiChatMessageArea QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#aiChatMessageArea QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#aiChatMessageArea QScrollBar::add-line:vertical,
QScrollArea#aiChatMessageArea QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#aiChatMessageArea QScrollBar::add-page:vertical,
QScrollArea#aiChatMessageArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#aiChatWelcomeWidget {
    background: transparent;
}

QLabel#aiChatWelcomeTitleLabel {
    font-size: 26px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
}

QLabel#aiChatWelcomeDescLabel {
    font-size: 14px;
    color: @TEXT_SECONDARY@;
    padding: 0 24px;
}

QWidget#aiChatWelcomeQuickBtns {
    background: transparent;
}

QPushButton#aiChatQuickBtn {
    background: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 500;
    min-width: 120px;
    max-width: 220px;
    /* 布局压缩时按钮可能只剩 ~21px 高，扣掉上下 padding 文字区为 0，
     * 表现为按钮上完全不绘制文字，故锁定最小高度 */
    min-height: 40px;
}

QPushButton#aiChatQuickBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#aiChatQuickBtn:pressed {
    background: @BG_PRESSED@;
}

QWidget#aiChatBubbleContainer {
    background: transparent;
}

QWidget#bubbleActionsWidget {
    background: transparent;
}

QFrame#aiChatUserBubble {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QFrame#aiChatUserBubble QLabel#msgContent {
    color: @TEXT_SECONDARY@;
    background: transparent;
    font-size: 14px;
}

QFrame#aiChatAiBubble {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QFrame#aiChatAiBubble QLabel#msgContent {
    color: @TEXT_PRIMARY@;
    background: transparent;
    font-size: 14px;
}

QFrame#aiChatAiBubble QLabel#msgContent a {
    color: @LINK@;
    text-decoration: none;
}

QFrame#aiChatAiBubble QLabel#msgContent code {
    background: @BG_MUTED@;
    color: @CODE_TEXT@;
    font-family: Consolas, "Courier New", monospace;
    padding: 1px 4px;
    border-radius: 4px;
}

QFrame#aiChatAiBubble QLabel#msgContent pre {
    background: @CODE_BG@;
    border: 1px solid @CODE_BORDER@;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 4px 0;
}

/* 流式期间的正文编辑器：只读增量追加，透明无边框，高度随内容增长 */
QTextEdit#streamMsgContent,
QTextEdit#streamMsgContent:hover,
QTextEdit#streamMsgContent:focus,
QTextEdit#streamMsgContent:disabled {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QLabel#aiChatStatsLabel {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
}

QPushButton#bubbleActionBtn {
    background: transparent;
    border: none;
    padding: 0;
}

QPushButton#bubbleActionBtn:hover {
    background: @BLACK_RGBA_0.06@;
    border-radius: 14px;
}

QPushButton#bubbleActionBtn[active="true"] {
    background: @LINK_RGBA_0.10@;
    border-radius: 14px;
}

/* AI 回答过程行（思考/搜索/工具调用）：一轮一行纯文字样式 */
QPushButton#thinkingHeaderRow {
    background: transparent;
    border: none;
    padding: 2px 0px;
    text-align: left;
}

QLabel#thinkingTitle {
    font-size: 12px;
    color: @WARNING_HOVER@;
    font-weight: 600;
    background: transparent;
}

QLabel#thinkingStatusText {
    font-size: 12px;
    background: transparent;
}

QLabel#thinkingStatusText[type="info"] {
    color: @WARNING@;
}

QLabel#thinkingStatusText[type="success"] {
    color: @SUCCESS@;
}

/* 思考收尾后状态文字改为思考用时，弱化为三级文字色 */
QLabel#thinkingStatusText[type="muted"] {
    color: @TEXT_TERTIARY@;
}

QLabel#thinkingPreview {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background: transparent;
}

QLabel#thinkingContent {
    font-size: 13px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

/* 流式期间的思考编辑器（收起态隐藏，展开后同样透明无边框） */
QTextEdit#thinkingStreamContent,
QTextEdit#thinkingStreamContent:hover,
QTextEdit#thinkingStreamContent:focus,
QTextEdit#thinkingStreamContent:disabled {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    font-size: 13px;
    color: @TEXT_SECONDARY@;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QWidget#aiChatInputPanel {
    background: transparent;
    border: none;
}

QFrame#aiChatInputBox {
    background: @BG_GLASS@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
}

QFrame#aiChatInputBox:hover {
    border: 1.5px solid @BORDER_STRONG@;
}

QFrame#aiChatInputBox[focused="true"] {
    border: 1.5px solid @PRIMARY@;
}

QTextEdit#aiChatInputEdit {
    background: transparent;
    border: none;
    padding: 6px 8px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QTextEdit#aiChatInputEdit:focus {
    border: none;
    background: transparent;
}

QPushButton#aiChatToolIconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    font-size: 14px;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatToolIconBtn:hover {
    background: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatToolIconBtn[active="true"] {
    background: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
}

QPushButton#aiChatWorkspaceBtn {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#aiChatWorkspaceBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatWorkspaceBtn[active="true"] {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_STRONG@;
}

QPushButton#aiChatSendBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 0;
}

QPushButton#aiChatSendBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#aiChatSendBtn:pressed {
    background: @PRIMARY_PRESSED@;
}

QPushButton#aiChatSendBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_TERTIARY@;
}

QPushButton#aiChatModelBtn {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}

QPushButton#aiChatModelBtn:hover {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_HOVER@;
}

QWidget#aiChatRefChipsWidget {
    background: transparent;
}

QWidget#aiChatBubbleRefChips {
    background: transparent;
    margin-top: 6px;
}

/* ── 待发送 / 已发送的游戏截图缩略图 ── */
QWidget#aiChatImageStrip {
    background: transparent;
}

QWidget#aiChatImageRow {
    background: transparent;
}

QWidget#aiChatBubbleImages {
    background: transparent;
}

QLabel#aiChatImageStripHint {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QLabel#aiChatImageStripHint[error="true"] {
    color: @DANGER_TEXT@;
}

QPushButton#aiChatImageChip {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0;
}

QPushButton#aiChatImageChip:hover {
    border: 1px solid @PRIMARY_LIGHT@;
}

QPushButton#aiChatImageChipClose {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 11px;
    padding: 0;
}

QPushButton#aiChatImageChipClose:hover {
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
}

/* 圆角取高度一半以内：Qt 对超出控件尺寸的 border-radius（999px）不钳制，
 * 会直接渲染成直角（见 contentViewSwitch 处说明，ref_chip_round_probe 实测）。
 * 标签高约 19-22px，取 8px 保证带/不带关闭按钮两种高度都出圆角 */
QFrame#aiChatRefChip {
    background: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_LIGHT@;
    border-radius: 8px;
}

QLabel#aiChatRefChipLabel {
    background: transparent;
    color: @TEXT_ACCENT@;
    font-size: 12px;
}

QPushButton#aiChatRefChipClose {
    background: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    font-size: 13px;
}

QPushButton#aiChatRefChipClose:hover {
    color: @DANGER_TEXT@;
}

QPushButton#refAddFileBtn {
    background: transparent;
    color: @ACCENT_TEXT@;
    border: 1.5px solid @PRIMARY_LIGHT@;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton#refAddFileBtn:hover {
    background: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
}

QTreeWidget#refTree {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QTreeWidget#refTree::item {
    padding: 4px 2px;
}

QTreeWidget#refTree::item:selected {
    background: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QTabWidget#refTabs::pane {
    border: 1px solid @BORDER@;
    border-radius: 12px;
    background-color: @BG_CARD@;
}

/* 引用资源弹窗 �?居中卡片（与其它内置弹窗一致） */
QWidget#referenceDialogCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 20px;
}

QWidget#refDialogTitleBar {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
    min-height: 40px;
    max-height: 40px;
}

QLabel#refDialogTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

/* 引用确定/取消按钮 */
QPushButton#refOkBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border: none;
    border-radius: 9px;
    padding: 7px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#refOkBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#refCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#refCancelBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 文件操作步骤弹窗 */
QWidget#fileOpDialogCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 20px;
}

QWidget#fileOpDialogTitleBar {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
    min-height: 40px;
    max-height: 40px;
}

QLabel#fileOpDialogTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

QLabel#fileOpHintLabel, QLabel#fileOpFilterLabel, QLabel#fileOpCountLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    border: none;
}

QLabel#fileOpEmptyHint {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
    padding: 24px;
}

QComboBox#fileOpSessionCombo, QComboBox#fileOpFilterCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    min-height: 22px;
}

QComboBox#fileOpSessionCombo:hover, QComboBox#fileOpFilterCombo:hover {
    border: 1px solid @BORDER_STRONG@;
}

QListWidget#fileOpStepList {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
}

QListWidget#fileOpStepList::item {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 12px;
}

QListWidget#fileOpStepList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#fileOpStepList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#fileOpCloseBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#fileOpCloseBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QTabBar#refTabs_tabbar::tab {
    background: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar#refTabs_tabbar::tab:selected {
    background: @BG_CARD@;
    color: @TEXT_ACCENT@;
    border-bottom: 2px solid @PRIMARY@;
    font-weight: 600;
}

QTabBar#refTabs_tabbar::tab:hover:!selected {
    background: @PRIMARY_BG@;
}

QLineEdit#refNetSearchEdit, QLineEdit#refWebUrlEdit, QLineEdit#refWebTitleEdit {
    background: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 13px;
}

QLineEdit#refNetSearchEdit:focus, QLineEdit#refWebUrlEdit:focus, QLineEdit#refWebTitleEdit:focus {
    border: 1.5px solid @PRIMARY@;
}

QPushButton#refNetSearchBtn, QPushButton#refWebAddBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 9px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#refNetSearchBtn:hover, QPushButton#refWebAddBtn:hover {
    background: @PRIMARY_DARK@;
}

QPushButton#refNetSearchBtn:disabled, QPushButton#refWebAddBtn:disabled {
    background: @PRIMARY_LIGHT@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#refWebFetchBtn {
    background: @BG_CARD@;
    color: @ACCENT_TEXT@;
    border: 1.5px solid @PRIMARY_LIGHT@;
    border-radius: 9px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#refWebFetchBtn:hover {
    background: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
}

/* ============================================================
 * Section 18. 共享卡片列表项样式（modCard* 系列，影�?12+ 页面�?
 * ============================================================ */
/* Mod 卡片列表�?�?玻璃态近�?+ hover 上浮 */
QWidget#modCardListItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#modCardListItem:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 安装新实例页 / 实例选择页：列表项卡片无鼠标悬浮效果 */
QWidget#modCardListItem[flatCard="true"],
QWidget#modCardListItem[flatCard="true"]:hover {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

/* Mod 卡片图标 — 主色渐变（圆角与 cardRole="icon" 统一为 12px） */
QLabel#modCardIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 700;
    font-size: 16px;
}

/* Mod 卡片名称（无边框，与下方描述/芯片左对齐） */
QLabel#modCardName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* Mod 卡片英文�?*/
QLabel#modCardEnglishName {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* Mod 信息芯片（无边框胶囊，仅用淡主色底） */
QLabel#modChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* Mod 更新芯片（无边框胶囊） */
QLabel#modUpdateChip {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 瀑布流内容芯片（无边框胶囊） */
QLabel#contentChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 实例分类芯片（列表卡片 / 瀑布流卡片，无边框胶囊） */
QLabel#modChip[categoryChip="true"],
QLabel#contentChip[categoryChip="true"] {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 瀑布流卡片名称（无边框，主题令牌取色，深浅色主题通用） */
QLabel#contentCardName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
    padding: 0;
}

/* 瀑布流卡片描述 / meta 行 */
QLabel#contentCardDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    padding: 0;
}

/* ── 视图切换分段控件（列表 / 瀑布流） ── */
/* 轨道底色与卡片区分，hover/pressed 令牌在三套主题下均与轨道有对比 */
/* 圆角取高度一半：Qt 对超出控件尺寸的 border-radius（如 999px）不做钳制，
 * 会直接渲染成直角（探针 view_switch_probe 实测），16/13 才是胶囊 */
QWidget#contentViewSwitch {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QPushButton#contentViewSwitchBtn {
    background-color: transparent;
    border: none;
    border-radius: 13px;
    color: @TEXT_PRIMARY@;
}

QPushButton#contentViewSwitchBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#contentViewSwitchBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 选中段：主色实心药丸（图标反白见 ContentViewSwitch::updateButtons；
 * 文本段（SourceSwitchBar 来源切换）反白由 color 保证） */
QPushButton#contentViewSwitchBtn[active="true"] {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#contentViewSwitchBtn[active="true"]:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#contentViewSwitchBtn[active="true"]:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* ── 在线资源顶栏「筛选」按钮（视图切换左侧，弹分类筛选弹窗） ── */
QPushButton#contentFilterBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 0 14px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#contentFilterBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#contentFilterBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 命中筛选：主色描边 + 计数文字，一眼看出列表正被筛过 */
QPushButton#contentFilterBtn[active="true"] {
    background-color: @PRIMARY_RGBA_12@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

QPushButton#contentFilterBtn[active="true"]:hover {
    background-color: @PRIMARY_RGBA_20@;
}

/* 分类筛选弹窗（在线资源下载页） */
QLabel#categoryFilterColumnTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

QListWidget#categoryFilterList {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget#categoryFilterList::item {
    padding: 6px 10px;
    border-radius: 8px;
    margin: 1px 0;
}

/* Mod 卡片操作按钮 */
QPushButton#modCardActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#modCardActionBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

QPushButton#modCardActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* ============================================================
 * Section 19. 共享列表页组件样式（modBottomBar、filterLabel、modSearchEdit 等）
 * ============================================================ */
/* 底部操作栏 —— 微透明玻璃态卡片（实例管理本地资源各页共用） */
QWidget#modBottomBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 基岩资源页底部操作栏 —— 同款玻璃态卡片 */
QWidget#bedrockResBottomBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 底部操作栏操作按�?*/
QPushButton#bottomActionBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#bottomActionBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#bottomActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#bottomActionBtn:checked {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* 分类管理按钮（实例模组筛选栏�?*/
QPushButton#categoryManageBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#categoryManageBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#categoryManageBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 筛选栏标签 */
QLabel#filterLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

QLabel#searchHintLabel {
    background-color: transparent;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    border: none;
}

/* 筛选栏下拉�?�?全应用统一筛选框样式
 * 覆盖：内容列�?/ 模组下载 / 详情页版本筛�?/ 搜索页排�?/ 实例模组筛�?
 *       （filterCombo / sortCombo / sourceCombo / instanceCombo /
 *         modDetailCombo / searchSortCombo / categoryCombo�?*/
QComboBox#filterCombo,
QComboBox#sortCombo,
QComboBox#sourceCombo,
QComboBox#instanceCombo,
QComboBox#modDetailCombo,
QComboBox#searchSortCombo,
QComboBox#categoryCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    min-height: 22px;
}

QComboBox#filterCombo:hover,
QComboBox#sortCombo:hover,
QComboBox#sourceCombo:hover,
QComboBox#instanceCombo:hover,
QComboBox#modDetailCombo:hover,
QComboBox#searchSortCombo:hover,
QComboBox#categoryCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

QComboBox#filterCombo:focus,
QComboBox#sortCombo:focus,
QComboBox#sourceCombo:focus,
QComboBox#instanceCombo:focus,
QComboBox#modDetailCombo:focus,
QComboBox#searchSortCombo:focus,
QComboBox#categoryCombo:focus {
    border: 1.5px solid @PRIMARY@;
}

QComboBox#filterCombo::drop-down,
QComboBox#sortCombo::drop-down,
QComboBox#sourceCombo::drop-down,
QComboBox#instanceCombo::drop-down,
QComboBox#modDetailCombo::drop-down,
QComboBox#searchSortCombo::drop-down,
QComboBox#categoryCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#filterCombo::down-arrow,
QComboBox#sortCombo::down-arrow,
QComboBox#sourceCombo::down-arrow,
QComboBox#instanceCombo::down-arrow,
QComboBox#modDetailCombo::down-arrow,
QComboBox#searchSortCombo::down-arrow,
QComboBox#categoryCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 8px;
    border: none;
    margin-right: 8px;
}

QComboBox#filterCombo QAbstractItemView,
QComboBox#sortCombo QAbstractItemView,
QComboBox#sourceCombo QAbstractItemView,
QComboBox#instanceCombo QAbstractItemView,
QComboBox#modDetailCombo QAbstractItemView,
QComboBox#searchSortCombo QAbstractItemView,
QComboBox#categoryCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
}

QComboBox#filterCombo QAbstractItemView::item,
QComboBox#sortCombo QAbstractItemView::item,
QComboBox#sourceCombo QAbstractItemView::item,
QComboBox#instanceCombo QAbstractItemView::item,
QComboBox#modDetailCombo QAbstractItemView::item,
QComboBox#searchSortCombo QAbstractItemView::item,
QComboBox#categoryCombo QAbstractItemView::item {
    padding: 6px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    border-radius: 4px;
}

QComboBox#filterCombo QAbstractItemView::item:hover,
QComboBox#sortCombo QAbstractItemView::item:hover,
QComboBox#sourceCombo QAbstractItemView::item:hover,
QComboBox#instanceCombo QAbstractItemView::item:hover,
QComboBox#modDetailCombo QAbstractItemView::item:hover,
QComboBox#searchSortCombo QAbstractItemView::item:hover,
QComboBox#categoryCombo QAbstractItemView::item:hover {
    background-color: @BG_MUTED@;
}

QComboBox#filterCombo QAbstractItemView::item:selected,
QComboBox#sortCombo QAbstractItemView::item:selected,
QComboBox#sourceCombo QAbstractItemView::item:selected,
QComboBox#instanceCombo QAbstractItemView::item:selected,
QComboBox#modDetailCombo QAbstractItemView::item:selected,
QComboBox#searchSortCombo QAbstractItemView::item:selected,
QComboBox#categoryCombo QAbstractItemView::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* 搜索输入�?*/
QLineEdit#modSearchEdit {
    background-color: @BG_CARD@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 8px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#modSearchEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLineEdit#modSearchEdit:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 搜索按钮 */
QPushButton#modSearchBtn,
QPushButton#downloadSearchBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 7px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modSearchBtn:hover,
QPushButton#downloadSearchBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modSearchBtn:pressed,
QPushButton#downloadSearchBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 本地资源页空状态「快速安装对应模组」按钮（光影包 / 投影 / 录像） */
QPushButton#quickInstallBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#quickInstallBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#quickInstallBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 空状态占位提�?*/
QLabel#modPlaceholderLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
    padding: 48px 24px;
}

/* 拖入模式按钮 */
QPushButton#dragModeBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: @TEXT_PRIMARY@;
}

QPushButton#dragModeBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#dragModeBtn:pressed {
    background-color: @PRIMARY_RGBA_20@;
}

/* 拖入区域 */
QWidget#dropZone {
    background-color: transparent;
    border: 2px dashed @BORDER_STRONG@;
    border-radius: 12px;
    min-height: 200px;
}

QWidget#dropZone:hover {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_RGBA_8@;
}

/* 拖入区域图标 */
QLabel#dropZoneIcon {
    background-color: transparent;
    border: none;
}

/* 拖入区域提示文字 */
QLabel#dropZoneHint {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 600;
    border: none;
}

/* 拖入区域补充提示 */
QLabel#dropZoneSubHint {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 拖入状态标签 */
QLabel#dropStatusLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 500;
    border: none;
    padding: 12px;
}

/* 分页�?*/
QWidget#modPaginationBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 分页页码按钮 */
QPushButton#modPageBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    min-width: 32px;
}

QPushButton#modPageBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#modPageBtn:checked {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#modPageBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 分页当前页标�?*/
QLabel#modPageLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
    padding: 0 8px;
}

/* ============================================================
 * Section 20. 统一对话框组件样式（appDialog*、appMsgBox* 系列�?
 * ============================================================ */
/* 对话框卡片容�?*/
QWidget#appDialogCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 对话框标�?*/
QLabel#appDialogTitleLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 18px;
    font-weight: 700;
    border: none;
    padding: 4px 0;
}

/* 对话框提示文�?*/
QLabel#appDialogPromptLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 所属关系弹窗：标题图标 */
QLabel#relationHeaderIcon {
    background-color: @PRIMARY_RGBA_12@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 12px;
}

/* 所属关系弹窗底部统计行 */
QLabel#relationSummaryLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

QLabel#relationCurrentLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

/* 统计胶囊：前置数量 / 缺失 / 建议 / 被依赖 */
QLabel#relationStatChip,
QLabel#relationStatChipDanger,
QLabel#relationStatChipWarn,
QLabel#relationStatChipAccent {
    border-radius: 9px;
    padding: 0 9px;
    font-size: 12px;
    min-height: 19px;
    max-height: 19px;
}

QLabel#relationStatChip {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    color: @TEXT_SECONDARY@;
}

QLabel#relationStatChipDanger {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

QLabel#relationStatChipWarn {
    background-color: @WARNING_BG@;
    border: 1px solid @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#relationStatChipAccent {
    background-color: @PRIMARY_RGBA_12@;
    border: 1px solid @PRIMARY_RGBA_26@;
    color: @TEXT_ACCENT@;
}

/* 所属关系弹窗分隔线 */
QFrame#relationDivider {
    background-color: @BORDER@;
    border: none;
}

/* 所属关系弹窗左侧模组列表 / 右侧依赖树：行高与行背景都由自绘委托负责，
 * 这里只保留容器外观，并清掉全局 ::item 的底色避免与自绘叠色 */
QListWidget#relationModList,
QTreeWidget#relationTree {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
}

QListWidget#relationModList::item,
QListWidget#relationModList::item:hover,
QListWidget#relationModList::item:selected {
    background-color: transparent;
    border: none;
    padding: 0;
}

QTreeWidget#relationTree::item,
QTreeWidget#relationTree::item:hover,
QTreeWidget#relationTree::item:selected {
    background-color: transparent;
    border: none;
}

QTreeWidget#relationTree::branch {
    background-color: transparent;
}

QTreeWidget#relationTree QHeaderView::section {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    border-bottom: 1px solid @BORDER@;
    padding: 0 8px 7px 8px;
    font-size: 12px;
    font-weight: 600;
}

QTreeWidget#relationTree QHeaderView::section:hover {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
}

/* 对话框输入框 */
QLineEdit#appDialogLineEdit {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#appDialogLineEdit:focus {
    border: 2px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLineEdit#appDialogLineEdit:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 对话框下拉框 */
QComboBox#appDialogComboBox {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QComboBox#appDialogComboBox:focus {
    border: 2px solid @PRIMARY@;
}

/* 对话框数字框 */
QSpinBox#appDialogSpin {
    background-color: @BG_MUTED@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QSpinBox#appDialogSpin:focus {
    border: 2px solid @PRIMARY@;
}

/* 对话框次按钮 */
QPushButton#appDialogBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 8px 22px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#appDialogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#appDialogBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 对话框主按钮 */
QPushButton#appDialogBtnPrimary {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 8px 22px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#appDialogBtnPrimary:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#appDialogBtnPrimary:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#appDialogBtnPrimary:disabled {
    background-color: @PRIMARY_LIGHT@;
    color: @TEXT_ON_PRIMARY@;
}

/* 对话框图标按�?*/
QPushButton#appDialogIconBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#appDialogIconBtn:hover {
    background-color: @BG_HOVER@;
    color: @ACCENT_TEXT@;
}

/* 对话框文件列�?*/
QListWidget#appFileList {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget#appFileList::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: @TEXT_PRIMARY@;
}

QListWidget#appFileList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#appFileList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

/* 对话框颜色预�?*/
QLabel#appColorPreview {
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    min-width: 60px;
    min-height: 30px;
}

/* 对话框颜色滑�?*/
QSlider#appColorSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider#appColorSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
}

QSlider#appColorSlider::handle:horizontal {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    margin: -8px 0;
}

/* 消息框卡�?*/
QWidget#appMsgBoxCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 消息框图�?*/
QLabel#appMsgBoxIconLabel {
    background-color: transparent;
    border: none;
    border-radius: 20px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
}

/* 消息框标�?*/
QLabel#appMsgBoxTitleLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    border: none;
}

/* 消息框详�?*/
QLabel#appMsgBoxTextLabel {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
}

/* 消息框信息图�?�?主色 */
QLabel#appMsgBoxIconLabel[type="info"] {
    background-color: @INFO@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框警告图�?�?警告�?*/
QLabel#appMsgBoxIconLabel[type="warning"] {
    background-color: @WARNING@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框错误图�?�?危险�?*/
QLabel#appMsgBoxIconLabel[type="error"] {
    background-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框成功图�?�?主色 */
QLabel#appMsgBoxIconLabel[type="success"] {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框问题图�?�?链接�?*/
QLabel#appMsgBoxIconLabel[type="question"] {
    background-color: @LINK@;
    color: @TEXT_ON_PRIMARY@;
}

/* 消息框补充信息文�?�?13px 三级�?*/
QLabel#appMsgBoxInformativeLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
    margin-top: 8px;
}

/* 消息框按钮行 �?横向布局 */
QWidget#appMsgBoxButtonRow {
    background-color: transparent;
    spacing: 8px;
}

/* 消息框按�?�?镜像 appDialogBtn */
QPushButton#appMsgBoxBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#appMsgBoxBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 21. ModDetailPage / ContentDetailPage 样式（modDetail* 系列�?
 * ============================================================ */
/* 详情页滚动区 */
QScrollArea#modDetailScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#modDetailScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 详情页内容容�?*/
QWidget#modDetailContent {
    background-color: transparent;
}

/* 详情页头�?*/
QWidget#modDetailHeader {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 详情页大图标 �?72px（原�?hero 风格�?*/
QLabel#modDetailIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 16px;
    min-width: 72px;
    min-height: 72px;
    max-width: 72px;
    max-height: 72px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 28px;
}

/* 来源徽章（CurseForge / Modrinth / MC百科�?*/
QLabel#modDetailSourcePill {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_20@;
    border-radius: 7px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
}

/* Hero 下载按钮 */
QPushButton#modDetailHeroDownloadBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
    padding: 8px 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#modDetailHeroDownloadBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modDetailHeroDownloadBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 统计 chip */
QWidget#modDetailStatChip {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 999px;
}

QLabel#modDetailStatChipText {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

/* ---------- 详情�?Tab �?---------- */
QWidget#modDetailTabBar {
    background-color: transparent;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QPushButton#modDetailTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modDetailTab:hover {
    color: @TEXT_PRIMARY@;
}

QPushButton#modDetailTab:checked {
    color: @ACCENT_TEXT@;
    border-bottom: 2px solid @PRIMARY@;
}

QStackedWidget#modDetailTabStack {
    background-color: transparent;
    border: none;
}

QWidget#modDetailTabStack > QWidget {
    background-color: transparent;
}

/* 详情页中文名 */
QLabel#modDetailChineseName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 26px;
    font-weight: 800;
    border: none;
}

/* 详情页英文名 */
QLabel#modDetailEnglishName {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 详情页描�?*/
QLabel#modDetailDesc {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    border: none;
}

/* 详情页左右分�?*/
QWidget#modDetailLeftPanel,
QWidget#modDetailRightPanel {
    background-color: transparent;
    border: none;
}

QWidget#modDetailBody {
    background-color: transparent;
    border: none;
}

/* 详情页信息块 */
QWidget#modDetailSection {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 16px;
}

/* 详情页信息块标题 */
QLabel#modDetailSectionTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 700;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
}

/* 详情页依赖项卡片 */
QWidget#modDetailDepCard {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 10px 12px;
}

QWidget#modDetailDepCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}

/* 详情页依赖项名称 */
QLabel#modDetailDepName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 详情页前置资源图标 */
QLabel#modDetailDepIcon {
    background-color: transparent;
    border: none;
}

/* 详情页前置资源来源（CurseForge / Modrinth） */
QLabel#modDetailDepSource {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 详情页依赖项标签 */
QLabel#modDetailDepTag {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
}

/* 详情页下载版本卡�?*/
QWidget#modDetailDownloadCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 10px 12px;
}

QWidget#modDetailDownloadCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 详情页下载版本号 */
QLabel#modDetailDownloadVer {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 详情页版本徽�?�?release（主色） */
QLabel#modDetailVersionBadge-release {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页版本徽�?�?beta（警告色�?*/
QLabel#modDetailVersionBadge-beta {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页版本徽�?�?alpha（危险色�?*/
QLabel#modDetailVersionBadge-alpha {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* 详情页下载按�?*/
QPushButton#modDetailDownloadBtn {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modDetailDownloadBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#modDetailDownloadBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#modDetailDownloadBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 版本卡「已安装」对号按钮：固定成功色，禁用态也保持绿色以示“已装好” */
QPushButton#modDetailInstalledBtn {
    background-color: @SUCCESS@;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modDetailInstalledBtn:hover,
QPushButton#modDetailInstalledBtn:pressed,
QPushButton#modDetailInstalledBtn:disabled {
    background-color: @SUCCESS@;
    color: @TEXT_ON_PRIMARY@;
}

/* 详情页链接按钮 */
QPushButton#modDetailLinkBtn {
    background-color: transparent;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @LINK@;
    font-size: 12px;
}

QPushButton#modDetailLinkBtn:hover {
    background-color: @LINK_RGBA_0.10@;
    border: 1px solid @LINK@;
}

/* 详情页标签键 */
QLabel#modDetailTagKey {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 详情页标签�?*/
QLabel#modDetailTagValue {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 500;
    border: none;
}

/* 详情页信息芯�?*/
QLabel#modDetailChip {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 详情页描述浏览器 */
QTextBrowser#modDetailDescBrowser {
    background-color: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

/* 详情页截图容�?*/
QWidget#modDetailScreenshotContainer {
    background-color: transparent;
    border: none;
}

/* 详情页截图堆�?*/
QStackedWidget#modDetailScreenshotStack {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 详情页截�?*/
QLabel#modDetailScreenshot {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 12px;
}

/* 详情页截图遮�?*/
QLabel#modDetailScreenshotOverlay {
    background-color: transparent;
    border: none;
    border-radius: 12px;
}

/* 详情页截图前一张按�?*/
QPushButton#modDetailScreenshotPrev,
QPushButton#modDetailScreenshotNext {
    background-color: @BLACK_RGBA_31@;
    border: none;
    border-radius: 999px;
    padding: 8px;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#modDetailScreenshotPrev:hover,
QPushButton#modDetailScreenshotNext:hover {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
}

/* 详情页缩略图�?*/
QWidget#modDetailThumbStrip {
    background-color: transparent;
    border: none;
}

/* 详情页缩略图 */
QLabel#modDetailScreenshotThumb {
    background-color: @BG_MUTED@;
    border: 2px solid transparent;
    border-radius: 6px;
}

QLabel#modDetailScreenshotThumb[current="true"] {
    border: 2px solid @PRIMARY@;
}

/* 帖子详情页的展示图轮播：舞台（与资源详情页的截图区共用同一套圆角浅底） */
QWidget#forumCarouselStage {
    background-color: transparent;
    border: none;
}

/* 轮播里的 B 站视频缩略图：写成一张播放小卡 */
QLabel#modDetailScreenshotThumb[bili="true"] {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 700;
}

/* 详情页收藏按�?*/
QPushButton#contentFavoriteBtn {
    background-color: transparent;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 999px;
    padding: 6px;
    color: @TEXT_TERTIARY@;
}

QPushButton#contentFavoriteBtn:hover {
    background-color: @BG_HOVER@;
    color: @WARNING@;
    border: 1px solid @WARNING@;
}

QPushButton#contentFavoriteBtn:checked {
    background-color: @WARNING_BG@;
    color: @WARNING@;
    border: 1px solid @WARNING@;
}

QListWidget#refNetResultList, QListWidget#refWebList {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QListWidget#refNetResultList::item, QListWidget#refWebList::item {
    padding: 6px 4px;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QListWidget#refNetResultList::item:hover, QListWidget#refWebList::item:hover {
    background: @BG_MUTED@;
}

QListWidget#refLocalInstList {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 13px;
}

QListWidget#refLocalInstList::item {
    padding: 9px 10px;
    border-bottom: 1px solid @BORDER_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QListWidget#refLocalInstList::item:hover {
    background: @BG_MUTED@;
}

QListWidget#refLocalInstList::item:selected {
    background: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QSplitter#refLocalSplitter::handle {
    background: transparent;
    width: 6px;
}

QComboBox#aiChatThinkingEffortCombo,
QComboBox#aiChatPermissionCombo {
    background: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
}

QComboBox#aiChatThinkingEffortCombo:hover,
QComboBox#aiChatPermissionCombo:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QComboBox#aiChatThinkingEffortCombo::drop-down,
QComboBox#aiChatPermissionCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#aiChatThinkingEffortCombo::down-arrow,
QComboBox#aiChatPermissionCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    border: none;
    width: 10px;
    height: 8px;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView,
QComboBox#aiChatPermissionCombo QAbstractItemView {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView::item,
QComboBox#aiChatPermissionCombo QAbstractItemView::item {
    padding: 6px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
    border-radius: 4px;
}

QComboBox#aiChatThinkingEffortCombo QAbstractItemView::item:hover,
QComboBox#aiChatPermissionCombo QAbstractItemView::item:hover {
    background: @BG_MUTED@;
}

QFrame#aiChatTypingIndicator {
    background: transparent;
    border: none;
    border-radius: 0;
}

QLabel#typingDot1 {
    color: @ACCENT_TEXT@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

QLabel#typingDot2 {
    color: @ACCENT_TEXT_MEDIUM@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

QLabel#typingDot3 {
    color: @ACCENT_TEXT_LIGHT@;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

/* --- 17.3 SkinEditorPage 皮肤编辑�?--- */
#SkinEditorToolBar QPushButton {
    border: none;
    border-radius: 12px;
    padding: 4px;
    background: transparent;
    icon-size: 20px;
}

#SkinEditorToolBar QPushButton:hover {
    background: @BLACK_RGBA_0.06@;
}

#SkinEditorToolBar QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
    color: @ACCENT_TEXT@;
}

#SkinEditorPalette QPushButton {
    border: 1px solid @BORDER_STRONG@;
    border-radius: 4px;
    padding: 0;
    margin: 1px;
}

#SkinEditorPalette QPushButton:hover {
    border: 1px solid @TEXT_DISABLED@;
    margin: 0;
}

#SkinEditorPreviewContainer {
    background: @EDITOR_BG_ALT@;
    border-radius: 12px;
    border: 1px solid @BORDER_STRONG@;
}

#SkinEditorStatusBar {
    background: @EDITOR_BG@;
    border-top: 1px solid @BORDER_LIGHT@;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    padding: 4px 12px;
    font-family: Consolas, "Courier New", monospace;
}

#SkinEditorPanelTitle {
    color: @TEXT_TERTIARY@;
    font-weight: 600;
    font-size: 12px;
    padding: 4px 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* --- 17.4 InstanceAssistantWindow 快捷指令�?--- */
QLabel#contextLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 10px;
}

QPushButton#serverToggleBtn, QPushButton#redetectBtn {
    background: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#serverToggleBtn:hover, QPushButton#redetectBtn:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#serverToggleBtn:pressed, QPushButton#redetectBtn:pressed {
    background: @BG_PRESSED@;
}

QPushButton#serverToggleBtn:checked {
    background: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#serverToggleBtn:checked:hover {
    background: @PRIMARY_DARK@;
    border: 1px solid @PRIMARY_DARK@;
}

/* --- 17.5 ModelDialog 模型选择对话�?--- */
QWidget#modelSelectCard {
    background: @BG_CARD@;
    border-radius: 20px;
    border: 1px solid @BORDER@;
}

QLabel#modelDialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    letter-spacing: 0.3px;
    background: transparent;
}

QPushButton#modelDialogCloseBtn {
    background: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    border-radius: 16px;
    font-size: 16px;
}

QPushButton#modelDialogCloseBtn:hover {
    background: @DANGER_BG@;
    color: @DANGER@;
}

QWidget#modelSearchContainer {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#modelSearchContainer:hover {
    background: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QWidget#modelSearchContainer > QLineEdit#modelSearchEdit {
    background: transparent;
    border: none;
    padding: 10px 16px 10px 4px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QWidget#modelSearchContainer > QLineEdit#modelSearchEdit:focus {
    border: none;
    background: transparent;
}

QLabel#modelSearchIcon {
    background: transparent;
    color: @TEXT_DISABLED@;
    font-size: 15px;
    border: none;
    padding: 0;
}

QScrollArea#modelDialogScroll {
    background: transparent;
    border: none;
}

QScrollArea#modelDialogScroll > QWidget {
    background: transparent;
}

QScrollArea#modelDialogScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QScrollArea#modelDialogScroll QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#modelDialogScroll QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#modelDialogScroll QScrollBar::add-line:vertical,
QScrollArea#modelDialogScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#modelDialogScroll QScrollBar::add-page:vertical,
QScrollArea#modelDialogScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#modelCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#modelCard:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#modelCardName {
    font-size: 14px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
}

QLabel#modelCardProvider {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
}

QLabel#modelCardDesc {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#modelCardAddBtn {
    background: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modelCardAddBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#modelCardAddBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_TERTIARY@;
}

QLabel#modelDialogHintLabel {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    padding: 8px 4px;
}

/* --- 17.6 AccountManagePage 账户管理�?--- */
QWidget#accountManageWidget > QWidget {
    background: transparent;
}

QLabel#accountNameTitle {
    font-size: 22px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    padding: 4px 0;
}

QListWidget#accountListWidget {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    min-width: 220px;
}

QListWidget#accountListWidget::item {
    padding: 14px 18px;
    border-radius: 12px;
    margin: 3px 4px;
    border: 1px solid transparent;
}

QListWidget#accountListWidget::item:hover {
    background: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QListWidget#accountListWidget::item:selected {
    background: @PRIMARY_RGBA_20@;
    color: @TEXT_ACCENT@;
    border: 1px solid @PRIMARY@;
}

QListWidget#accountListWidget::item:selected:hover {
    background: @PRIMARY_RGBA_26@;
}

QLabel#skinDisplay {
    border: 2px solid @BORDER@;
    border-radius: 16px;
    background: @BG_CONTENT@;
}

QLabel#skinDisplay:hover {
    border: 2px solid @PRIMARY@;
}

/* --- 17.7 DetailsTextEdit 详情文本框滚动条 --- */
QTextEdit#detailsTextEdit QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 0;
}

QTextEdit#detailsTextEdit QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QTextEdit#detailsTextEdit QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QTextEdit#detailsTextEdit QScrollBar::add-line:vertical,
QTextEdit#detailsTextEdit QScrollBar::sub-line:vertical {
    height: 0;
}

QTextEdit#detailsTextEdit QScrollBar::add-page:vertical,
QTextEdit#detailsTextEdit QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ============================================================
 * Section 22. InstanceOverviewPage 样式（overview* 系列�?
 * ============================================================ */
/* 概览滚动�?*/
QScrollArea#overviewScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#overviewScrollContent {
    background-color: transparent;
}

/* 概览头部卡片 �?玻璃�?*/
QWidget#overviewHeaderCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 20px;
}

/* 概览大图�?�?64px 主色渐变 */
QLabel#overviewIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 24px;
}

/* 概览实例�?*/
QLabel#overviewInstanceName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 28px;
    font-weight: 800;
    border: none;
}

/* 概览标签芯片 */
QLabel#overviewTag {
    background-color: @PRIMARY_RGBA_20@;
    color: @TEXT_ACCENT@;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 500;
}

/* 概览副文�?*/
QLabel#overviewSubText {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
}

/* 概览启动按钮 �?主色渐变胶囊 */
/* Overview launch button.
 * Qt does not clamp border-radius values larger than half the widget height;
 * it simply skips rounding. The button is fixed at 44px high, so the radius
 * must be 22px to render as a pill. */
QPushButton#overviewLaunchBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 22px;
    padding: 10px 32px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#overviewLaunchBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_HOVER@,
        stop:1 @PRIMARY@);
}

QPushButton#overviewLaunchBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 概览统计卡片 �?玻璃�?+ hover 上浮 */
QWidget#overviewStatCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 6px;
}

QWidget#overviewStatCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

/* 概览统计图标 �?32px 主色半透明 */
QLabel#overviewStatIcon {
    background-color: @PRIMARY_BG@;
    border: none;
    border-radius: 8px;
    min-width: 36px;
    min-height: 36px;
    max-width: 36px;
    max-height: 36px;
    color: @ACCENT_TEXT@;
}

/* 概览统计数字 �?24px 800字重主色 Consolas */
QLabel#overviewStatCount {
    background-color: transparent;
    color: @ACCENT_TEXT@;
    font-size: 18px;
    font-weight: 800;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 概览统计标题 �?11px 灰色大写 */
QLabel#overviewStatTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* 概览操作�?*/
QWidget#overviewActionsSection {
    background-color: transparent;
    border: none;
}

/* 概览区段标题 */
QLabel#overviewSectionTitle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 概览操作按钮 �?玻璃�?*/
QPushButton#overviewActionBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#overviewActionBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#overviewActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 概览路径�?�?玻璃�?*/
QWidget#overviewPathCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 10px 14px;
}

/* 概览路径图标 */
QLabel#overviewPathIcon {
    background-color: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
}

/* 概览路径文字 �?12px Consolas */
QLabel#overviewPathText {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* ============================================================
 * Section 23. SearchPage 样式（search* 系列�?
 * ============================================================ */
/* 搜索页输入框 */
QLineEdit#searchPageInput {
    background-color: @BG_CARD@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#searchPageInput:focus {
    border: 2px solid @PRIMARY@;
}

QLineEdit#searchPageInput:hover {
    border: 2px solid @BORDER_HOVER@;
}

/* 搜索筛�?chip */
QComboBox#searchFilterCombo,
QComboBox#searchSubFilterCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px 28px 4px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QComboBox#searchFilterCombo:hover,
QComboBox#searchSubFilterCombo:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QComboBox#searchFilterCombo:focus,
QComboBox#searchSubFilterCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#searchFilterCombo::drop-down,
QComboBox#searchSubFilterCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid @BORDER@;
}

QComboBox#searchFilterCombo::down-arrow,
QComboBox#searchSubFilterCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 8px;
    border: none;
}

QComboBox#searchFilterCombo QAbstractItemView,
QComboBox#searchSubFilterCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @PRIMARY@;
    outline: none;
}

QComboBox#searchFilterCombo QAbstractItemView::item,
QComboBox#searchSubFilterCombo QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
    color: @TEXT_SECONDARY@;
    min-height: 20px;
}

QComboBox#searchFilterCombo QAbstractItemView::item:hover,
QComboBox#searchSubFilterCombo QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QComboBox#searchFilterCombo QAbstractItemView::item:selected,
QComboBox#searchSubFilterCombo QAbstractItemView::item:selected {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

/* 搜索结果标题 */
QLabel#searchResultsTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    border: none;
}

/* 搜索无结果提�?*/
QLabel#searchNoResults {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 14px;
    border: none;
    padding: 48px 24px;
}

/* 搜索页标�?*/
QLabel#searchPageTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 24px;
    font-weight: 800;
    border: none;
}

/* 搜索结果滚动�?*/
QScrollArea#searchPageResultsScroll {
    background-color: transparent;
    border: none;
}

QWidget#searchResultsInnerContainer {
    background-color: transparent;
}

/* 搜索结果卡片 �?玻璃�?+ hover 横移 */
QWidget#searchResultCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 12px;
}

QWidget#searchResultCard:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    margin: 0 0 0 2px;
}

/* 搜索结果图标 �?40x40 主色渐变 */
QLabel#searchResultIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 700;
    font-size: 16px;
}

/* 搜索结果标题 */
QLabel#searchResultTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 搜索结果副标�?*/
QLabel#searchResultSubtitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 搜索结果版本�?�?Consolas */
QLabel#searchResultVersion {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-family: "Consolas", "Cascadia Code", monospace;
    border: none;
}

/* 搜索结果描述 */
QLabel#searchResultDescription {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 外部搜索分隔�?*/
QWidget#externalSearchSep {
    background-color: transparent;
    border: none;
}

QFrame#externalSearchSepLine {
    background-color: @BORDER_LIGHT@;
    border: none;
    max-height: 1px;
}

QLabel#externalSearchSepLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* 外部搜索提示 */
QLabel#externalSearchHint {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* ---------- 热门搜索 + 排序工具栏（原型化） ---------- */
QLabel#searchHotLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

QPushButton#searchHotBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 4px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
}

QPushButton#searchHotBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* ---------- 富搜索结果卡片（原型化） ---------- */
QLabel#searchResultTypeBadge {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_20@;
    border-radius: 7px;
    padding: 1px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#searchResultTypeBadge[badgeKind="instance"] {
    background-color: @INFO_RGBA_20@;
    color: @INFO@;
    border: 1px solid @INFO_RGBA_51@;
}

QLabel#searchResultTypeBadge[badgeKind="setting"] {
    background-color: rgba(148, 163, 184, 0.16);
    color: @TEXT_TERTIARY@;
    border: 1px solid rgba(148, 163, 184, 0.24);
}

QLabel#searchResultTypeBadge[badgeKind="favorite"] {
    background-color: rgba(236, 72, 153, 0.12);
    color: #BE185D;
    border: 1px solid rgba(236, 72, 153, 0.22);
}

QLabel#searchResultTypeBadge[badgeKind="task"] {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_20@;
}

QLabel#searchResultTypeBadge[badgeKind="external"] {
    background-color: rgba(148, 163, 184, 0.16);
    color: @TEXT_TERTIARY@;
    border: 1px solid rgba(148, 163, 184, 0.24);
}

QLabel#searchResultSrc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    border: none;
}

QLabel#searchResultMetaChip {
    background-color: rgba(0, 0, 0, 0.04);
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    font-family: "Consolas", "Cascadia Code", monospace;
}

QLabel#searchResultStatChip {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#searchResultTag {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY@;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 500;
}

QPushButton#searchResultActionBtn {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY@;
    border-radius: 999px;
    padding: 4px 14px;
    color: @ACCENT_TEXT@;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#searchResultActionBtn:hover {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

/* ---------- 搜索页（单一搜索框） ---------- */
/* 结果面板：分区标题与卡片共用一块玻璃底板，背景图再花也能看清 */
QWidget#searchResultsPanel {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 唯一的搜索框：整页只保留它一个输入控件，做得比列表页搜索框更大更聚焦 */
QLineEdit#searchHeroInput {
    background-color: @BG_CARD@;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 16px;
    padding: 12px 20px;
    font-size: 15px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#searchHeroInput:hover {
    border: 2px solid @BORDER_HOVER@;
}

QLineEdit#searchHeroInput:focus {
    border: 2px solid @PRIMARY@;
}

/* 未输入关键词时的弱提示 */
QLabel#searchIdleHint {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    font-size: 12px;
}

/* 结果分区标题（在线资源 / 社区讨论） */
QLabel#searchSectionTitle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    font-size: 12px;
    font-weight: 700;
    padding: 14px 2px 8px 2px;
}

/* 结果区底部状态：正在搜索 / 部分来源不可用 */
QLabel#searchStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    font-size: 12px;
    padding: 16px 0 8px 0;
}

