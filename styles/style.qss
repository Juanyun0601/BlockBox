QLabel#bedrockResourcesSectionBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 2px;
}

/* 「新建收藏夹」幽灵按�?�?虚线描边 + hover 主色 */
QPushButton#bedrockResourcesNewFavBtn {
    background-color: transparent;
    border: 1px dashed @BORDER_STRONG@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#bedrockResourcesNewFavBtn:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
    background-color: @PRIMARY_RGBA_15@;
}

QPushButton#bedrockResourcesNewFavBtn:pressed {
    background-color: @PRIMARY_RGBA_20@;
}

/* 收藏夹空态提�?*/
QLabel#bedrockResourcesEmptyLabel {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 28px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}

/* 横向资源卡片 �?玻璃�?+ hover 上浮 */
QWidget#bedrockResourcesCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#bedrockResourcesCard:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY_RGBA_38@;
}

/* 渐变图标块容�?�?透明（渐变由自绘 pixmap 提供�?*/
QLabel#bedrockResourceIconBlock {
    background-color: transparent;
    border: none;
}

/* 卡片标题 �?14px 600字重 */
QLabel#bedrockResourceCardTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
    border: none;
}

/* 卡片描述 �?12px 三级�?*/
QLabel#bedrockResourceCardDesc {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 右侧箭头 �?hover 变主色（由后代选择器控制） */
QLabel#bedrockResourceArrow {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 18px;
    font-weight: 600;
    border: none;
}

QWidget#bedrockResourcesCard:hover QLabel#bedrockResourceArrow {
    color: @ACCENT_TEXT@;
}

/* --- 39.3c 基岩版实例助手资源管理页（BedrockResourcesPage 资源管理模式）--- */
QWidget#bedrockResCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
}
QWidget#bedrockResCard:hover {
    border: 1px solid @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#bedrockResCardName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}
QLabel#bedrockResCardSize {
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    background: transparent;
    border: none;
}
QLabel#bedrockResDisabledTag {
    color: #EF4444;
    font-size: 10px;
    font-weight: 600;
    background: transparent;
    border: none;
}
QLabel#bedrockResEmptyLabel {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    padding: 40px;
    background: transparent;
    border: none;
}
QLineEdit#bedrockResSearchEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#bedrockResSearchEdit:focus {
    border: 1px solid @PRIMARY@;
}

/* --- 39.4 模型选择对话框补�?--- */
/* 模型选择对话�?�?玻璃�?*/
QWidget#modelSelectDialog {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 模型对话框标题栏 �?�?.dlg-head 一�?*/
QWidget#modelDialogTitleBar {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    min-height: 56px;
    max-height: 56px;
}

/* 模型对话框标�?�?17px 800字重 */
QLabel#modelDialogTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    border: none;
}

/* 模型对话框本地按�?�?胶囊芯片 */
QPushButton#modelDialogLocalBtn {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 999px;
    padding: 6px 16px;
    color: @TEXT_ACCENT@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#modelDialogLocalBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* 模型对话框区块容�?�?透明 + 下间�?*/
QWidget#modelConfiguredSection,
QWidget#modelProviderSection,
QWidget#modelHotSection,
QWidget#modelJsonSection {
    background-color: transparent;
    border: none;
    margin-bottom: 16px;
}

/* 模型区块标题 �?11px 700字重 大写 */
QLabel#modelSectionTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    padding: 6px 2px;
}

/* 模型空提�?�?13px 禁用�?居中 */
QLabel#modelEmptyHint {
    background-color: transparent;
    color: @TEXT_DISABLED@;
    font-size: 13px;
    border: none;
    padding: 24px;
}

/* 模型热门标题 �?11px 700字重 大写 */
QLabel#modelHotTitle {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    padding: 4px 2px;
}

/* 模型供应商内�?�?透明 */
QWidget#modelProviderContent {
    background-color: transparent;
    border: none;
}

/* 模型配置表单标题 �?15px 600字重 */
QLabel#modelConfigFormTitle {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 600;
    border: none;
}

/* 模型自定�?JSON 按钮 �?玻璃态描�?*/
QPushButton#modelCustomJsonBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#modelCustomJsonBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* --- 39.5 设置页内容堆�?--- */
/* 设置页各内容�?�?透明无边框；内边距统一�?cpp �?setContentsMargins 控制
 * （settings/* 子页面均使用 setContentsMargins(24, 8, 24, 24) 等值）�?
 * 此处不再声明 padding，避免与 widget �?contentsMargins 叠加导致左右 48px�?
 * 顶部 32px 的过量留白�?*/
QWidget#settingsGeneralContent,
QWidget#settingsInterfaceContent,
QWidget#settingsGameContent,
QWidget#settingsInstanceContent,
QWidget#settingsJavaContent,
QWidget#settingsAdvancedContent,
QWidget#settingsKeyBindContent {
    background-color: transparent;
    border: none;
}

/* --- 39.6 ScreenshotViewer 缩略�?--- */
/* 截图缩略�?�?8px 圆角描边 */
QLabel#thumbnail {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

QLabel#thumbnail:hover {
    border: 1px solid @BORDER_HOVER@;
}

QLabel#thumbnail[selected="true"] {
    border: 2px solid @PRIMARY@;
}

/* ============================================================
 * Section 40. 跨组件状态与无障碍样�?
 * ============================================================ */
/* 通用按钮禁用�?�?灰化 + �?hover 反馈 */
QPushButton:disabled,
QPushButton:disabled:hover {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 通用输入控件禁用�?�?灰化 */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 通用列表/树禁用�?�?灰化文字 */
QListWidget:disabled::item,
QTreeWidget:disabled::item {
    color: @TEXT_DISABLED@;
}

/* 通用按钮聚焦�?�?主色边框 */
QPushButton:focus {
    border: 1px solid @PRIMARY@;
}

/* 错误态输入控�?�?危险色边�?+ 危险背景 */
QLineEdit[state="error"],
QComboBox[state="error"],
QSpinBox[state="error"] {
    border: 2px solid @DANGER@;
    background-color: @DANGER_BG@;
}

QLineEdit[state="error"]:focus,
QComboBox[state="error"]:focus,
QSpinBox[state="error"]:focus {
    border: 2px solid @DANGER@;
}

/* 通用列表/树选中态补�?�?主色半透明背景 */
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @ACCENT_TEXT@;
}

/* Task 8: 补充属性选择器规�?*/
QLabel#multiplayerLatencyLabel[status="good"] {
    color: @SUCCESS@;
}
QLabel#multiplayerLatencyLabel[status="medium"] {
    color: @WARNING@;
}
QLabel#multiplayerLatencyLabel[status="bad"] {
    color: @DANGER@;
}

QWidget#statusDot[status="running"] {
    background-color: @PRIMARY@;
}
QWidget#statusDot[status="idle"] {
    background-color: @TEXT_DISABLED@;
}
QWidget#statusDot[status="error"] {
    background-color: @DANGER@;
}

QLabel#localModStatus[status="enabled"] {
    color: @SUCCESS@;
}
QLabel#localModStatus[status="disabled"] {
    color: @TEXT_DISABLED@;
}

/* Task 9: 伪态与无障碍补�?（Qt QSS 不支持 outline，用文字与描边主色做键盘焦点提示） */
QCheckBox:focus, QRadioButton:focus {
    color: @ACCENT_TEXT@;
}

QCheckBox:focus::indicator {
    border-color: @PRIMARY@;
}

QProgressBar:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}
QProgressBar:disabled::chunk {
    background-color: @TEXT_DISABLED@;
}

QDoubleSpinBox {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QDoubleSpinBox:focus {
    border: 1px solid @PRIMARY@;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: @BG_MUTED@;
    border: none;
    width: 18px;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @BG_HOVER@;
}

QTableView::item:hover {
    background-color: @BG_HOVER@;
}
QListView::item:focus {
    outline: 1px dashed @PRIMARY@;
    outline-offset: 1px;
}

/* ============================================================
 * Section 41. AI Agent 工具步骤卡片样式
 * ============================================================ */
QWidget#agentStepsContainer {
    background-color: transparent;
    border: none;
}

/* 工具/搜索过程行：一轮一行纯文字样式 */
QWidget#agentToolStepCard {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QPushButton#agentToolStepHeaderRow {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 1px 2px;
    text-align: left;
}

QPushButton#agentToolStepHeaderRow:hover {
    background-color: @BG_HOVER@;
}

QLabel#agentToolStepName {
    font-size: 12px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
}

/* 过程行左侧状态图标：运行中为旋转点阵，结束定格 ✓ / ✗（观感参考 opencode） */
QLabel#agentStepGlyph {
    font-family: "Segoe UI Symbol", "Segoe UI", Consolas, sans-serif;
    font-size: 12px;
    background-color: transparent;
    color: @TEXT_TERTIARY@;
}

QLabel#agentStepGlyph[state="running"] {
    color: @TEXT_SECONDARY@;
}

QLabel#agentStepGlyph[state="success"] {
    color: @SUCCESS@;
}

QLabel#agentStepGlyph[state="danger"] {
    color: @DANGER@;
}

QLabel#agentToolStepDuration {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
}

QLabel#agentToolStepSummary {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background-color: transparent;
}

/* 文件编辑行：行级增删统计（+N 绿 / -M 红） */
QLabel#agentToolStepDiffAdd {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    color: @SUCCESS@;
    background-color: transparent;
}

QLabel#agentToolStepDiffDel {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    color: @DANGER@;
    background-color: transparent;
}

/* 展开详情：左侧竖线缩进，与思考内容块保持同一种观感 */
QWidget#agentToolStepDetails {
    background-color: transparent;
    border: none;
    border-left: 2px solid @BORDER@;
    padding: 2px 0 2px 16px;
}

QLabel#agentToolStepArgs {
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-size: 12px;
    background-color: transparent;
    border: none;
    padding: 0px;
    color: @TEXT_SECONDARY@;
}

QLabel#agentToolStepResult {
    font-size: 12px;
    background-color: transparent;
    border: none;
    padding: 0px;
    color: @TEXT_SECONDARY@;
}

QLabel#agentToolStepResult[status="danger"] {
    color: @DANGER@;
}

QWidget#taskListCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 10px 12px;
}

QProgressBar#taskListProgressBar {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 999px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#taskListProgressBar::chunk {
    border-radius: 999px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}

QWidget#taskListRow {
    background-color: transparent;
    min-height: 36px;
    max-height: 36px;
    padding: 0 8px;
}

QWidget#taskListRow:hover {
    background-color: @BG_HOVER@;
}

/* ============================================================
 * Section 42. LoaderDetailPage 样式
 * ============================================================ */
/* 顶部安装信息卡片：实例名称 / 安装位置 / 下载源 / 已选加载器收进一张卡片 */
QFrame#loaderTopCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 卡片内的输入控件换成浅一档的填充色，避免白底白框糊成一片 */
QFrame#loaderTopCard QLineEdit#loaderInstanceNameEdit,
QFrame#loaderTopCard QComboBox#loaderPathCombo,
QFrame#loaderTopCard QComboBox#loaderSourceCombo,
QFrame#loaderTopCard QPushButton#loaderAddFolderBtn {
    background-color: @BG_CONTENT@;
}

/* 已选加载器的小卡片同样用浅底衬托主色边框 */
QFrame#loaderTopCard QWidget#selectedLoaderCard {
    background-color: @BG_CONTENT@;
}

QLabel#loaderSectionLabel {
    font-size: 12px;
    font-weight: 600;
    color: @TEXT_TERTIARY@;
    letter-spacing: 1px;
    background-color: transparent;
}

QLineEdit#loaderInstanceNameEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 12px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY_RGBA_18@;
}

QLineEdit#loaderInstanceNameEdit:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#loaderPathCombo,
QComboBox#loaderSourceCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_PRIMARY@;
}

QComboBox#loaderPathCombo:focus,
QComboBox#loaderSourceCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#loaderPathCombo:hover,
QComboBox#loaderSourceCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

QPushButton#loaderAddFolderBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#loaderAddFolderBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 加载器详情页：列表容器透明化，让 modCardListItem 卡片像「下载模组」等页一样独立悬浮 */
QListWidget#loaderListWidget {
    background-color: transparent;
    border: none;
    padding: 0px 14px;
    outline: none;
}

QListWidget#loaderListWidget::item {
    background-color: transparent;
    padding: 0px;
    border-radius: 12px;
}

QListWidget#loaderListWidget::item:hover {
    background-color: transparent;
}

QListWidget#loaderListWidget::item:selected {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
}

QLabel#loaderMessageLabel {
    font-size: 13px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
    padding: 4px 0;
}

QWidget#selectedLoaderCard {
    background-color: @BG_CARD@;
    border: 2px solid @PRIMARY@;
    border-radius: 12px;
    padding: 12px;
}

QLabel#loaderSelectedCardName {
    font-size: 14px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
}

QLabel#loaderSelectedCardVersion {
    font-size: 12px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
}

QLabel#loaderSelectedCardClose {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}

QLabel#loaderSelectedCardClose:hover {
    color: @DANGER@;
}

/* ============================================================
 * Section 43. CommandPack 对话框样�?
 * ============================================================ */
QTableWidget#packManagerTable {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    gridline-color: @BORDER_LIGHT@;
    outline: none;
}

QTableWidget#packManagerTable::item {
    padding: 6px 8px;
}

QTableWidget#packManagerTable::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @ACCENT_TEXT@;
}

QHeaderView::section {
    background-color: @BG_MUTED@;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid @BORDER@;
}

QHeaderView::section:hover {
    background-color: @BG_HOVER@;
}

QPushButton#packAddBtn,
QPushButton#packCreateBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#packAddBtn:hover,
QPushButton#packCreateBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#packAddBtn:pressed,
QPushButton#packCreateBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

QPushButton#packEditBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packEditBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packRemoveBtn {
    background-color: transparent;
    border: 1px solid @DANGER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @DANGER@;
}

QPushButton#packRemoveBtn:hover {
    background-color: @DANGER_BG@;
    color: @DANGER@;
}

QPushButton#packCloseBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packCloseBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packEditorSaveBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#packEditorSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#packEditorSaveAsBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_SECONDARY@;
}

QPushButton#packEditorSaveAsBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#packEditorCancelBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 8px;
    padding: 8px 16px;
    color: @TEXT_TERTIARY@;
}

QPushButton#packEditorCancelBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 44. 零散控件补充样式
 * ============================================================ */
QPushButton#launchButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 600;
}

QPushButton#launchButton:hover {
    background-color: @PRIMARY_HOVER@;
    margin-top: -1px;
}

QPushButton#launchButton:pressed {
    background-color: @PRIMARY_DARK@;
}

QLabel#exampleContentLabel {
    font-size: 13px;
    color: @TEXT_DISABLED@;
    background-color: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#homeEmptyLabel {
    font-size: 15px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
    qproperty-alignment: AlignCenter;
}

QScrollArea#modScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#modCardContainer {
    background-color: transparent;
    spacing: 16px;
}

QStackedWidget#carouselStack {
    background-color: transparent;
    border: none;
}

QLabel#versionValueLabel {
    font-size: 14px;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
}

QStackedWidget#instanceManageContentStack {
    background-color: transparent;
    border: none;
}

QLabel#subNavSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: @TEXT_TERTIARY@;
    letter-spacing: 1px;
    background-color: transparent;
}

QPushButton#bindFolderBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#bindFolderBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QWidget#thinkingContentWidget {
    background-color: transparent;
    padding-left: 16px;
    border-left: 2px solid @PRIMARY@;
}

QLabel#aiChatStatusLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background-color: transparent;
}

QPushButton#aiChatSkillBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatSkillBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatSkillBtn[active="true"] {
    background-color: @PRIMARY_RGBA_18@;
    border: 1px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* --- 17.2.1 AiChatPage 紧凑模式（实例助�?450px 窄窗口覆盖） ---
 * 通过 AiChatPage::setCompactMode 设置动态属�?compactMode 触发�?
 * 缩小欢迎页标�?简介字号、快捷按钮尺寸、消息字号与输入区按钮内边距�?
 * �?AI 助手页在实例助手窄窗口下不换行、不溢出、视觉不拥挤�?*/
AiChatPage[compactMode="true"] QLabel#aiChatConvTitle {
    font-size: 13px;
}

AiChatPage[compactMode="true"] QLabel#aiChatWelcomeTitleLabel {
    font-size: 20px;
}

AiChatPage[compactMode="true"] QLabel#aiChatWelcomeDescLabel {
    font-size: 13px;
    padding: 8px 8px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatQuickBtn {
    padding: 9px 12px;
    font-size: 12px;
    min-width: 96px;
    max-width: 200px;
}

AiChatPage[compactMode="true"] QFrame#aiChatUserBubble QLabel#msgContent,
AiChatPage[compactMode="true"] QFrame#aiChatAiBubble QLabel#msgContent {
    font-size: 13px;
}

AiChatPage[compactMode="true"] QTextEdit#aiChatInputEdit {
    font-size: 13px;
    padding: 5px 6px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatSendBtn {
    padding: 0;
}

AiChatPage[compactMode="true"] QPushButton#aiChatModelBtn {
    padding: 4px 8px;
    font-size: 11px;
}

AiChatPage[compactMode="true"] QPushButton#aiChatWorkspaceBtn {
    padding: 0 8px;
    font-size: 11px;
}

AiChatPage[compactMode="true"] QComboBox#aiChatThinkingEffortCombo,
AiChatPage[compactMode="true"] QComboBox#aiChatPermissionCombo {
    padding: 0 8px;
    font-size: 11px;
}

QDialog#localModelDialog,
QDialog#pluginSettingsDialog {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QWidget#pluginSettingsForm {
    background-color: transparent;
    padding: 16px;
}

QComboBox#refNetTypeCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_PRIMARY@;
}

QComboBox#refNetTypeCombo:focus {
    border: 1px solid @PRIMARY@;
}

QComboBox#refNetTypeCombo:hover {
    border: 1px solid @BORDER_HOVER@;
}

/* ===== Section 45: InstanceGameSettingsPage 实例游戏设置�?===== */
QLabel#instanceInfoLabel {
    font-size: 14px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QComboBox#instanceJavaPathCombo {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QComboBox#instanceJavaPathCombo:focus {
    border: 1px solid @PRIMARY@;
}
QComboBox#instanceJavaPathCombo::drop-down {
    border: none;
    width: 20px;
}

QSlider#instanceMemorySlider::groove:horizontal {
    height: 4px;
    background: transparent;
    border-radius: 999px;
}
QSlider#instanceMemorySlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    border-radius: 999px;
}
QSlider#instanceMemorySlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 999px;
}

QLineEdit#instanceJvmArgsEdit {
    font-family: Consolas, Monaco, "Courier New", monospace;
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceJvmArgsEdit:focus {
    border: 1px solid @PRIMARY@;
}

QLineEdit#instanceNameEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceNameEdit:focus {
    border: 1px solid @PRIMARY@;
}

QLabel#instanceIconPreview {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 12px;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 800;
    font-size: 24px;
}

QLineEdit#instanceMinMemoryEdit,
QLineEdit#instanceWindowWidthEdit,
QLineEdit#instanceWindowHeightEdit {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QLineEdit#instanceMinMemoryEdit:focus,
QLineEdit#instanceWindowWidthEdit:focus,
QLineEdit#instanceWindowHeightEdit:focus {
    border: 1px solid @PRIMARY@;
}

QPushButton#refreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}
QPushButton#refreshBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

/* ===== Section 46: MicrosoftLoginDialog 微软登录对话�?===== */
QLabel#loginStatusLabel {
    font-size: 12px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QProgressBar#loginProgressBar {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    height: 6px;
    text-align: center;
}
QProgressBar#loginProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    border-radius: 999px;
}

QPushButton#openBrowserButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton#openBrowserButton:hover {
    margin-top: -1px;
}
QPushButton#openBrowserButton:pressed {
    margin-top: 0px;
}

/* ===== Section 47: ShaderPackSettingsPage 光影包设置页 =====
 * 标题 / 副标�?/ 选项�?/ 按钮均复用设置页共享样式
 * （sectionTitle / sectionSubtitle / settingRow / restoreDefaultsBtn / saveButton）�?
 * 仅保留分页容器背景修正：选项行直接铺�?QTabWidget::pane 卡片上�?*/
QWidget#shaderFormContainer {
    background: transparent;
    padding: 0px;
}

/* ===== Section 48: CreatePluginDialog 创建插件对话�?===== */
QDialog#createPluginDialog {
    background-color: @BG_BASE@;
    border-radius: 16px;
    border: 1px solid @BORDER@;
}

QLabel#createPluginFieldLabel {
    font-size: 13px;
    font-weight: 600;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QTextEdit#createPluginDescEdit {
    font-family: Consolas, Monaco, "Courier New", monospace;
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 10px;
    color: @TEXT_PRIMARY@;
}
QTextEdit#createPluginDescEdit:focus {
    border: 1px solid @PRIMARY@;
}

QLabel#createPluginResultIcon, QLabel#createPluginResultText {
    background: transparent;
}

/* ===== Section 49: StartupProgressWidget 启动进度组件 ===== */
QLabel#startupTitleLabel {
    font-size: 22px;
    font-weight: 700;
    color: @ACCENT_TEXT@;
    background: transparent;
}

QLabel#startupStatusLabel {
    font-size: 13px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

QProgressBar#startupProgressBar {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    height: 6px;
    text-align: center;
}
QProgressBar#startupProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_RGBA_102@);
    border-radius: 999px;
}

/* ============================================================
 * Section 50. OnboardingWizard 新手引导向导
 * objectName 前缀 obw，全部控件跟随全局主题占位符
 * ============================================================ */

/* --- 50.1 向导卡片容器 --- */
QFrame#OnboardingWizardCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 @BG_CARD@, stop:1 @BG_CONTENT@);
    border: 1px solid @BORDER@;
    border-radius: 28px;
}
/* 新手引导已是主窗口里的独立整页：铺满内容区，去掉浮动卡片的圆角与边框 */
QWidget#OnboardingWizard QFrame#OnboardingWizardCard {
    border: none;
    border-radius: 0;
}
/* 容器自身透明（让父级页面透出主对话框背景） */
QWidget#obwStepper, QWidget#obwStepNode,
QStackedWidget#obwStack, QWidget#obwPage0, QWidget#obwPageDlSource, QWidget#obwPage1,
QWidget#obwPage2Import, QWidget#obwPage2Manual, QWidget#obwPage3, QWidget#obwPage4,
QWidget#obwPage5, QWidget#obwPageDone, QScrollArea#obwScroll,
QFrame#obwFooter {
    background-color: transparent;
}
/* 列表容器：圆角浅灰面板，与白色卡片形成层次对比 */
QWidget#obwAccountList, QWidget#obwFolderList, QWidget#obwJavaList {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

/* --- 50.2 跳过引导（底部「下一步」左侧的次要入口） --- */
QPushButton#obwSkipBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: @TEXT_TERTIARY@;
    padding: 7px 16px;
    font-size: 12.5px;
    font-weight: 500;
}
QPushButton#obwSkipBtn:hover {
    color: @TEXT_PRIMARY@;
    border-color: @BORDER@;
    background-color: @BG_HOVER@;
}
QPushButton#obwSkipBtn:pressed {
    background-color: @BG_PRESSED@;
}
QPushButton#obwSkipBtn:focus {
    color: @TEXT_ACCENT@;
    border-color: @PRIMARY_MEDIUM@;
}

/* --- 50.3 步骤条（待办虚线圆点 → 进行中实色渐变 → 已完成淡色对勾） --- */
QWidget#obwStepper {
    background-color: transparent;
    border-bottom: 1px solid @BORDER@;
}
QWidget#obwStepNode {
    background-color: transparent;
}
QLabel#obwStepDot {
    background-color: @BG_MUTED@;
    border: 1.5px dashed @BORDER_STRONG@;
    border-radius: 17px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 700;
}
/* 各态描边统一 1.5px，避免边框粗细变化导致圆点视觉尺寸跳动 */
QLabel#obwStepDot[state="active"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1.5px solid @PRIMARY_MEDIUM@;
    color: @TEXT_ON_PRIMARY@;
    font-size: 14px;
    font-weight: 800;
}
QLabel#obwStepDot[state="done"] {
    background-color: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY_MEDIUM@;
    color: @ACCENT_TEXT@;
    font-size: 14px;
}
QLabel#obwStepLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
}
QLabel#obwStepLabel[state="active"] {
    color: @ACCENT_TEXT@;
    font-weight: 700;
}
QLabel#obwStepLabel[state="done"] {
    color: @TEXT_SECONDARY@;
}
QFrame#obwStepLine {
    background-color: @BORDER@;
    border: none;
    border-radius: 1.5px;
}
QFrame#obwStepLine[state="done"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 @PRIMARY@, stop:1 @PRIMARY_MEDIUM@);
}

/* --- 50.4 页面标题 --- */
QLabel#obwPageTitle {
    color: @TEXT_PRIMARY@;
    font-size: 22px;
    font-weight: 800;
}
QLabel#obwPageDesc {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}
QLabel#obwSectionTitle {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 700;
    border-left: 3px solid @PRIMARY@;
    padding-left: 8px;
}
QLabel#obwSectionTitleLabel {
    color: @TEXT_SECONDARY@;
    font-size: 14px;
    font-weight: 700;
}

/* --- 50.5 引导方式卡片（Step1�?--- */
QFrame#obwMethodTopBar {
    background-color: transparent;
    border: none;
    border-radius: 2px;
}
QPushButton#obwMethodCard:hover QFrame#obwMethodTopBar {
    background-color: @PRIMARY_RGBA_38@;
}
QPushButton#obwMethodCard:checked QFrame#obwMethodTopBar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}
QPushButton#obwMethodCard {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
    text-align: left;
}
QPushButton#obwMethodCard:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY_RGBA_102@;
}
QPushButton#obwMethodCard:checked {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QPushButton#obwMethodCard:pressed {
    background-color: @BG_HOVER@;
}
QPushButton#obwMethodCard:checked:pressed {
    background-color: @PRIMARY_BG@;
}
QPushButton#obwMethodCard:focus {
    border-color: @PRIMARY_MEDIUM@;
}
QLabel#obwMethodCheck {
    background-color: transparent;
    border: none;
    border-radius: 11px;
    color: rgba(0, 0, 0, 0);
    font-size: 12px;
    font-weight: 800;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodCheck {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    color: #FFFFFF;
}
/* 图标：默�?accent-soft �?+ accent 字（对齐 HTML）；选中/悬停渐变底白�?*/
QLabel#obwMethodIcon {
    background-color: @PRIMARY_BG@;
    border-radius: 12px;
    color: @ACCENT_TEXT@;
    font-size: 19px;
    font-weight: 700;
    border: 1px solid transparent;
}
QPushButton#obwMethodCard:hover QLabel#obwMethodIcon,
QPushButton#obwMethodCard:checked QLabel#obwMethodIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
}
QPushButton#obwMethodCard:hover QLabel#obwMethodCheck {
    background-color: @PRIMARY_BG@;
    color: @ACCENT_TEXT@;
}
QLabel#obwMethodName {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}
QLabel#obwMethodDesc {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodName {
    color: @TEXT_ACCENT@;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodDesc {
    color: @TEXT_PRIMARY@;
}
QLabel#obwMethodTag {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodTag {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY_MEDIUM@;
    color: @ACCENT_TEXT@;
}

/* --- 50.6 提示条 --- */
QLabel#obwTip {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_MEDIUM@;
    border-left: 3px solid @PRIMARY@;
    border-radius: 10px;
    color: @TEXT_ACCENT@;
    font-size: 12px;
    font-weight: 500;
    padding: 10px 14px;
    min-height: 20px;
    max-height: 48px;
}

/* --- 50.7 启动器卡片（Step2 导入�?--- */
QFrame#obwLauncherCard {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
}
QFrame#obwLauncherCard:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwLauncherName {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}
QLabel#obwLauncherAlias {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwLauncherDesc {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}
QFrame#obwLauncherStatusBox {
    background-color: @BG_MUTED@;
    border-radius: 8px;
}
QLabel#obwLauncherStatus {
    color: @TEXT_DISABLED@;
    font-size: 7px;
}
QLabel#obwLauncherStatus[state="found"] {
    color: @SUCCESS@;
}
QLabel#obwLauncherStatus[state="scanning"] {
    color: @WARNING@;
}
QLabel#obwLauncherStatusText {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}
QLabel#obwLauncherStatusText[state="found"] {
    color: @SUCCESS@;
}
QLabel#obwImportedBadge {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY@;
    border-radius: 6px;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 0;
}
/* 卡片里的按钮更紧凑：两张并排才放得下，卡片宽度不会被按钮顶宽 */
QFrame#obwLauncherCard QPushButton#obwBtnPrimary,
QFrame#obwLauncherCard QPushButton#obwBtnSecondary {
    padding: 7px 10px;
    min-width: 0;
    font-size: 12px;
}

/* --- 50.8 通用按钮 --- */
/* 高约 36–38px：圆角必须 ≤ h/2，否则 Qt 不画圆角 */
QPushButton#obwBtnPrimary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1px solid transparent;
    border-radius: 10px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    min-width: 96px;
}
QPushButton#obwBtnPrimary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY_HOVER@, stop:1 @PRIMARY_DARK@);
}
QPushButton#obwBtnPrimary:pressed {
    background-color: @PRIMARY_PRESSED@;
}
QPushButton#obwBtnPrimary:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}
/* 覆盖全局 QPushButton:focus 的 1px 实线边框，避免主按钮焦点时描边跳动 */
QPushButton#obwBtnPrimary:focus {
    border-color: rgba(255, 255, 255, 0.45);
}
QPushButton#obwBtnSecondary {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    font-weight: 500;
    padding: 8px 18px;
    min-width: 88px;
}
QPushButton#obwBtnSecondary:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border-color: @BORDER_STRONG@;
}
QPushButton#obwBtnSecondary:pressed {
    background-color: @BG_PRESSED@;
}
QPushButton#obwBtnSecondary:focus {
    border-color: @PRIMARY@;
    color: @TEXT_ACCENT@;
}

/* --- 50.9 账户管理（Step2 手动�?--- */
QLabel#obwMutedText {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
QLabel#obwEmptyText {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    padding: 20px;
}
QWidget#obwAccountItem, QFrame#obwAccountItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}
QWidget#obwAccountItem:hover, QFrame#obwAccountItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwAccountName {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwAccountMeta {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}
QLabel#obwBadgeDefault {
    background-color: @PRIMARY_BG@;
    border-radius: 10px;
    color: @ACCENT_TEXT@;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QLabel#obwBadgeMs {
    background-color: rgba(59, 130, 246, 0.14);
    border-radius: 10px;
    color: #3B82F6;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QLabel#obwBadgeOff {
    background-color: @BG_MUTED@;
    border-radius: 10px;
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QWidget#obwAccountPanel, QWidget#obwFolderPanel {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}
QPushButton#obwAccountTab {
    background-color: @BG_MUTED@;
    border: 1px solid transparent;
    border-radius: 8px;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
}
QPushButton#obwAccountTab:hover {
    color: @TEXT_PRIMARY@;
}
QPushButton#obwAccountTab:checked {
    background-color: @BG_CARD@;
    color: @TEXT_ACCENT@;
    border: 1px solid @PRIMARY_MEDIUM@;
}
QLabel#obwFieldLabel {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}
QLineEdit#obwInput {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    color: @TEXT_PRIMARY@;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_26@;
    selection-color: @TEXT_PRIMARY@;
}
QLineEdit#obwInput:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_CARD@;
}
QLineEdit#obwInput:focus {
    border-color: @PRIMARY@;
    background-color: @BG_CARD@;
}

/* --- 50.10 Java 管理（Step3）--- */
QScrollArea#obwScroll {
    background-color: transparent;
    border: none;
}
/* 向导内列表滚动条：细轨 + 主色滑块，悬停略加粗 */
QScrollArea#obwScroll > QWidget > QWidget {
    background-color: transparent;
}
QScrollArea#obwScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
    border-radius: 4px;
}
QScrollArea#obwScroll QScrollBar::handle:vertical {
    background-color: @BORDER_STRONG@;
    border-radius: 4px;
    min-height: 28px;
}
QScrollArea#obwScroll QScrollBar::handle:vertical:hover {
    background-color: @PRIMARY_MEDIUM@;
}
QScrollArea#obwScroll QScrollBar::add-line:vertical,
QScrollArea#obwScroll QScrollBar::sub-line:vertical,
QScrollArea#obwScroll QScrollBar::add-page:vertical,
QScrollArea#obwScroll QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}
QWidget#obwJavaItem, QFrame#obwJavaItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}
QWidget#obwJavaItem:hover, QFrame#obwJavaItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwJavaIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F97316, stop:1 #C2410C);
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 17px;
}
QLabel#obwJavaVer {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwJavaPath {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}
QFrame#obwDlCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}
QFrame#obwDlCard:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwDlVer {
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
}
QLabel#obwDlTag {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwDlSize {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
/* Java 下载状态提示：在向导内比全局 hintLabel 略强调一档 */
QFrame#OnboardingWizardCard QLabel#hintLabel {
    color: @TEXT_SECONDARY@;
    font-weight: 500;
    padding: 6px 0 2px 0;
}

/* Java 列表路径：中间省略 + 更舒适的行高 */
QFrame#OnboardingWizardCard QLabel#obwJavaPath {
    padding-top: 1px;
}

/* Java 空状态：虚线框，与列表卡片层次分明 */
QFrame#OnboardingWizardCard QLabel#obwEmptyText {
    background-color: transparent;
    border: 1px dashed @BORDER_DASHED@;
    border-radius: 12px;
    padding: 28px 20px;
    margin: 4px 2px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}

/* 下载卡片：悬停时主色描边 + 按钮更醒目 */
QFrame#obwDlCard:hover {
    border-color: @PRIMARY_RGBA_38@;
}
QFrame#obwDlCard QLabel#obwDlTag {
    color: @TEXT_SECONDARY@;
}
QFrame#obwDlCard QLabel#obwDlSize {
    color: @TEXT_TERTIARY@;
    padding-bottom: 4px;
}

/* --- 50.11 实例文件夹（Step4�?--- */
QWidget#obwFolderItem, QFrame#obwFolderItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}
QWidget#obwFolderItem:hover, QFrame#obwFolderItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QWidget#obwFolderItem[state="default"], QFrame#obwFolderItem[state="default"] {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#obwFolderIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FBBF24, stop:1 #D97706);
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 15px;
}
QLabel#obwFolderName {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwFolderPath {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}

/* --- 50.12 样式设置（Step5�?--- */
QFrame#obwStyleBlock {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}
QLabel#obwStyleBlockTitle {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#obwThemeCard {
    background-color: @BG_MUTED@;
    border: 1.5px solid @BORDER@;
    border-radius: 12px;
    min-height: 112px;
    max-height: 120px;
    padding: 0;
}
QPushButton#obwThemeCard:hover {
    border-color: @PRIMARY_RGBA_102@;
    background-color: @BG_HOVER@;
}
QPushButton#obwThemeCard:pressed {
    background-color: @BG_PRESSED@;
}
QPushButton#obwThemeCard:checked {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY@;
}
QPushButton#obwThemeCard:focus {
    border-color: @PRIMARY_MEDIUM@;
}
QWidget#obwThemePreview {
    background-color: #F8FAFC;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    min-height: 72px;
    max-height: 72px;
}
QWidget#obwThemePreview[mode="dark"] {
    background-color: #0F172A;
    border: 1px solid rgba(255,255,255,0.08);
}
QLabel#obwPreviewDot {
    background-color: #64748B;
    border-radius: 4px;
    min-width: 9px; min-height: 9px;
}
QLabel#obwPreviewSide {
    background-color: #CBD5E1;
    border-radius: 3px;
}
QWidget#obwThemePreview[mode="dark"] QLabel#obwPreviewSide {
    background-color: #1E293B;
}
QLabel#obwPreviewLine {
    background-color: #94A3B8;
    border-radius: 3px;
    min-height: 10px;
}
QWidget#obwThemePreview[mode="dark"] QLabel#obwPreviewLine {
    background-color: #475569;
}
QLabel#obwPreviewAccent {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 3px;
}
QLabel#obwThemeCardLabel {
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    font-weight: 600;
}
QPushButton#obwThemeCard:checked QLabel#obwThemeCardLabel {
    color: @ACCENT_TEXT@;
}
/* 背景模式 tab：经典 / 纯色 / 图片 / 流光 / 旋转 */
QPushButton#obwBgModeBtn {
    background-color: @BG_MUTED@;
    border: 1.5px solid @BORDER@;
    border-radius: 10px;
    color: transparent;
    padding: 0;
}
QPushButton#obwBgModeBtn:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QPushButton#obwBgModeBtn:checked {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#obwBgModeIcon {
    color: @TEXT_TERTIARY@;
    font-size: 15px;
    font-weight: 700;
}
QPushButton#obwBgModeBtn:hover QLabel#obwBgModeIcon,
QPushButton#obwBgModeBtn:checked QLabel#obwBgModeIcon {
    color: @ACCENT_TEXT@;
}
QLabel#obwBgModeName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#obwBgModeBtn:checked QLabel#obwBgModeName {
    color: @TEXT_ACCENT@;
}
QLabel#obwBgModeHint {
    color: @TEXT_TERTIARY@;
    font-size: 10px;
}
QStackedWidget#obwBgSubStack {
    background-color: transparent;
}
QLabel#obwBgSubDesc {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
/* 纯色 / 强调色色块：底色与选中描边由代码内联控制；悬停在此统一给 */
QPushButton#obwColorSwatch {
    border-radius: 14px;
    border: 2px solid transparent;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}
QPushButton#obwColorSwatch:hover {
    border: 2px solid rgba(255, 255, 255, 0.55);
}
QPushButton#obwAccentSwatch {
    border-radius: 16px;
    border: 2px solid transparent;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
}
QPushButton#obwAccentSwatch:hover {
    border: 2px solid rgba(255, 255, 255, 0.55);
}
QLabel#obwImagePreview {
    background-color: @BG_MUTED@;
    border: 1px dashed @BORDER_STRONG@;
    border-radius: 8px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwBgPathLabel {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwAccentName {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}

/* --- 50.13 完成页 --- */
/* 外圈光环 104x104：圆角 = 边长一半 */
QWidget#obwDoneHalo {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_MEDIUM@;
    border-radius: 52px;
}
QLabel#obwDoneIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1px solid transparent;
    /* 80x80：圆角 = 40 */
    border-radius: 40px;
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 800;
}
QLabel#obwDoneTitle {
    color: @TEXT_PRIMARY@;
    font-size: 24px;
    font-weight: 800;
}
QLabel#obwDoneDesc {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}
QLabel#obwDoneChip {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_MEDIUM@;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
}

/* --- 50.14 底部导航 --- */
QFrame#obwFooter {
    background-color: transparent;
    border-top: 1px solid @BORDER@;
}
QLabel#obwFooterHint {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
QFrame#obwFooter QPushButton#obwBtnPrimary {
    min-width: 104px;
    padding: 8px 22px;
}
QFrame#obwFooter QPushButton#obwBtnSecondary {
    min-width: 88px;
    padding: 8px 18px;
}

