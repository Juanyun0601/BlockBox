}

/* ============================================================
 * Section 33. InstanceResourcesPage / InstanceFilePage / LaunchDetailsPage 样式
 * ============================================================ */
/* 资源 Tab �?�?透明 */
QWidget#resourcesTabBar {
    background-color: transparent;
    border: none;
}

/* 资源 Tab 高亮�?�?3px 主色 */
QWidget#resourcesTabHighlight {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 0 3px 3px 0;
    min-width: 3px;
    max-width: 3px;
}

/* 资源 Tab 按钮 */
QPushButton#resourcesTabBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#resourcesTabBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#resourcesTabBtn:checked {
    background-color: @PRIMARY_RGBA_20@;
    color: @PRIMARY@;
    font-weight: 600;
}

/* 文件更新芯片 �?警告�?*/
QLabel#fileUpdateChip {
    background-color: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* 未保存更改栏 �?警告色背�?*/
QWidget#unsavedChangesBar {
    background-color: @WARNING_BG@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 8px;
    padding: 10px 14px;
}

/* 未保存更改标�?*/
QLabel#unsavedChangesLabel {
    background-color: transparent;
    color: @WARNING_TEXT@;
    font-size: 13px;
    border: none;
}

/* 保存按钮 �?主色渐变 */
QPushButton#saveButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#saveButton:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#saveButton:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* 加载器状态标�?*/
QLabel#loaderStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* 状态点 �?8x8 圆形 running=主色 */
QWidget#statusDot {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
}

QWidget#statusDot[status="idle"] {
    background-color: @TEXT_TERTIARY@;
}

QWidget#statusDot[status="error"] {
    background-color: @DANGER@;
}

/* 日志状态标�?*/
QLabel#logStatusLabel {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* 取消启动按钮 �?危险色边�?*/
QPushButton#cancelLaunchBtn {
    background-color: transparent;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @DANGER@;
    font-size: 13px;
}

QPushButton#cancelLaunchBtn:hover {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER@;
}

/* 清除日志按钮 �?玻璃�?*/
QPushButton#clearLogBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#clearLogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 导出日志按钮 */
QPushButton#exportLogBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#exportLogBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* ============================================================
 * Section 34. SettingsPage 子页面样�?
 * ============================================================ */
/* 设置内容堆栈 */
QStackedWidget#settingsContentStack {
    background-color: transparent;
    border: none;
}

/* 设置卡片 �?白色圆角容器（对应原�?.settings-card�?*/
QFrame#settingsCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-bottom: 12px;
}

/* 设置页标题栏卡片 �?标题 + 恢复默认值按钮 */
QFrame#settingsHeaderCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    margin-bottom: 12px;
}

/* 卡片内标题重置外边距（去掉全局 sectionTitle 的底部留白） */
QFrame#settingsHeaderCard QLabel#sectionTitle {
    margin: 0px;
    padding: 0px;
    border: none;
    background-color: transparent;
}

/* 设置分区标题�?�?可点击的折叠/展开按钮（CollapsibleSectionCard�?*/
QPushButton#settingsSectionHeader {
    background-color: transparent;
    border: none;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 14px 24px;
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
    text-align: left;
}

QPushButton#settingsSectionHeader:hover {
    background-color: @BG_HOVER@;
}

QPushButton#settingsSectionHeader:pressed {
    background-color: @BG_PRESSED@;
}

/* 展开状态下标题栏底部显示分隔线 */
QPushButton#settingsSectionHeader:checked {
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* 设置信息�?�?对应原型 .setting-row */
QFrame#settingRow,
QWidget#settingRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QFrame#settingRow[lastRow="true"],
QWidget#settingRow[lastRow="true"] {
    border-bottom: none;
}

/* 设置信息包装 �?必须透明，否则继承全局 QWidget 背景覆盖白色卡片 */
QWidget#settingInfo {
    background-color: transparent;
    border: none;
}

/* 设置行标�?�?对应原型 .setting-info label�?3px 600�?*/
QLabel#settingTitle {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

/* 设置行描�?�?对应原型 .setting-info p�?2px 三级灰） */
QLabel#settingDesc {
    background-color: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

/* 设置行值标�?�?滑块等控件旁边的数�?*/
QLabel#settingValueLabel {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    min-width: 48px;
}

/* 设置行警告标�?�?超标提示 */
QLabel#settingWarningLabel {
    background-color: transparent;
    border: none;
    color: @DANGER@;
    font-size: 11px;
}

/* JVM参数预设下拉框 */
QComboBox#jvmPresetCombo {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 120px;
}

QComboBox#jvmPresetCombo:hover {
    border-color: @BORDER_STRONG@;
}

QComboBox#jvmPresetCombo:focus {
    border: 2px solid @PRIMARY@;
    padding: 5px 11px;
}

QComboBox#jvmPresetCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox#jvmPresetCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_TERTIARY@;
    width: 0;
    height: 0;
}

QComboBox#jvmPresetCombo QAbstractItemView {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
    padding: 4px;
}

/* JVM参数编辑框 */
QTextEdit#jvmParamsEdit {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 13px;
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    line-height: 1.5;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QTextEdit#jvmParamsEdit:hover {
    border-color: @BORDER_STRONG@;
}

QTextEdit#jvmParamsEdit:focus {
    border: 2px solid @PRIMARY@;
    padding: 9px 13px;
}

QTextEdit#jvmParamsEdit::placeholder {
    color: @TEXT_DISABLED@;
}

/* 颜色选择/调色板按�?�?玻璃�?*/
QPushButton#colorPickerBtn,
QPushButton#paletteBtn,
QPushButton#bgColorBtn,
QPushButton#bgPaletteBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#colorPickerBtn:hover,
QPushButton#paletteBtn:hover,
QPushButton#bgColorBtn:hover,
QPushButton#bgPaletteBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

/* 收藏夹页 �?工具按钮（替代先前内联硬编码 #ffffff，深色主题可正常适配�?*/
QPushButton#favManageBtn {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#favManageBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#favManageBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 收藏夹页 �?刷新按钮�?4x34 圆角图标按钮�?*/
QPushButton#favRefreshBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0;
}

QPushButton#favRefreshBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QPushButton#favRefreshBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 子导航头 �?收起按钮�?4x24 纯图标按钮）
 * 防止通用 QPushButton �?8x16 padding/1px 边框挤偏 chevron 图标 */
QPushButton#subNavCollapseBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    color: @TEXT_TERTIARY@;
}

QPushButton#subNavCollapseBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#subNavCollapseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* Java 下载�?�?圆形返回按钮�?8x28，单字符 "�?�?*/
QPushButton#javaDownloadBackBtn {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    padding: 0;
    color: @TEXT_TERTIARY@;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#javaDownloadBackBtn:hover {
    background-color: @BG_HOVER@;
    color: @PRIMARY@;
}

QPushButton#javaDownloadBackBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 背景模糊滑块 */
QSlider#bgBlurSlider::groove:horizontal {
    height: 4px;
    background-color: transparent;
    border: none;
    border-radius: 999px;
}

QSlider#bgBlurSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 999px;
}

QSlider#bgBlurSlider::handle:horizontal {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 @PRIMARY@,
        stop:0.6 @PRIMARY@,
        stop:0.8 @PRIMARY_RGBA_38@,
        stop:1 @PRIMARY_RGBA_8@);
    border: none;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    margin: -8px 0;
}

/* 快捷键名称标�?�?13px 600字重 */
QLabel#keyBindNameLabel {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* 快捷键按键标�?�?12px Consolas */
QLabel#keyBindKeyLabel {
    background-color: @BG_MUTED@;
