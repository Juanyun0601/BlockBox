/* ============================================================
 * 翻译功能样式 (Translation Feature Styles)
 * ============================================================ */

/* 在线资源详情页右下角悬浮翻译卡片（EN 原文 / 中 AI 翻译） */
QWidget#contentTranslateCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

QLabel#contentTranslateStatus {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    border: none;
    font-size: 11px;
    padding: 0 6px;
}

QPushButton#contentTranslateEnBtn,
QPushButton#contentTranslateZhBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 14px;
    min-width: 36px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#contentTranslateEnBtn:hover,
QPushButton#contentTranslateZhBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#contentTranslateEnBtn:checked,
QPushButton#contentTranslateZhBtn:checked {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#contentTranslateZhBtn:checked:disabled {
    background-color: @PRIMARY_MEDIUM@;
    color: @TEXT_ON_PRIMARY@;
}

/* 详情页翻译按钮 */
QPushButton#modDetailTranslateBtn {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#modDetailTranslateBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY_RGBA_40@;
}
QPushButton#modDetailTranslateBtn:pressed {
    background-color: @PRIMARY_RGBA_30@;
}
QPushButton#modDetailTranslateBtn:disabled {
    background-color: @BG_SECONDARY@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DEFAULT@;
}

/* 详情页翻译设置按钮 */
QPushButton#modDetailTranslateSettingsBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#modDetailTranslateSettingsBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 翻译设置对话框 */
QWidget#translationSettingsCard {
    background-color: @BG_CARD@;
    border-radius: 16px;
    border: 1px solid @BORDER_DEFAULT@;
}

QLabel#translationSettingsTitle {
    font-size: 18px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
    border: none;
}

QPushButton#translationSettingsCloseBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 4px;
    font-size: 16px;
}
QPushButton#translationSettingsCloseBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 翻译源选择器 */
QWidget#translationSourceSelector {
    background-color: @BG_SECONDARY@;
    border-radius: 12px;
    padding: 4px;
}

QPushButton#translationSourceBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#translationSourceBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}
QPushButton#translationSourceBtn:checked {
    background-color: @PRIMARY_RGBA_15@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

/* 翻译设置输入框 */
QLabel#translationDesc {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

QLabel#translationFieldLabel {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 500;
    background-color: transparent;
    border: none;
}

QLineEdit#translationInput {
    background-color: @BG_SECONDARY@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_40@;
}
QLineEdit#translationInput:focus {
    border-color: @PRIMARY@;
}
QLineEdit#translationInput::placeholder {
    color: @TEXT_TERTIARY@;
}

/* 翻译设置里的模型下拉（可编辑，与输入框同观感） */
QComboBox#translationInput {
    background-color: @BG_SECONDARY@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_40@;
}
QComboBox#translationInput:focus {
    border-color: @PRIMARY@;
}
QComboBox#translationInput::drop-down {
    border: none;
    width: 28px;
    background: transparent;
}
QComboBox#translationInput::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 8px;
    border: none;
    margin-right: 8px;
}
QComboBox#translationInput QAbstractItemView {
    background-color: @BG_SECONDARY@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    selection-background-color: @PRIMARY_RGBA_40@;
    outline: none;
}

/* DeepL 类型选择按钮 */
QPushButton#translationTypeBtn {
    background-color: @BG_SECONDARY@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
}
QPushButton#translationTypeBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY_RGBA_26@;
}
QPushButton#translationTypeBtn:checked {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border-color: @PRIMARY_RGBA_40@;
    font-weight: 600;
}

/* 测试翻译区域 */
QWidget#translationTestSection {
    background-color: @BG_SECONDARY@;
    border-radius: 12px;
    padding: 10px;
}

QLabel#translationTestTitle {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QLineEdit#translationTestInput {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton#translationTestBtn {
    background-color: @PRIMARY_RGBA_12@;
    color: @ACCENT_TEXT@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 8px;
    padding: 5px 16px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#translationTestBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
}
QPushButton#translationTestBtn:disabled {
    background-color: @BG_SECONDARY@;
    color: @TEXT_DISABLED@;
}

QLabel#translationTestResult {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background-color: @BG_CARD@;
    border-radius: 8px;
    padding: 8px 10px;
    border: 1px solid @BORDER_DEFAULT@;
}

/* 保存按钮 */
QPushButton#translationSaveBtn {
    background-color: @PRIMARY@;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#translationSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}
QPushButton#translationSaveBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* ===== Section 49: AI 助手设置页服务商列表 ===== */
QListWidget#providerList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#providerList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#providerList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#providerList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QListWidget#providerModelList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#providerModelList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#providerModelList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#providerModelList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QListWidget#customModelsList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#customModelsList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#customModelsList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#customModelsList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}


/* ===== Section 51: WorldMapPage 存档地表地图页 ===== */

/* 顶部地图操作区 —— 玻璃态卡片，内部按「标题块 │ 渲染 │ 视图 │ 定位」分组 */
QWidget#worldMapToolbar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

/* —— 标题块：图标 + 存档名 / 副标题 —— */
QLabel#worldMapTitleIcon {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
}

QLabel#worldMapTitle {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QLabel#worldMapSubtitle {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

/* —— 分组竖分隔线（C++ 侧是 1px 宽的 QFrame） —— */
QFrame#worldMapToolSep {
    background-color: @BLACK_RGBA_0.12@;
    max-width: 1px;
    max-height: 28px;
    border: none;
}

/* —— 功能分组容器：淡底圆角，把同类控件收在一起 —— */
QWidget#worldMapToolGroup {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
}

/* —— 组内扁平下拉（透明底，靠 hover / :on 反馈） —— */
QComboBox#worldMapToolCombo {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 2px 6px 2px 8px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    min-width: 66px;
}

QComboBox#worldMapToolCombo:hover {
    background-color: @BG_CARD@;
}

QComboBox#worldMapToolCombo:on {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
}

QComboBox#worldMapToolCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 20px;
    margin-right: 4px;
}

QComboBox#worldMapToolCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 8px;
    border: none;
}

QComboBox#worldMapToolCombo:hover::down-arrow {
    border-top-color: @PRIMARY@;
}

QComboBox#worldMapToolCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_PRIMARY@;
}

/* —— 高度选择框可编辑：框内输入框与下拉同风格（透明，随外框 hover/focus） —— */
QComboBox#worldMapToolCombo QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_PRIMARY@;
}

QComboBox#worldMapToolCombo QLineEdit:focus {
    background: transparent;
    border: none;
}
/* —— 组内扁平按钮 —— */
QPushButton#worldMapGroupBtn {
    background-color: transparent;
    border: none;
    border-radius: 7px;
    padding: 4px 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#worldMapGroupBtn:hover {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
}

QPushButton#worldMapGroupBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#worldMapGroupBtn:checked {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}

/* —— 右侧输出动作按钮（带框，与组内扁平控件区分） —— */
QPushButton#worldMapActionBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#worldMapActionBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#worldMapActionBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#worldMapActionBtn:disabled {
    background-color: @BG_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}
/* —— 组内缩放比例读数 —— */
QLabel#worldMapToolLabel {
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

/* —— 第二行：结构开关（图标 + 可勾选，默认全选） — */
QPushButton#worldMapStructBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 7px;
    padding: 0px;
    color: @TEXT_SECONDARY@;
}


QPushButton#worldMapStructBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
}


QPushButton#worldMapStructBtn:pressed {
    background-color: @BG_PRESSED@;
}


QPushButton#worldMapStructBtn:checked {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY@;
}

QPushButton#worldMapStructBtn:disabled {
    background-color: @BG_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* —— 结构条檮动容器 — */
QScrollArea#worldMapStructScroll {
    background: transparent;
    border: none;
}


QScrollArea#worldMapStructScroll > QWidget > QWidget {
    background: transparent;
}


QScrollArea#worldMapStructScroll QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}


QScrollArea#worldMapStructScroll QScrollBar::handle:horizontal {
    background: @BORDER@;
    border-radius: 4px;
    min-width: 32px;
}


QScrollArea#worldMapStructScroll QScrollBar::handle:horizontal:hover {
    background: @BORDER_STRONG@;
}


QScrollArea#worldMapStructScroll QScrollBar::add-line:horizontal,
QScrollArea#worldMapStructScroll QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}


QScrollArea#worldMapStructScroll QScrollBar::add-page:horizontal,
QScrollArea#worldMapStructScroll QScrollBar::sub-page:horizontal {
    background: transparent;
}



/* —— 结构信息弹窗 — */
/* 外层是透明无边框窗口（只负责定位与点外部关闭），圆角卡片在 #worldMapStructCard 上 */
QWidget#worldMapStructPopup {
    background: transparent;
    border: none;
}


QWidget#worldMapStructCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}


QLabel#worldMapStructTitle {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}


QLabel#worldMapStructCoord {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}


QPushButton#worldMapStructAction {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER@;
    border-radius: 7px;
    padding: 4px 10px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
}


QPushButton#worldMapStructAction:hover {
    background-color: @BG_PRESSED@;
    border: 1px solid @BORDER_STRONG@;
}


QPushButton#worldMapStructAction:pressed {
    background-color: @BG_DISABLED@;
}


/* 小窗里的「详情」按钮：主色高亮，和其余动作按钮区分开 */
QPushButton#worldMapStructDetail {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 7px;
    padding: 4px 12px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}


QPushButton#worldMapStructDetail:hover {
    background-color: @PRIMARY_HOVER@;
}


QPushButton#worldMapStructDetail:pressed {
    background-color: @PRIMARY_DARK@;
}


/* —— 结构详情弹窗（小窗「详情」） —— */
QWidget#structDetailCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

/* 全屏预览时卡片铺满整个窗口，圆角与描边一起去掉，才像整屏画面 */
QWidget#structDetailCard[fs="true"] {
    border: none;
    border-radius: 0;
}


QLabel#structDetailTitle {
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    border: none;
}


QTabWidget#structDetailTabs::pane {
    border: 1px solid @BORDER@;
    border-radius: 12px;
    background-color: @BG_CARD@;
}


QWidget#structDetailPage {
    background-color: transparent;
    border: none;
}


QWidget#structDetailPreviewPage {
    background-color: transparent;
    border: none;
}

QLabel#structPreviewVariant {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#structPreviewStats {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#structPreviewHint {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
}

/* —— 结构详情：预览页层数条 —— */
QWidget#structPreviewLayerBar {
    background: transparent;
    border: none;
}

QLabel#structPreviewLayerLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#structPreviewLayerValue {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 层数步进的方形按钮：用 QToolButton，避免命中
   「QDialog QPushButton { min-width: 80px }」被拉成长条；
   min/max 也写死一层，防止别的规则再来改尺寸 */
QToolButton#structPreviewStepBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    font-size: 14px;
    padding: 0;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QToolButton#structPreviewStepBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QToolButton#structPreviewStepBtn:pressed {
    background-color: @BG_PRESSED@;
}

QToolButton#structPreviewStepBtn:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

/* 滑块其余部分沿用全局 QSlider 样式，这里只给凹槽一条可见的底色 */
QSlider#structPreviewLayerSlider::groove:horizontal {
    height: 4px;
    background-color: @BORDER@;
    border: none;
    border-radius: 2px;
}

/* 聚焦时全局样式会给凹槽套一圈主题色边框，在这条细轨上显得像个框，改淡一点 */
QSlider#structPreviewLayerSlider:focus::groove {
    border: 1px solid @BORDER_STRONG@;
    border-radius: 2px;
}

QToolButton#structPreviewBelowToggle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
}

QToolButton#structPreviewBelowToggle:hover {
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
    background-color: @BG_HOVER@;
}

QToolButton#structPreviewBelowToggle:checked {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QToolButton#structPreviewBelowToggle:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

/* 预览页「高亮藏宝箱」：选中时用琥珀色，和层数控制区分开 */
QToolButton#structPreviewChestToggle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
}

QToolButton#structPreviewChestToggle:hover {
    border-color: @WARNING@;
    color: @WARNING_TEXT_DARK@;
    background-color: @WARNING_RGBA_26@;
}

QToolButton#structPreviewChestToggle:checked {
    background-color: @WARNING_RGBA_26@;
    border-color: @WARNING@;
    color: @WARNING_TEXT_DARK@;
}

QToolButton#structPreviewChestToggle:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

/* 预览页「全屏」：实心主色小按钮，和上面几个描边开关区分开 */
QToolButton#structPreviewFullscreenBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QToolButton#structPreviewFullscreenBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QToolButton#structPreviewFullscreenBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

QToolButton#structPreviewFullscreenBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 全屏预览时卡片铺满窗口，标题行整个藏起来 */
QWidget#structDetailTitleBar {
    background: transparent;
    border: none;
}


/* —— 结构详情：简介页信息 —— */
QLabel#structDetailRareChip {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    background-clip: padding-box;
}


QLabel#structDetailIntroSection {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
}


QLabel#structDetailIntroKey {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}


QLabel#structDetailIntroValue {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    background: transparent;
    border: none;
}


QLabel#structDetailLootSection {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
    margin-top: 10px;
}


QWidget#structDetailLootWrap {
    background: transparent;
    border: none;
}


QWidget#structDetailLootCats {
    background: transparent;
    border: none;
}


QPushButton#structDetailLootCat {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    color: @TEXT_TERTIARY@;
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 500;
}


QPushButton#structDetailLootCat:hover {
    border-color: @PRIMARY@;
    color: @TEXT_PRIMARY@;
}


QPushButton#structDetailLootCat:checked {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}


QWidget#structDetailLootChip {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}


QLabel#structDetailLootName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}


QLabel#structDetailLootIcon {
    background: transparent;
    border: none;
}


QLabel#structDetailLootNote {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
    margin-top: 4px;
}


QLabel#structDetailLootMeta {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
    margin-top: 2px;
}



/* 战利品预测页滚动区（条目多时滚动查看） */
QScrollArea#structDetailLootScroll {
    background-color: transparent;
    border: none;
}

QScrollArea#structDetailLootScroll > QWidget > QWidget {
    background-color: transparent;
}
/* 战利品预测：口径说明 / 汇总 / 概率标签 / 必出高亮 */
QLabel#structDetailLootHint {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
    margin-top: 2px;
}

QLabel#structDetailLootSummary {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
    margin-top: 6px;
}

QLabel#structDetailLootChance {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
}

QLabel#structDetailLootChance[guaranteed="true"] {
    color: @ACCENT_TEXT@;
    font-weight: 700;
}

QWidget#structDetailLootChip[guaranteed="true"] {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY@;
}
QLabel#structDetailLootEmpty {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    background: transparent;
    border: none;
}


QFrame#structDetailIntroSep {
    color: @BORDER@;
    background: transparent;
    border: none;
    margin-top: 8px;
    margin-bottom: 4px;
}


QLabel#structDetailIntroTip {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}


QPushButton#structDetailWikiBtn {
    background-color: @BG_MUTED@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 12px;
}


QPushButton#structDetailWikiBtn:hover {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    border-color: @PRIMARY@;
}


/* —— 内容浏览弹窗（第二行「展开」） —— */
QWidget#worldMapContentPopup {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 16px;
}

QLineEdit#worldMapPopupSearch {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 12px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}

QLineEdit#worldMapPopupSearch:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

QLabel#worldMapPopupColTitle {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    border: none;
    border-left: 3px solid @PRIMARY@;
    border-radius: 1px;
    padding: 1px 0 1px 8px;
}

QLabel#worldMapPopupHint {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
    border-top: 1px solid @BORDER_LIGHT@;
    padding-top: 7px;
}

/* 矿物列下方的扫描说明：比列标题更淡，不抢矿物名的视线 */
QLabel#worldMapPopupOreHint {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 0;
}

QPushButton#worldMapPopupClose {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 16px;
    padding: 0;
}

QPushButton#worldMapPopupClose:hover {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
}

QPushButton#worldMapPopupClose:pressed {
    background-color: @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

QPushButton#worldMapPopupStructAll,
QPushButton#worldMapPopupStructClear,
QPushButton#worldMapPopupBiomeAll,
QPushButton#worldMapPopupBiomeClear,
QPushButton#worldMapPopupOreAll,
QPushButton#worldMapPopupOreClear {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 3px 11px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#worldMapPopupStructAll:hover,
QPushButton#worldMapPopupStructClear:hover,
QPushButton#worldMapPopupBiomeAll:hover,
QPushButton#worldMapPopupBiomeClear:hover,
QPushButton#worldMapPopupOreAll:hover,
QPushButton#worldMapPopupOreClear:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#worldMapPopupStructAll:pressed,
QPushButton#worldMapPopupStructClear:pressed,
QPushButton#worldMapPopupBiomeAll:pressed,
QPushButton#worldMapPopupBiomeClear:pressed,
QPushButton#worldMapPopupOreAll:pressed,
QPushButton#worldMapPopupOreClear:pressed {
    background-color: @BG_PRESSED@;
    border: 1px solid @BORDER_HOVER@;
}


/* —— 标记点编辑弹窗（右键「添加标记点」） —— */
QWidget#worldMapMarkerEditPopup {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 16px;
}

/* 关闭 ×：与内容弹窗的关闭按钮同款 */
QPushButton#worldMapMarkerEditClose {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 16px;
    padding: 0;
}

QPushButton#worldMapMarkerEditClose:hover {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
}

QPushButton#worldMapMarkerEditClose:pressed {
    background-color: @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

QLabel#worldMapMarkerTitle {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
    border: none;
}

/* 坐标输入框：与坐标跳转输入框同款 */
QLineEdit#worldMapMarkerCoordEdit {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 3px 8px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}

QLineEdit#worldMapMarkerCoordEdit:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 名称输入框：与内容弹窗搜索框同款观感 */
QLineEdit#worldMapMarkerEdit {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 7px 12px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}

QLineEdit#worldMapMarkerEdit:focus {
    border: 1px solid @PRIMARY@;
    background-color: @BG_CARD@;
}

/* 图标预设按钮：选中态用主色描边圈出来 */
QPushButton#worldMapMarkerIconBtn {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    padding: 0;
}

QPushButton#worldMapMarkerIconBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
}

QPushButton#worldMapMarkerIconBtn:checked {
    background-color: @PRIMARY_BG@;
    border: 2px solid @PRIMARY@;
}

/* 底部「取消」：普通描边按钮 */
QPushButton#worldMapMarkerCancel {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
}

QPushButton#worldMapMarkerCancel:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
}

QPushButton#worldMapMarkerCancel:pressed {
    background-color: @BG_PRESSED@;
}

/* 底部「保存」：主色高亮（与结构小窗「详情」同款） */
QPushButton#worldMapMarkerSave {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 8px;
    padding: 5px 16px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#worldMapMarkerSave:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#worldMapMarkerSave:pressed {
    background-color: @PRIMARY_DARK@;
}

/* 底部「删除」（仅编辑已有标记时出现）：红色警示但不抢保存的戏 */
QPushButton#worldMapMarkerDelete {
    background-color: transparent;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 8px;
    padding: 5px 14px;
    color: @DANGER_TEXT@;
    font-size: 12px;
}

QPushButton#worldMapMarkerDelete:hover {
    background-color: @DANGER_BG@;
}

QPushButton#worldMapMarkerDelete:pressed {
    background-color: @DANGER_BORDER@;
}

QListWidget#worldMapPopupList {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 2px;
    outline: none;
}

/* 列表项只负责行高，内边距清零：胶囊才能贴住行边界，悬停底色也交给行内胶囊 */
QListWidget#worldMapPopupList::item,
QListWidget#worldMapPopupList::item:hover,
QListWidget#worldMapPopupList::item:selected {
    height: 48px;
    padding: 0;
    margin: 0;
    background-color: transparent;
}

/* —— 选项行：只画行间分隔线，底色交给行内胶囊 —— */
QWidget#worldMapPopupRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

/* —— 行内胶囊：把图标、名称和右侧定位按钮一起包住；与行边界只留很小距离 —— */
QWidget#worldMapPopupRowBox {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
}

QWidget#worldMapPopupRowBox:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER@;
}

QWidget#worldMapPopupRowBox[checked="true"] {
    background-color: @PRIMARY_RGBA_12@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QWidget#worldMapPopupRowBox[checked="true"]:hover {
    background-color: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY@;
}

/* 暂不支持定位的结构条目：不显示勾选底色，保持通透 */
QWidget#worldMapPopupRowBox[checked="true"][supported="false"] {
    background-color: transparent;
    border: 1px solid transparent;
}

/* —— 条目名称：只有文字随勾选变色加粗，底色由外层胶囊承担 —— */
QPushButton#worldMapPopupToggle {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px 8px;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 400;
    text-align: left;
}

QPushButton#worldMapPopupToggle:checked {
    color: @TEXT_ACCENT@;
    font-weight: 600;
}

QPushButton#worldMapPopupToggle:disabled {
    color: @TEXT_DISABLED@;
    font-weight: 400;
}

QPushButton#worldMapPopupToggle:checked:disabled {
    color: @TEXT_DISABLED@;
    font-weight: 400;
}

QPushButton#worldMapPopupHighlight {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 13px;
}

QPushButton#worldMapPopupHighlight:hover {
    background-color: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QPushButton#worldMapPopupHighlight:pressed {
    background-color: @PRIMARY_RGBA_38@;
    border: 1px solid @PRIMARY@;
}

QPushButton#worldMapPopupHighlight:disabled {
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#worldMapExpandBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 7px;
    padding: 4px 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#worldMapExpandBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#worldMapExpandBtn:checked {
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
}



/* —— 组内坐标输入（focus 主色描边，边框盒不位移） —— */
QLineEdit#worldMapCoordEdit {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px 6px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
}

QLineEdit#worldMapCoordEdit:hover {
    background-color: @BG_CARD@;
}

QLineEdit#worldMapCoordEdit:focus {
    background-color: @BG_CARD@;
    border: 1px solid @PRIMARY@;
}
/* —— 中间地图空态：与地图视图同款圆角不透卡片 —— */
QWidget#worldMapEmptyPage {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QLabel#worldMapEmpty {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    padding: 24px;
    background: transparent;
    border: none;
}

QWidget#worldMapStatusBar {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QLabel#worldMapStatus {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QLabel#worldMapBiome {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 3px 10px;
}

QProgressBar#worldMapProgress {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 4px;
}

QProgressBar#worldMapProgress::chunk {
    background-color: @PRIMARY@;
    border-radius: 4px;
}

/* ============================================================
 * Section 51. ModpackExportPage 样式（mpx* 系列，实例管理>导出整合包）
 * ============================================================ */
/* 步骤条容器 */
QWidget#mpxStepper {
    background-color: transparent;
    border: none;
}
QWidget#mpxStepNode {
    background-color: transparent;
    border: none;
}
QLabel#mpxStepDot {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER_STRONG@;
    border-radius: 15px;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 700;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}
QLabel#mpxStepDot[stepState="active"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 1.5px solid transparent;
    color: @TEXT_ON_PRIMARY@;
}
QLabel#mpxStepDot[stepState="done"] {
    background-color: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
    color: @ACCENT_TEXT@;
}
QLabel#mpxStepLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: none;
}
QLabel#mpxStepLabel[stepState="active"] {
    color: @TEXT_PRIMARY@;
}
QFrame#mpxStepLine {
    background-color: @BORDER_STRONG@;
    border: none;
    max-height: 2px;
    min-height: 2px;
}
QFrame#mpxStepLine[stepState="done"] {
    background-color: @PRIMARY@;
}

/* 步骤内标题 / 说明 */
QLabel#mpxSectionTitle {
    color: @TEXT_PRIMARY@;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
    border: none;
}
QLabel#mpxSectionDesc {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 格式选择卡片 */
QPushButton#mpxFormatCard {
    text-align: left;
    padding: 14px 16px;
    border: 1.5px solid @BORDER@;
    border-radius: 12px;
    background-color: @BG_CARD@;
}
QPushButton#mpxFormatCard:hover {
    border: 1.5px solid @PRIMARY@;
    background-color: @BG_HOVER@;
}
QPushButton#mpxFormatCard:checked {
    border: 1.5px solid @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QPushButton#mpxFormatCard QLabel {
    background: transparent;
    border: none;
}
QLabel#mpxFormatTitle {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
    border: none;
}
QPushButton#mpxFormatCard:checked QLabel#mpxFormatTitle {
    color: @ACCENT_TEXT@;
}
QLabel#mpxFormatDesc {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}
QLabel#mpxFormatOutput {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
}
QLabel#mpxFormatCheck {
    color: @ACCENT_TEXT@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
}

/* 信息表单字段 */
QLabel#mpxFieldLabel {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    background: transparent;
    border: none;
}
QLineEdit#mpxFieldEdit {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}
QLineEdit#mpxFieldEdit:hover {
    border: 1.5px solid @BORDER_STRONG@;
}
QLineEdit#mpxFieldEdit:focus {
    border: 1.5px solid @PRIMARY@;
    background-color: @BG_CARD@;
}
QTextEdit#mpxFieldEdit {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}
QTextEdit#mpxFieldEdit:hover {
    border: 1.5px solid @BORDER_STRONG@;
}
QTextEdit#mpxFieldEdit:focus {
    border: 1.5px solid @PRIMARY@;
}

/* 额外选项分组（MCBBS / 服务器包） */
QWidget#mpxExtraGroup {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 14px;
}
QLabel#mpxExtraTitle {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
}
QCheckBox#mpxModuleCheck {
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    spacing: 8px;
    background: transparent;
    border: none;
}
QLabel#mpxModuleSize {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}
QWidget#mpxModuleRow {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}
QWidget#mpxModuleRow:hover {
    border: 1px solid @BORDER_STRONG@;
}

/* 文件树 */
QTreeWidget#mpxFileTree {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    alternate-background-color: @BG_MUTED@;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
}
QTreeWidget#mpxFileTree::item {
    padding: 4px 2px;
    border-radius: 4px;
}
QTreeWidget#mpxFileTree::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_PRIMARY@;
}

/* 全选/取消全选等轻量按钮 */
QPushButton#mpxGhostBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
}
QPushButton#mpxGhostBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}
QPushButton#mpxGhostBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 底部导航按钮 */
QPushButton#mpxNavPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 8px;
    padding: 9px 28px;
    font-size: 14px;
    font-weight: 600;
    min-width: 96px;
}
QPushButton#mpxNavPrimaryBtn:hover {
    background-color: @PRIMARY_HOVER@;
}
QPushButton#mpxNavPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}
QPushButton#mpxNavPrimaryBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}
QPushButton#mpxNavSecondaryBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 9px 28px;
    font-size: 14px;
    font-weight: 500;
    min-width: 96px;
}
QPushButton#mpxNavSecondaryBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_HOVER@;
}
QPushButton#mpxNavSecondaryBtn:pressed {
    background-color: @BG_PRESSED@;
}
QPushButton#mpxNavSecondaryBtn:disabled {
    color: @TEXT_DISABLED@;
    border: 1px solid @BORDER_DISABLED@;
}

/* 浏览保存路径按钮 */
QPushButton#mpxBrowseBtn {
    background-color: @BG_CARD@;
    color: @ACCENT_TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#mpxBrowseBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @PRIMARY@;
}
QPushButton#mpxBrowseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 导出进度 */
QProgressBar#modpackExportProgress {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
    text-align: center;
    font-size: 10px;
    color: @TEXT_ON_PRIMARY@;
}
QProgressBar#modpackExportProgress::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    border-radius: 5px;
}
QLabel#modpackExportProgressLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}


/* ============================================================
 * HomePage 皮肤面板「默认/经典」模式切换 + 经典模式内容
 * ============================================================ */
QWidget#homeSkinModeSwitch {
    background-color: @BG_PRESSED@;
    border-radius: 16px;
}
QPushButton#homeSkinModeBtn {
    background-color: transparent;
    border: none;
    border-radius: 13px;
    padding: 0;
}
QPushButton#homeSkinModeBtn:hover {
    background-color: @BG_HOVER@;
}
QPushButton#homeSkinModeBtn:checked {
    background-color: @PRIMARY_RGBA_38@;
}

/* 经典模式：头像框芯片 / 账户名 / 实例图标芯片 / 当前实例名 */
QLabel#homeClassicAvatar {
    background-color: @BG_PRESSED@;
    border: 1px solid @BORDER@;
    border-radius: 19px;
    padding: 4px;
}
QLabel#homeClassicName {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
}
QPushButton#homeClassicIconBtn {
    background-color: @BG_PRESSED@;
    border: none;
    border-radius: 10px;
    padding: 0;
}
QPushButton#homeClassicIconBtn:hover {
    background-color: @PRIMARY_RGBA_38@;
}
QPushButton#homeClassicIconBtn:pressed {
    background-color: @PRIMARY_RGBA_38@;
}
QLabel#homeClassicInstanceName {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* ===== Section 52: LocalCategoryDialog 本地资源「管理分类」对话框 ===== */
QDialog#localCategoryDialog {
    background-color: @BG_CARD@;
    border-radius: 16px;
}

/* 列表容器：弱化边框，内容区留白 */
QListWidget#localCatList {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
}

QListWidget#localCatList::item {
    background-color: transparent;
    border-radius: 8px;
    margin: 2px 0;
    padding: 0;
}

QListWidget#localCatList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#localCatList::item:selected {
    background-color: @PRIMARY_RGBA_20@;
}

QListWidget#localCatList::item:selected:!active {
    background-color: @PRIMARY_RGBA_12@;
}

/* 行内控件：分类名 + 数量徽章 */
QWidget#localCatRow {
    background: transparent;
}

QLabel#localCatName {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    border: none;
    padding: 0;
}

/* 行内选中态：setItemWidget 下 ::item:selected 会误伤所有子控件，
   改由代码给行控件打 selected 属性，再按属性上色 */
QWidget#localCatRow[selected="true"] QLabel#localCatName {
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

QLabel#localCatCountBadge {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 0 7px;
    font-size: 11px;
    font-weight: 600;
    min-width: 18px;
    max-height: 18px;
}

QWidget#localCatRow[selected="true"] QLabel#localCatCountBadge {
    background-color: @BG_CARD@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

/* 空态容器：与列表同一套边框/底色 */
QWidget#localCatEmptyBox {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

/* 空态提示 */
QLabel#localCatEmpty {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    border: none;
    padding: 8px 16px;
}

/* 次级操作按钮（重命名）：与 primary/cancel 同高同角 */
QPushButton#localCatSecondaryBtn {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    min-width: 72px;
}

QPushButton#localCatSecondaryBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QPushButton#localCatSecondaryBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#localCatSecondaryBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 危险操作按钮（删除）：浅红底 + 红字，比纯红实心更适合次级入口 */
QPushButton#localCatDeleteBtn {
    background-color: @DANGER_BG@;
    color: @DANGER_TEXT@;
    border: 1px solid @DANGER_BORDER@;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    min-width: 72px;
}

QPushButton#localCatDeleteBtn:hover {
    background-color: @DANGER@;
    border-color: @DANGER_HOVER@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#localCatDeleteBtn:pressed {
    background-color: @DANGER_PRESSED@;
    border-color: @DANGER_PRESSED@;
    color: @TEXT_ON_PRIMARY@;
}

QPushButton#localCatDeleteBtn:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 底部「关闭」与主按钮统一 8px 圆角（覆盖 QDialog 通用 12px） */
QDialog#localCategoryDialog QPushButton#cancelButton {
    border-radius: 8px;
    min-width: 72px;
}

/* 主按钮：本对话框内改用纯色，规避 qlineargradient + 圆角的左上角裁切残影 */
QDialog#localCategoryDialog QPushButton#primaryButton {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 8px;
    min-width: 88px;
}

QDialog#localCategoryDialog QPushButton#primaryButton:hover {
    background-color: @PRIMARY_HOVER@;
    margin: 0;
}

QDialog#localCategoryDialog QPushButton#primaryButton:pressed {
    background-color: @PRIMARY_PRESSED@;
}


/* ─── 社区页（方块盒子论坛首页） ─── */
QFrame#communityHero {
    border-radius: 18px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @PRIMARY_DARK@, stop:0.55 @PRIMARY@, stop:1 @PRIMARY_LIGHT@);
}

QLabel#communityHeroTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: 800;
}

QLabel#communityHeroSub {
    color: rgba(255, 255, 255, 0.90);
    font-size: 13px;
}

QLabel#communityHeroMeta {
    color: rgba(255, 255, 255, 0.78);
    font-size: 12px;
}

QPushButton#communityHeroButton {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 8px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#communityHeroButton:hover {
    background: rgba(255, 255, 255, 0.28);
}

QPushButton#communityHeroButton:pressed {
    background: rgba(255, 255, 255, 0.36);
}

QPushButton#communityHeroButton:disabled {
    color: rgba(255, 255, 255, 0.55);
    border-color: rgba(255, 255, 255, 0.25);
}

/* 社区页顶部加载进度条：细条 + 主题色渐变 */
QWidget#communityLoadingStrip {
    background: transparent;
    border: none;
}

QProgressBar#communityLoadingBar {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    min-height: 3px;
    max-height: 3px;
}

QProgressBar#communityLoadingBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_LIGHT@);
    border-radius: 2px;
}

QFrame#communityCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QFrame#communityEventCard {
    background: @BG_CARD@;
    border: 1px solid @PRIMARY@;
    border-radius: 14px;
}

QLabel#communityEventName {
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 800;
}

QLabel#communityEventPoints {
    color: @SUCCESS@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#communitySectionTitle {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 800;
}

QLabel#communityMuted {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QLabel#communityStatValue {
    color: @TEXT_PRIMARY@;
    font-size: 22px;
    font-weight: 800;
}

QFrame#communityStatDivider {
    background: @BORDER@;
    border: none;
}

QFrame#communityDivider {
    background: @BORDER_LIGHT@;
    border: none;
}

QFrame#communityBoardCard {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
}

QFrame#communityBoardCard:hover {
    background: @BG_MUTED@;
    border-color: @BORDER@;
}

QLabel#communityBoardIcon {
    background: @BG_MUTED@;
    border-radius: 10px;
    font-size: 18px;
}

QLabel#communityBoardName {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#communityBoardCount {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QFrame#communityThreadRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
}

QFrame#communityThreadRow:hover {
    background: @BG_MUTED@;
}

QLabel#communityThreadTitle {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#communityLobbyChip {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 2px 8px;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 600;
}

QLabel#communityLobbyTitle {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QLabel#communityLobbyCode {
    color: @ACCENT_TEXT@;
    font-family: Consolas, "Microsoft YaHei";
    font-size: 12px;
    font-weight: 700;
}

QLabel#communityThreadCount {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#communityTag {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 3px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#communityTag:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#communityLobbyLink {
    background: transparent;
    border: none;
    padding: 3px 4px;
    color: @SUCCESS@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#communityLobbyLink:hover {
    color: @SUCCESS@;
    text-decoration: underline;
}

/* ─── 论坛深度集成：帖子详情 / 主题列表 / 发帖 / 用户主页 ─── */
QFrame#forumCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QFrame#forumHeaderCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QFrame#forumThreadRow {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QFrame#forumThreadRow:hover {
    background: @BG_MUTED@;
    border-color: @BORDER_HOVER@;
}

QLabel#forumSectionTitle {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 800;
}

QLabel#forumMuted {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

/* 用户主页简介：按 Markdown 渲染，去掉文本浏览框自带的底色、边框和内边距 */
QTextBrowser#forumProfileBio {
    background-color: transparent;
    border: none;
    padding: 0;
    color: @TEXT_SECONDARY@;
    font-size: 13.5px;
}

QTextBrowser#forumProfileBio:hover,
QTextBrowser#forumProfileBio:focus {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 帖子正文：同上，正文左边缘要和楼层头的文字对齐 */
QTextBrowser#forumPostBrowser,
QTextBrowser#forumPostBrowser:hover,
QTextBrowser#forumPostBrowser:focus {
    background-color: transparent;
    border: none;
    padding: 0;
}

QLabel#forumStatus {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QLabel#forumThreadTitle {
    color: @TEXT_PRIMARY@;
    font-size: 19px;
    font-weight: 800;
}

QLabel#forumRowTitle {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QLabel#forumFloorNo {
    background: @BG_MUTED@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 800;
    padding: 0 8px;
    min-height: 20px;
}

QPushButton#forumAuthorName {
    background: transparent;
    border: none;
    color: @ACCENT_TEXT@;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    padding: 0;
}

QPushButton#forumAuthorName:hover {
    color: @ACCENT_TEXT@;
}

QPushButton#forumBoardLink {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 1px 10px;
}

QPushButton#forumBoardLink:hover {
    color: @ACCENT_TEXT@;
    border-color: @PRIMARY@;
}

QLabel#forumBadge {
    background: @PRIMARY_BG_SOFT@;
    color: @ACCENT_TEXT@;
    border: none;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 8px;
}

QLabel#forumBadgeWarn {
    background: @WARNING_BG@;
    color: @WARNING_TEXT@;
    border: none;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 8px;
}

QPushButton#forumGhostButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 14px;
}

QPushButton#forumGhostButton:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumGhostButton:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* 创作中心的类型筛选胶囊（全部 / 插件 / 投影 / 普通帖），选中态点亮主题色 */
QPushButton#forumFilterChip {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 12px;
}

QPushButton#forumFilterChip:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumFilterChip:checked {
    background: @PRIMARY_BG_SOFT@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* 发布页正文 Markdown 工具栏小按钮（B / I / S / H / 列表 / 链接 / 图片） */
QPushButton#forumMdButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: @TEXT_SECONDARY@;
    padding: 2px 8px;
}

QPushButton#forumMdButton:hover {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#forumMdButton:pressed {
    background: @BG_MUTED@;
    color: @TEXT_PRIMARY@;
}

QPushButton#forumPrimaryButton {
    background: @PRIMARY@;
    border: none;
    border-radius: 8px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    padding: 3px 18px;
}

QPushButton#forumPrimaryButton:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#forumPrimaryButton:pressed {
    background: @PRIMARY_PRESSED@;
}

QPushButton#forumPrimaryButton:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* 服务器导航板块的来源下拉：和同一行的「排序」胶囊等高，别把表头撑高 */
QComboBox#forumSourceCombo {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 1px 22px 1px 10px;
    font-size: 12px;
    min-height: 18px;
}

QComboBox#forumSourceCombo:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QComboBox#forumSourceCombo::drop-down {
    width: 20px;
    border: none;
    border-left: 1px solid @BORDER_LIGHT@;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

QPushButton#forumLikeButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 2px 10px;
}

QPushButton#forumLikeButton[likedState="on"] {
    background: @PRIMARY_BG_SOFT@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
    font-weight: 700;
}

QPushButton#forumLikeButton:hover {
    border-color: @PRIMARY@;
}

QPushButton#forumLikeButton:pressed {
    background: @PRIMARY_BG_SOFT@;
}

QPushButton#forumSortButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 1px 12px;
}

QPushButton#forumSortButton:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumSortButton:checked {
    background: @PRIMARY_BG_SOFT@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
    font-weight: 700;
}

/* 发布详情页顶部「帖子 / 资源」分段切换（与登录方式切换同款） */
QWidget#composerSegBar {
    background-color: @BG_BASE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QPushButton#composerSegBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 10px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#composerSegBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#composerSegBtn:checked {
    background-color: @BG_CARD@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

QPushButton#composerSegBtn:checked:hover {
    background-color: @BG_CARD@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumPageButton {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 2px 14px;
}

QPushButton#forumPageButton:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumPageButton:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background: transparent;
}

QPushButton#forumTagChip {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 1px 10px;
}

QPushButton#forumTagChip:hover {
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

/* ── 发帖 / 发资源时的标签编辑器（胶囊标签 + 推荐标签） ── */
QFrame#forumTagField {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#forumTagField[focused="true"] {
    background: @BG_CARD@;
    border-color: @PRIMARY@;
}

QLineEdit#forumTagFieldInput {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    padding: 2px 2px;
}

/* 已添加的标签：主题色胶囊，鼠标移上去变成警示色提示「点了会移除」 */
QPushButton#forumTagEditorChip {
    background: @PRIMARY_BG_SOFT@;
    border: 1px solid @PRIMARY@;
    border-radius: 9px;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
    padding: 1px 9px;
}

QPushButton#forumTagEditorChip:hover {
    background: @WARNING_BG@;
    border-color: @WARNING_TEXT@;
    color: @WARNING_TEXT@;
}

/* 推荐标签：虚线胶囊，一眼和已选标签区分开 */
QPushButton#forumTagSuggest {
    background: transparent;
    border: 1px dashed @BORDER@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 1px 9px;
}

QPushButton#forumTagSuggest:hover {
    background: @PRIMARY_BG_SOFT@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QLabel#forumTagCounter {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#forumTagCounter[full="true"] {
    color: @ACCENT_TEXT@;
}

QLabel#forumTagHint {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QLabel#forumTagHint[warn="true"] {
    color: @WARNING_TEXT@;
}

QLabel#forumRowCount {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 800;
}

QLabel#forumAvatar {
    background: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    font-weight: 700;
}

QLineEdit#forumField,
QPlainTextEdit#forumReplyEdit,
QTextEdit#forumReplyEdit {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    padding: 6px 10px;
}

QLineEdit#forumField:focus,
QPlainTextEdit#forumReplyEdit:focus,
QTextEdit#forumReplyEdit:focus {
    border-color: @PRIMARY@;
    background: @BG_CARD@;
}

QLineEdit#forumSearchEdit {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    padding: 4px 10px;
}

QLineEdit#forumSearchEdit:focus {
    border-color: @PRIMARY@;
    background: @BG_CARD@;
}

QLabel#forumReplyTarget {
    background: @PRIMARY_BG_SOFT@;
    color: @ACCENT_TEXT@;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
}

QLabel#forumStatValue {
    color: @TEXT_PRIMARY@;
    font-size: 18px;
    font-weight: 800;
}

/* ─── 帖子详情页：版面与网页版 thread.html 对齐 ─── */
QFrame#forumHero {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QPushButton#forumCrumb {
    background: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
    text-align: left;
}

QPushButton#forumCrumb:hover {
    color: @ACCENT_TEXT@;
}

QLabel#forumCrumbSep,
QLabel#forumCrumbCurrent {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QLabel#forumHeroTitle {
    color: @TEXT_PRIMARY@;
    font-size: 21px;
    font-weight: 800;
}

QPushButton#forumBoardChip {
    background: @PRIMARY_RGBA_26@;
    border: 1px solid @PRIMARY_RGBA_38@;
    border-radius: 12px;
    color: @TEXT_ACCENT@;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}

QPushButton#forumBoardChip:hover {
    background: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

/* 作者胶囊：头像 + 昵称，整块可点进主页 */
QFrame#forumAuthorChip {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 14px;
}

QFrame#forumAuthorChip:hover {
    border-color: @PRIMARY_RGBA_38@;
}

QLabel#forumAuthorChipName {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#forumShareButton,
QPushButton#forumBookmarkButton,
QPushButton#forumTipButton {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 15px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 0 13px;
}

QPushButton#forumShareButton:hover,
QPushButton#forumBookmarkButton:hover,
QPushButton#forumTipButton:hover {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumBookmarkButton[active="true"] {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY@;
    color: @TEXT_ACCENT@;
}

QFrame#forumPost {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QFrame#forumPost:hover {
    border-color: @BORDER_HOVER@;
}

QFrame#forumPost[op="true"] {
    border-color: @PRIMARY_LIGHT@;
}

QFrame#forumPost[op="true"]:hover {
    border-color: @PRIMARY_MEDIUM@;
}

/* 作者头像外面的一圈柔光描边 */
QFrame#forumAvatarRing {
    background: @PRIMARY_RGBA_26@;
    border: none;
    border-radius: 30px;
}

/* 已删除楼层：虚线框 + 灰字，和网页版一致 */
QFrame#forumPost[deleted="true"] {
    border-style: dashed;
    border-color: @BORDER_DASHED@;
    background: @BG_MSG@;
}

QLabel#forumDeletedMark {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-style: italic;
}

QLabel#forumPostCounts {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QPushButton#forumPostName {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 800;
    padding: 0;
}

QPushButton#forumPostName:hover {
    color: @ACCENT_TEXT@;
}

QLabel#forumPostTime {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#forumEditMark {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 6px;
    padding: 0 5px;
}

/* 操作行上方的虚线分隔（网页版 .post-actions 的 border-top） */
QFrame#forumActDivider {
    background: transparent;
    border: none;
    border-top: 1px dashed @BORDER@;
}

/* 胶囊操作按钮：回复 / 引用 / 复制链接 / 编辑 / 举报… */
QPushButton#forumAct {
    background: @BLACK_RGBA_0.06@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
}

QPushButton#forumAct:hover {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QPushButton#forumAct[danger="true"] {
    color: @DANGER@;
}

QPushButton#forumAct[danger="true"]:hover {
    background: @DANGER_BG@;
    border-color: @DANGER_BORDER@;
    border-radius: 14px;
    color: @DANGER@;
}

/* 楼中楼：浅底内嵌面板，和楼层正文分层 */
QFrame#forumChildren {
    background: @BG_MSG@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

/* 面板里的操作按钮换成卡片底色：在浅底面板上像一个个小胶囊浮起来 */
QWidget#forumChild QPushButton#forumAct {
    background: @BG_CARD@;
    border-color: @BORDER@;
}

QWidget#forumChild QPushButton#forumAct:hover {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QWidget#forumChild {
    background: transparent;
    border-top: 1px dashed @BORDER_LIGHT@;
}

QWidget#forumChild[first="true"] {
    border-top: none;
}

QWidget#forumChildrenMore {
    background: transparent;
    border-top: 1px dashed @BORDER_LIGHT@;
}

/* 楼中楼的作者名比主楼层小一档 */
QPushButton#forumChildName {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
    font-weight: 800;
    padding: 0;
}

QPushButton#forumChildName:hover {
    color: @ACCENT_TEXT@;
}

QLabel#forumChildTime {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QPushButton#forumChildrenToggle {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 700;
    padding: 0 14px;
}

QPushButton#forumChildrenToggle:hover {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

/* ── 有奖问答：主题头的赏金卡 + 得奖楼层 + 采纳按钮 ── */

/* 悬赏卡：暖金渐变 + 顶部一道加粗金边 + 圆角礼物徽章，像一张「悬赏令」 */
QFrame#forumQuestionCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 @WARNING_BG@, stop:0.62 @BG_CARD@, stop:1 @WARNING_BG@);
    border: 1px solid @WARNING_BORDER@;
    border-top: 2px solid @WARNING_HOVER@;
    border-radius: 16px;
}

/* 结算过的问答不再抢眼：换成中性底 */
QFrame#forumQuestionCard[settled="true"],
QFrame#forumQuestionCard[refunded="true"] {
    background: @BG_MSG@;
    border-color: @BORDER_LIGHT@;
}

QLabel#forumQuestionGift {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #FFD77A, stop:1 #F0A92B);
    border-radius: 14px;
    font-size: 21px;
}

QFrame#forumQuestionCard[settled="true"] QLabel#forumQuestionGift,
QFrame#forumQuestionCard[refunded="true"] QLabel#forumQuestionGift {
    background: @BG_MUTED@;
}

QLabel#forumQuestionBounty {
    color: @WARNING_TEXT@;
    font-size: 13px;
    font-weight: 800;
}

QFrame#forumQuestionCard[settled="true"] QLabel#forumQuestionBounty,
QFrame#forumQuestionCard[refunded="true"] QLabel#forumQuestionBounty {
    color: @TEXT_SECONDARY@;
}

/* 状态胶囊：待采纳（琥珀）/ 已发放（品牌绿）/ 已退回（灰） */
QLabel#forumQuestionPill {
    background: @WARNING_BG@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    color: @WARNING_TEXT@;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 800;
}

QLabel#forumQuestionPill[state="settled"] {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QLabel#forumQuestionPill[state="refunded"] {
    background: @BG_MUTED@;
    border-color: @BORDER_LIGHT@;
    color: @TEXT_TERTIARY@;
}

QLabel#forumQuestionState {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QLabel#forumQuestionTip {
    color: @TEXT_SECONDARY@;
    border-top: 1px dashed @WARNING_BORDER@;
    padding-top: 8px;
    font-size: 12px;
}

/* 得奖的楼层：左侧一道金色竖条 + 淡淡的暖色铺底，扫一眼就能找到 */
QFrame#forumPost[winner="true"] {
    border-color: @WARNING_BORDER@;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 @WARNING_BG@, stop:0.4 @BG_CARD@, stop:1 @BG_CARD@);
}

/* 问答的回答楼层：左边一道暖金细条，把「题面」和「回答」分开 */
QFrame#forumPost[answer="true"] {
    border-left: 3px solid @WARNING_BORDER@;
}

/* 问答的题面（1 楼）：品牌绿细条 */
QFrame#forumPost[qaop="true"] {
    border-left: 3px solid @PRIMARY_LIGHT@;
}

QFrame#forumPost[answer="true"]:hover {
    border-color: @WARNING_BORDER@;
}

/* 「采纳，发放 N 方块」：整页最关键的点击，做成实心琥珀色 */
QPushButton#forumAcceptButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #F7B23B, stop:1 #E08E00);
    border: 1px solid #D98C14;
    border-radius: 14px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 800;
    padding: 0 12px;
}

QPushButton#forumAcceptButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFC45C, stop:1 #EF9D10);
}

QPushButton#forumAcceptButton:pressed {
    background: #C97900;
}

/* ── 发布页「问答」模式的悬赏输入卡 ── */
QFrame#forumBountyPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 @WARNING_BG@, stop:1 @BG_CARD@);
    border: 1px solid @WARNING_BORDER@;
    border-radius: 14px;
}

QLabel#forumBountyTitle {
    color: @WARNING_TEXT@;
    font-size: 13px;
    font-weight: 800;
}

QLabel#forumBountyBalance {
    background: @BG_CARD@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 9px;
    color: @WARNING_TEXT@;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 800;
}

/* 悬赏输入：数字放大加粗，像网页版的「10 方块」 */
QSpinBox#forumBountySpin {
    background: @BG_CARD@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 12px;
    color: @WARNING_TEXT@;
    font-size: 18px;
    font-weight: 800;
    padding: 4px 14px;
}

QSpinBox#forumBountySpin:hover {
    border-color: @WARNING@;
}

QSpinBox#forumBountySpin:focus {
    border: 2px solid @WARNING@;
    padding: 3px 13px;
}

/* 快捷金额胶囊：5 / 10 / 20 / 50 */
QPushButton#forumBountyChip {
    background: @BG_CARD@;
    border: 1px solid @WARNING_BORDER@;
    border-radius: 13px;
    color: @WARNING_TEXT@;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#forumBountyChip:hover {
    background: @WARNING_BG@;
    border-color: @WARNING@;
}

QPushButton#forumBountyChip:checked {
    background: @WARNING_BG@;
    border-color: @WARNING@;
    color: @WARNING_TEXT@;
}

/* 资源帖评论：一条一条平铺的卡片（插件帖 / 投影帖没有楼层号与楼中楼） */QFrame#forumComment {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QFrame#forumComment:hover {
    border-color: @BORDER_HOVER@;
}

/* 资源帖的「详细信息」卡：静态展示作者写的介绍正文，不跟楼层那样带 hover 反馈 */
QFrame#forumBodyCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QPushButton#forumCommentName {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 800;
    padding: 0;
}

QPushButton#forumCommentName:hover {
    color: @ACCENT_TEXT@;
}

QLabel#forumCommentTime {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
}

QFrame#forumComposer {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QLabel#forumComposerTitle {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 800;
}

QLabel#forumComposerHint,
QLabel#forumComposerCount {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QFrame#forumReplyTargetBar {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 10px;
}

QFrame#forumReplyTargetBar QLabel#forumReplyTarget {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-weight: 600;
    padding: 0;
}

QPushButton#forumReplyTargetClear {
    background: transparent;
    border: none;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    padding: 0 4px;
}

QPushButton#forumReplyTargetClear:hover {
    color: @ACCENT_TEXT@;
}

QFrame#forumRailCard {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QLabel#forumRailTitle {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 800;
}

/* 侧栏卡片标题前的主色小竖条 */
QFrame#forumRailBar {
    background: @PRIMARY@;
    border: none;
    border-radius: 2px;
}

/* 小计数胶囊（插件帖「共 N 条回复」） */
QLabel#forumCountPill {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 8px;
}

QLabel#forumRailKey {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QLabel#forumRailValue {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#forumRailLink {
    background: transparent;
    border: none;
    color: @ACCENT_TEXT@;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
    text-align: left;
}

QPushButton#forumRailLink:hover {
    color: @ACCENT_TEXT@;
}

QLabel#forumRailNote {
    background: @WARNING_BG@;
    border-radius: 8px;
    color: @WARNING_TEXT@;
    font-size: 11px;
    padding: 6px 8px;
}

QPushButton#forumRailButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#forumRailButton:hover {
    background: @PRIMARY_RGBA_26@;
    border-color: @PRIMARY_RGBA_38@;
    color: @ACCENT_TEXT@;
}

QFrame#forumStatBox {
    background: @BG_MUTED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 10px;
}

QFrame#forumStatBox QLabel#forumStatValue {
    font-size: 18px;
}

QLabel#forumRailEmpty {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QFrame#forumRailThread {
    background: transparent;
    border: none;
    border-top: 1px dashed @BORDER_LIGHT@;
    padding: 0;
}

QFrame#forumRailThread[first="true"] {
    border-top: none;
}

QFrame#forumRailThread:hover {
    background: @BG_MUTED@;
    border-radius: 8px;
}

QLabel#forumRailThreadTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#forumRailThreadMeta {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QLabel#forumRailTip {
    color: @TEXT_SECONDARY@;
    font-size: 11.5px;
}

/* ─── 插件帖详情：换成资源详情页的版面（通栏头部 + 左下载 / 右介绍讨论） ─── */
QFrame#forumPluginHero {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* 插件大图标：与模组详情页的头部图标同款 */
QLabel#forumPluginHeroIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: none;
    border-radius: 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 28px;
    font-weight: 800;
}

QLabel#forumPluginHeroTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 24px;
    font-weight: 800;
}

QLabel#forumPluginHeroSub {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", monospace;
}

QLabel#forumPluginHeroMeta {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QLabel#forumPluginHeroDesc {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

/* 左栏的「下载」「插件信息」卡：与模组详情页的信息块同一套观感 */
QFrame#forumPluginSection {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QLabel#forumPluginSectionTitle {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
}

QLabel#forumPluginKey {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QLabel#forumPluginValue {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#forumPluginHint {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

QLabel#forumPluginStatus {
    background: transparent;
    color: @ACCENT_TEXT@;
    font-size: 11px;
    font-weight: 600;
}

/* 下载主按钮：整块拉满，和「一键安装」一个分量 */
QPushButton#forumPluginInstallBtn {
    background: @PRIMARY@;
    border: none;
    border-radius: 11px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 16px;
}

QPushButton#forumPluginInstallBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#forumPluginInstallBtn:pressed {
    background: @PRIMARY_PRESSED@;
}

QPushButton#forumPluginInstallBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}

QLabel#fbUnreadBadge {
    background: @DANGER@;
    color: #ffffff;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    padding: 1px 8px;
}

/* ============================================================
   论坛好友与私信页
   ============================================================ */

QLabel#forumUnreadBadge {
    background: @DANGER@;
    color: #ffffff;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    padding: 1px 7px;
}

/* 官方客服标识：聊天页好友行与首页好友卡片共用 */
QLabel#forumOfficialBadge,
QLabel#homeFriendOfficialBadge {
    background: @PRIMARY_RGBA_20@;
    color: @ACCENT_TEXT@;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
}

/* ── 左栏：与侧边栏子导航面板同款（玻璃底气泡 + 头部 + 分组标题 + 条目） ── */
QFrame#forumSidePanel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

QFrame#forumSidePanel > QWidget {
    background: transparent;
}

QLabel#forumSideTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 800;
}

/* 分组标题：与子导航面板的分组标题同款，左侧缩进对齐条目文字 */
QLabel#forumSideGroupTitle {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 4px 14px 4px 20px;
}

/* 页签胶囊：好友 / 申请 / 添加好友 */
QWidget#forumSideTabs {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
}

QPushButton#forumSideTab {
    background: transparent;
    border: none;
    border-radius: 7px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 0 4px;
}

QPushButton#forumSideTab:hover {
    color: @TEXT_PRIMARY@;
}

QPushButton#forumSideTab:checked {
    background-color: @BG_CARD@;
    color: @ACCENT_TEXT@;
    font-weight: 700;
}

/* 列表条目：子导航条目观感（透明底 + 悬停淡底 + 选中主色渐变） */
QFrame#forumSideRow {
    background: transparent;
    border: none;
    border-radius: 10px;
}

QFrame#forumSideRow:hover {
    background-color: @BLACK_RGBA_0.06@;
}

QFrame#forumSideRow[selected="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY_RGBA_20@,
        stop:1 @PRIMARY_RGBA_8@);
}

QFrame#forumSideRow[selected="true"] QLabel#forumRowTitle {
    color: @ACCENT_TEXT@;
}

/* 会话搜索框：左栏页签下面的一行，圆角浅底 */
QLineEdit#forumConvSearch {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    padding: 0 10px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QLineEdit#forumConvSearch:hover {
    border-color: @BORDER_STRONG@;
}

QLineEdit#forumConvSearch:focus {
    background-color: @BG_CARD@;
    border-color: @PRIMARY@;
}

/* 会话行里的置顶 / 免打扰小图标：只当标记，不占点击 */
QLabel#forumSideStateIcon {
    background: transparent;
    border: none;
}

/* 免打扰会话的未读：只剩一颗小圆点 */
QLabel#forumUnreadDot {
    background: @DANGER@;
    border-radius: 4px;
}

/* 草稿预览：主色，一眼和最后一条消息区分开 */
QLabel#forumDraftPreview {
    background: transparent;
    color: @ACCENT_TEXT@;
    font-size: 12px;
}

/* 「以下是新消息」分隔：两句话中间的一道细提示 */
QLabel#forumChatUnreadDivider {
    background-color: @PRIMARY_RGBA_8@;
    border: 1px solid @PRIMARY_RGBA_20@;
    border-radius: 9px;
    color: @ACCENT_TEXT@;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 12px;
}

QLabel#forumSideStatus {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    padding: 0 16px 6px 16px;
}

/* 列表滚动区跟随面板底色 */
QScrollArea#forumSideScroll {
    background: transparent;
    border: none;
}

QScrollArea#forumSideScroll > QWidget,
QScrollArea#forumSideScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#forumSideScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}

QScrollArea#forumSideScroll QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#forumSideScroll QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#forumSideScroll QScrollBar::add-line:vertical,
QScrollArea#forumSideScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#forumSideScroll QScrollBar::add-page:vertical,
QScrollArea#forumSideScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ── 右栏：聊天主栏（浮起的会话头 / 居中消息流 / 玻璃输入坞，与 AI 聊天页同一套语言） ── */
QWidget#forumChatStage {
    background: transparent;
    border: none;
}

/* 会话头：悬浮玻璃条，圆角与左栏面板呼应 */
QWidget#forumChatHead {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QWidget#forumChatHead QLabel#forumRowTitle {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.1px;
}

/* 会话头操作按钮：轻量胶囊，悬停才染主色 */
QWidget#forumChatHead QPushButton#forumGhostButton {
    background-color: @BG_CARD_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    padding: 1px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QWidget#forumChatHead QPushButton#forumGhostButton:hover {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY_RGBA_64@;
    color: @ACCENT_TEXT@;
}

QWidget#forumChatHead QPushButton#forumGhostButton:pressed {
    background-color: @PRIMARY_RGBA_26@;
}

/* 消息滚动区：跟随页面，滚动条收细 */
QScrollArea#forumChatMsgs {
    background: transparent;
    border: none;
}

QScrollArea#forumChatMsgs > QWidget,
QScrollArea#forumChatMsgs > QWidget > QWidget {
    background: transparent;
}

QScrollArea#forumChatMsgs QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 2px;
}

QScrollArea#forumChatMsgs QScrollBar::handle:vertical {
    background: @BLACK_RGBA_0.13@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollArea#forumChatMsgs QScrollBar::handle:vertical:hover {
    background: @BLACK_RGBA_0.25@;
}

QScrollArea#forumChatMsgs QScrollBar::add-line:vertical,
QScrollArea#forumChatMsgs QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#forumChatMsgs QScrollBar::add-page:vertical,
QScrollArea#forumChatMsgs QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 消息气泡：内边距交给气泡内布局，外层只负责底色和圆角 */
QFrame#forumChatBubbleMine {
    background-color: @PRIMARY_RGBA_38@;
    border: 1px solid @PRIMARY_RGBA_64@;
    border-radius: 16px;
    border-bottom-right-radius: 5px;
}

QFrame#forumChatBubbleTheirs {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    border-bottom-left-radius: 5px;
}

QFrame#forumChatBubbleMine QLabel,
QFrame#forumChatBubbleTheirs QLabel {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
}

/* 引用条：左侧一道浅主色竖线，像被引用内容的书签 */
QLabel#forumChatQuote {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 1px 0 1px 8px;
    border-left: 2px solid @PRIMARY_RGBA_64@;
}

QLabel#forumChatQuote:hover {
    color: @ACCENT_TEXT@;
    border-left-color: @PRIMARY@;
}

/* 点引用条跳到原消息后，原消息整行闪一下主色底 */
QWidget#forumChatRow[flash="true"] {
    background-color: @PRIMARY_RGBA_8@;
    border-radius: 12px;
}

/* 图片消息：跟随发送方一侧的尾巴圆角 */
QFrame#forumChatImageFrame {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    border-bottom-left-radius: 5px;
}

QFrame#forumChatImageFrameMine {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
    border-bottom-right-radius: 5px;
}

/* 日期 / 撤回提示：居中的小胶囊，由布局对齐，不再拉满整行 */
QLabel#forumChatDateChip,
QLabel#forumChatWithdraw {
    background-color: @BG_CARD_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    padding: 3px 12px;
}

/* 输入卡片：与 AI 助手页同款玻璃卡片（文本域在上，工具行在下），聚焦时亮主色边 */
QFrame#forumChatInputBox {
    background-color: @BG_GLASS@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
}

QFrame#forumChatInputBox:hover {
    border-color: @BORDER_STRONG@;
}

QFrame#forumChatInputBox[focused="true"] {
    border-color: @PRIMARY@;
}

QTextEdit#forumChatInput {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    padding: 6px 8px;
    selection-background-color: @PRIMARY_RGBA_38@;
    selection-color: @TEXT_PRIMARY@;
}

QTextEdit#forumChatInput:focus {
    background: transparent;
    border: none;
}

/* 工具栏按钮：与 AI 助手页的图标按钮同样的悬停底色 */
QPushButton#forumChatToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 17px;
    padding: 0;
    color: @TEXT_SECONDARY@;
}

QPushButton#forumChatToolButton:hover {
    background: @BLACK_RGBA_0.06@;
    color: @TEXT_PRIMARY@;
}

QPushButton#forumChatToolButton:pressed {
    background: @BLACK_RGBA_0.12@;
}

QPushButton#forumChatToolButton:disabled {
    color: @TEXT_DISABLED@;
}

/* 发送按钮：输入卡片右下角的主色图标按钮（同 AI 助手页的发送键） */
QPushButton#forumChatSendBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_HOVER@);
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 10px;
    padding: 0;
}

QPushButton#forumChatSendBtn:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton#forumChatSendBtn:pressed {
    background: @PRIMARY_PRESSED@;
}

QPushButton#forumChatSendBtn:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_TERTIARY@;
}

/* 回复 / 引用提示条：输入坞上方的浅色胶囊 */
QFrame#forumChatReplyBar {
    background-color: @BG_CARD_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#forumChatReplyBar QLabel#forumMuted {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

QFrame#forumChatReplyBar QPushButton#forumGhostButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}

QFrame#forumChatReplyBar QPushButton#forumGhostButton:hover {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 空态占位：图标胶囊 + 标题 */
QLabel#forumChatEmptyIcon {
    background-color: @BG_GLASS@;
    border: 1px solid @BORDER@;
    border-radius: 24px;
}

QLabel#forumChatEmptyTitle {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}

QLabel#forumOnlineDot {
    background: @SUCCESS@;
    border: 2px solid @BG_CARD@;
    border-radius: 6px;
}

/* ============================================================
 * Section 52. Java 下载页样式（主程序 JavaDownloadPage / 实例助手 InstanceJavaDownloadPage）
 * 视觉方向：步骤编号卡片 + 玻璃态表单，下拉/安装包列表/进度条统一
 * ============================================================ */

/* ── 主程序：滚动容器透明，内容铺在页面背景上 ── */
QScrollArea#javaDlScroll {
    background: transparent;
    border: none;
}

QWidget#javaDlContent {
    background: transparent;
}

/* ── 卡片：白底细边框，与设置页卡片同语言 ── */
QFrame#javaDlCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}

/* ── 步骤徽标：主色软底 + 主色数字 ── */
QLabel#javaDlStep {
    background-color: @PRIMARY_RGBA_18@;
    color: @TEXT_ACCENT@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
}

/* ── 卡片标题 / 字段名 / 描述 ── */
QLabel#javaDlCardTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    font-weight: 700;
    border: none;
}

QLabel#javaDlFieldLabel {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

QLabel#javaDlDesc {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* ── 卡片内分隔线 ── */
QFrame#javaDlDivider {
    background-color: @BORDER@;
    border: none;
}

/* ── 下拉框：中性玻璃态，聚焦时才出现主色边 ── */
QComboBox#javaDlCombo {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 8px 14px;
    min-height: 20px;
    font-size: 13px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_PRIMARY@;
}

QComboBox#javaDlCombo:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

QComboBox#javaDlCombo:focus {
    background-color: @BG_CARD@;
    border: 1px solid @PRIMARY@;
}

QComboBox#javaDlCombo:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

QComboBox#javaDlCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 28px;
}

QComboBox#javaDlCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 10px;
    margin-right: 11px;
    border: none;
}

QComboBox#javaDlCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
    selection-background-color: @PRIMARY_BG@;
    selection-color: @TEXT_ACCENT@;
    outline: none;
}

QComboBox#javaDlCombo QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 8px;
    min-height: 26px;
}

QComboBox#javaDlCombo QAbstractItemView::item:hover {
    background-color: @BG_HOVER@;
}

/* ── 安装包列表 ── */
QListWidget#javaDlBinaryList {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 6px;
    outline: none;
}

QListWidget#javaDlBinaryList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
}

QListWidget#javaDlBinaryList::item:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QListWidget#javaDlBinaryList::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @TEXT_ACCENT@;
    font-weight: 600;
}

/* ── 安装包摘要 / 元信息 ── */
QLabel#javaDlSummary {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    border: none;
}

QLabel#javaDlSummary[state="error"] {
    color: @DANGER_TEXT@;
}

/* ── 安装路径：等宽只读框，选中可复制 ── */
QLabel#javaDlPath {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 9px 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Code", "Courier New", monospace;
}

QLabel#javaDlHint {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
    border: none;
}

/* ── 进度条：细轨道 + 主色渐变 ── */
QProgressBar#javaDlProgress {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 999px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#javaDlProgress::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border-radius: 999px;
}

QLabel#javaDlProgressText {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    border: none;
}

/* ── 顶部状态胶囊 ── */
QLabel#javaDlStatus {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 999px;
    padding: 5px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QLabel#javaDlStatus[state="busy"] {
    background-color: @PRIMARY_RGBA_18@;
    border-color: @PRIMARY_RGBA_38@;
    color: @TEXT_ACCENT@;
}

QLabel#javaDlStatus[state="success"] {
    background-color: @PRIMARY_RGBA_18@;
    border-color: @PRIMARY_RGBA_38@;
    color: @SUCCESS@;
}

QLabel#javaDlStatus[state="error"] {
    background-color: @DANGER_BG@;
    border-color: @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

/* ── 底部操作按钮 ── */
QPushButton#javaDlPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 10px;
    padding: 9px 22px;
    min-width: 118px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#javaDlPrimaryBtn:hover {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

QPushButton#javaDlPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#javaDlPrimaryBtn:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

QPushButton#javaDlCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 9px 18px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#javaDlCancelBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#javaDlBackBtn {
    background: transparent;
    border: none;
    padding: 6px 8px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QPushButton#javaDlBackBtn:hover {
    color: @ACCENT_TEXT@;
}

QPushButton#javaDlBrowseBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 10px;
    padding: 8px 16px;
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
}

QPushButton#javaDlBrowseBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

QPushButton#javaDlBrowseBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#javaDlBrowseBtn:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* ── 实例助手（窄窗口）Java 下载页：区块也做成卡片 ── */
QFrame#javaDownloadSection {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#javaSectionLabel {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

QListWidget#javaBinaryList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}

QListWidget#javaBinaryList::item {
    padding: 7px 10px;
    border-radius: 7px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QListWidget#javaBinaryList::item:selected {
    background-color: @PRIMARY_RGBA_18@;
    color: @TEXT_ACCENT@;
}

QPushButton#javaCancelBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 7px 16px;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
}

QPushButton#javaCancelBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 窄窗口页的下拉箭头与主页面统一成细箭头 */
InstanceJavaDownloadPage QComboBox::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border: none;
}

/* 窄窗口页：下载按钮跟随主页面用主色实心，避免软主色底在深色主题下发灰 */
InstanceJavaDownloadPage QPushButton#downloadJavaBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 10px;
    padding: 8px 20px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12.5px;
    font-weight: 600;
}

InstanceJavaDownloadPage QPushButton#downloadJavaBtn:hover {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

InstanceJavaDownloadPage QPushButton#downloadJavaBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

InstanceJavaDownloadPage QPushButton#downloadJavaBtn:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* ============================================================
 * 手机端 AI 助手：底部输入栏 + 居中输入弹窗
 * ============================================================ */
QWidget#aiChatMobileBar {
    background: transparent;
    border: none;
}

QPushButton#aiChatMobileInputBtn {
    background: @BG_GLASS@;
    border: 1.5px solid @BORDER@;
    border-radius: 25px;
    padding: 0 18px;
    text-align: left;
    font-size: 14px;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatMobileInputBtn:hover {
    border: 1.5px solid @BORDER_STRONG@;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatMobileInputBtn:pressed {
    background: @BG_HOVER@;
}

QWidget#aiChatMobileBusyRow {
    background: transparent;
    border: none;
}

QLabel#aiChatMobileBusyDot {
    background: @PRIMARY@;
    border-radius: 4px;
}

QLabel#aiChatMobileBusyLabel {
    background: transparent;
    border: none;
    color: @ACCENT_TEXT@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#aiChatMobileBusyDetail {
    background: transparent;
    border: none;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}

QPushButton#aiChatMobileStopBtn {
    background: @DANGER@;
    border: none;
    border-radius: 20px;
    padding: 0 20px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#aiChatMobileStopBtn:hover {
    background: @DANGER_HOVER@;
}

QWidget#aiComposeCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

QLabel#aiComposeTitle {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}

QToolButton#aiComposeCloseBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QToolButton#aiComposeCloseBtn:hover {
    background: @BLACK_RGBA_0.06@;
}

/* ============================================================
   投影预览弹窗（投影详情页 / 投影帖详情页的「投影预览」）
   ============================================================ */
QWidget#projectionPreviewCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

/* 全屏预览时卡片铺满整个窗口，圆角与描边一起去掉，才像整屏画面 */
QWidget#projectionPreviewCard[fs="true"] {
    border: none;
    border-radius: 0;
}

/* 三维画面的取景框：一圈细边把「画面」和「操作区」分开，全屏时一起去掉 */
QWidget#projectionPreviewStage {
    background-color: transparent;
    border: 1px solid @BORDER@;
    border-radius: 0px;
}

QWidget#projectionPreviewStage[fs="true"] {
    border: none;
}

/* 标题前的「3D」小徽标 */
QLabel#projectionPreviewBadge {
    background-color: @PRIMARY_RGBA_26@;
    color: @ACCENT_TEXT@;
    border: none;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#projectionPreviewTitleBar {
    background: transparent;
    border: none;
}

/* 工具栏：一整块浅底面板，里面的控件按用途分四组排在后面 */
QWidget#projectionPreviewToolbar {
    background-color: @BG_TAB@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QWidget#projectionPreviewGroup {
    background: transparent;
    border: none;
}

/* 组名（视角 / 材质 / 显示层）：小字次要色，只做分组提示，不抢画面 */
QLabel#projectionPreviewFieldLabel,
QLabel#projectionPreviewLayerLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 工具栏下拉框：比全局样式矮一号、圆角小一号，和旁边的小按钮对齐 */
QComboBox#projectionPreviewCombo {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 2px 20px 2px 9px;
    font-size: 12px;
    min-height: 20px;
}

QComboBox#projectionPreviewCombo:hover {
    border-color: @BORDER_STRONG@;
}

QComboBox#projectionPreviewCombo:focus {
    border: 1px solid @PRIMARY@;
    border-radius: 8px;
    padding: 2px 20px 2px 9px;
}

QComboBox#projectionPreviewCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QComboBox#projectionPreviewCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 9px;
    height: 9px;
    border: none;
}

/* 一次性提示（截图已保存等）：主题色小字，几秒后自己消失 */
QLabel#projectionPreviewStatus {
    color: @ACCENT_TEXT@;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
}

/* 超大投影的「仍然加载」：实心主色小按钮 */
QPushButton#projectionPreviewForceBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 18px;
    min-width: 0px;
}

QPushButton#projectionPreviewForceBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#projectionPreviewForceBtn:pressed {
    background-color: @PRIMARY_DARK@;
}

QLabel#projectionPreviewTitle {
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    border: none;
}

/* 尺寸 / 方块数 / 面数：浅底小药丸，和标题拉开层次，也不像正文一样抢眼 */
QLabel#projectionPreviewStats {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background-color: @BG_TAB@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 9px;
    padding: 2px 9px;
}

/* 关闭：小号描边按钮（写死 min-width，避开全局 QDialog QPushButton 的 80px） */
QPushButton#projectionPreviewCloseBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 12px;
    padding: 4px 14px;
    min-width: 0px;
}

QPushButton#projectionPreviewCloseBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#projectionPreviewCloseBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 层数条：和工具栏同款浅底面板，拖滑块剖切时视线不用来回跳 */
QWidget#projectionPreviewLayerBar {
    background-color: @BG_TAB@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 12px;
}

QLabel#projectionPreviewLayerValue {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

QToolButton#projectionPreviewStepBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 7px;
    font-size: 13px;
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QToolButton#projectionPreviewStepBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QToolButton#projectionPreviewStepBtn:pressed {
    background-color: @BG_PRESSED@;
}

QToolButton#projectionPreviewStepBtn:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

/* 工具栏 / 层数条里的小按钮（重置视角、自动旋转、全屏等） */
QToolButton#projectionPreviewChipBtn {
    background-color: @BG_CARD@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0 11px;
    font-size: 12px;
}

QToolButton#projectionPreviewChipBtn:hover {
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
    background-color: @BG_CARD@;
}

QToolButton#projectionPreviewChipBtn:pressed {
    background-color: @BG_PRESSED@;
}

/* 自动旋转 / 全屏这类开关：打开时用主题色描边 + 浅底 */
QToolButton#projectionPreviewChipBtn:checked {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QToolButton#projectionPreviewChipBtn:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

QToolButton#projectionPreviewBelowToggle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 0 10px;
    font-size: 12px;
}

QToolButton#projectionPreviewBelowToggle:hover {
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
    background-color: @BG_HOVER@;
}

QToolButton#projectionPreviewBelowToggle:checked {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY@;
    color: @ACCENT_TEXT@;
}

QToolButton#projectionPreviewBelowToggle:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
    background-color: transparent;
}

/* 层数滑块：轨道 + 已选段 + 圆形滑柄，拖起来能看到「掀到第几层」 */
QSlider#projectionPreviewLayerSlider {
    background: transparent;
    min-height: 18px;
}

QSlider#projectionPreviewLayerSlider::groove:horizontal {
    height: 6px;
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 3px;
}

QSlider#projectionPreviewLayerSlider::sub-page:horizontal {
    background-color: @PRIMARY@;
    border: none;
    border-radius: 3px;
}

QSlider#projectionPreviewLayerSlider::add-page:horizontal {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 3px;
}

QSlider#projectionPreviewLayerSlider::handle:horizontal {
    background-color: @BG_CARD@;
    border: 2px solid @PRIMARY@;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider#projectionPreviewLayerSlider::handle:horizontal:hover {
    background-color: @PRIMARY_RGBA_26@;
}

QSlider#projectionPreviewLayerSlider::handle:horizontal:pressed {
    background-color: @PRIMARY@;
}

/* 画面下方的操作说明：小一号的淡字，占位但不抢眼 */
QLabel#projectionPreviewHint {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 悬停方块信息：比操作说明亮一点，扫一眼能看清是什么方块 */
QLabel#projectionPreviewHover {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 投影帖左栏的「投影预览」「材料列表」：描边按钮，排在实心「下载投影」下面 */
QPushButton#forumSchematicPreviewBtn,
QPushButton#forumSchematicMaterialBtn {
    background: transparent;
    border: 1px solid @PRIMARY@;
    border-radius: 11px;
    color: @ACCENT_TEXT@;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    min-width: 0px;
}

QPushButton#forumSchematicPreviewBtn:hover,
QPushButton#forumSchematicMaterialBtn:hover {
    background: @PRIMARY_RGBA_20@;
}

QPushButton#forumSchematicPreviewBtn:pressed,
QPushButton#forumSchematicMaterialBtn:pressed {
    background: @PRIMARY_RGBA_26@;
}

QPushButton#forumSchematicPreviewBtn:disabled,
QPushButton#forumSchematicMaterialBtn:disabled {
    background: transparent;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* ============================================================
   材料清单弹窗（投影帖详情页的「材料列表」）
   ============================================================ */
QWidget#projectionMaterialCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 18px;
}

QLabel#projectionMaterialTitle {
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#projectionMaterialSummary {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* 关闭：小号描边按钮（写死 min-width，避开全局 QDialog QPushButton 的 80px） */
QPushButton#projectionMaterialCloseBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-size: 12px;
    padding: 4px 14px;
    min-width: 0px;
}

QPushButton#projectionMaterialCloseBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
    color: @TEXT_PRIMARY@;
}

QPushButton#projectionMaterialCloseBtn:pressed {
    background-color: @BG_PRESSED@;
}

QLineEdit#projectionMaterialFilter {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    padding: 6px 10px;
}

QLineEdit#projectionMaterialFilter:focus {
    border-color: @PRIMARY@;
    background: @BG_CARD@;
}

QLineEdit#projectionMaterialFilter:disabled {
    color: @TEXT_DISABLED@;
}

/* 复制清单：主色实心小按钮，和旁边的筛选框等高 */
QPushButton#projectionMaterialCopyBtn {
    background-color: @PRIMARY@;
    color: @TEXT_ON_PRIMARY@;
    border: none;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    min-width: 0px;
}

QPushButton#projectionMaterialCopyBtn:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#projectionMaterialCopyBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#projectionMaterialCopyBtn:disabled {
    background-color: @BG_MUTED@;
    color: @TEXT_DISABLED@;
}

QLabel#projectionMaterialHint {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    background: transparent;
    border: none;
}

/* ============================================================
 * Section 53. 实例助手「本地开服」页
 * 视觉方向：单列卡片 + 主色开服按钮 + 等宽控制台
 * ============================================================ */

QScrollArea#serverScroll {
    background: transparent;
    border: none;
}

QWidget#serverContent {
    background: transparent;
}

QFrame#serverCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#serverCardTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    border: none;
}

QLabel#serverFieldLabel {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

QLabel#serverStatusText {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    border: none;
}

QLabel#serverAddress {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 10px;
    color: @TEXT_ACCENT@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#serverHint {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
    border: none;
}

QLabel#serverEulaHint {
    background: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* ── 一键开服：主色实心，停止态换成告警色 ── */
QPushButton#serverPrimaryBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @PRIMARY@,
        stop:1 @PRIMARY_DARK@);
    border: 1px solid @PRIMARY_DARK@;
    border-radius: 10px;
    padding: 9px 18px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#serverPrimaryBtn:hover {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

QPushButton#serverPrimaryBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

QPushButton#serverPrimaryBtn:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

QPushButton#serverPrimaryBtn[danger="true"] {
    background-color: @DANGER_BG@;
    border: 1px solid @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

QPushButton#serverPrimaryBtn[danger="true"]:hover {
    background-color: @DANGER@;
    border-color: @DANGER@;
    color: @TEXT_ON_PRIMARY@;
}

/* ── 次要小按钮（复制地址 / 打开目录 / 清空 / 加入服务器列表） ── */
QPushButton#serverGhostBtn {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QPushButton#serverGhostBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#serverGhostBtn:pressed {
    background-color: @BG_PRESSED@;
}

QPushButton#serverGhostBtn:disabled {
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DISABLED@;
}

/* ── 下拉 / 数字框：与窄窗口其它页保持一致 ── */
QComboBox#serverCombo,
QSpinBox#serverSpin {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 18px;
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
}

QComboBox#serverCombo:hover,
QSpinBox#serverSpin:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

QComboBox#serverCombo:disabled,
QSpinBox#serverSpin:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

QComboBox#serverCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 22px;
}

QComboBox#serverCombo::down-arrow {
    image: url(:/Images/Icons/arrow_down_triangle.svg);
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border: none;
}

QComboBox#serverCombo QAbstractItemView {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    color: @TEXT_PRIMARY@;
    selection-background-color: @PRIMARY_RGBA_18@;
    selection-color: @TEXT_ACCENT@;
}

/* ── 进度条 ── */
QProgressBar#serverProgress {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 3px;
    max-height: 5px;
}

QProgressBar#serverProgress::chunk {
    background-color: @PRIMARY@;
    border-radius: 3px;
}

/* ── 控制台：等宽小字，深一点的底色 ── */
QPlainTextEdit#serverConsole {
    background-color: @BG_CONTENT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 8px;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    selection-background-color: @PRIMARY_RGBA_26@;
}


/* ── 本地开服页的输入框：服务器名称 / 服务端指令 ── */
QLineEdit#serverMotdEdit,
QLineEdit#serverCommandEdit {
    background-color: @BG_MUTED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 18px;
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
    selection-background-color: @PRIMARY_RGBA_26@;
    selection-color: @TEXT_PRIMARY@;
}

QLineEdit#serverMotdEdit:hover,
QLineEdit#serverCommandEdit:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_HOVER@;
}

QLineEdit#serverMotdEdit:focus,
QLineEdit#serverCommandEdit:focus {
    background-color: @BG_CARD@;
    border-color: @PRIMARY@;
}

QLineEdit#serverMotdEdit:disabled,
QLineEdit#serverCommandEdit:disabled {
    background-color: @BG_DISABLED@;
    border-color: @BORDER_DISABLED@;
    color: @TEXT_DISABLED@;
}

/* ============================================================
 * Section 50. 模型服务商设置面板 + 模型选择窗口（先选服务商）
 * ============================================================ */
QWidget#mpsSideBody,
QWidget#mpsSideList,
QScrollArea#mpsSideScroll,
QScrollArea#mpsPageScroll,
QWidget#mpsModelCard,
QWidget#msdProviderColumn,
QWidget#msdModelColumn,
QWidget#msdProviderHost,
QScrollArea#msdProviderScroll {
    background: transparent;
    border: none;
}

QPushButton#mpsProviderRow,
QPushButton#msdProviderRow {
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 7px 6px;
}

QPushButton#mpsProviderRow:hover,
QPushButton#msdProviderRow:hover {
    background: @BG_HOVER@;
}

QPushButton#mpsProviderRow:checked,
QPushButton#msdProviderRow:checked {
    background: @PRIMARY_RGBA_20@;
    border: 1px solid @PRIMARY_RGBA_38@;
}

QLabel#mpsGroupLabel {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 6px 3px 6px;
    background: transparent;
}

QLabel#mpsRowDot,
QLabel#msdProviderDot {
    border: none;
}

QLabel#mpsProviderName,
QLabel#msdProviderName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background: transparent;
}

QLabel#mpsFieldLabel {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background: transparent;
}

QLabel#mpsEmptyHint {
    color: @TEXT_DISABLED@;
    font-size: 12px;
    background: transparent;
}

QWidget#mpsModelCard {
    border: 1px dashed @BORDER@;
    border-radius: 10px;
}

QWidget#mpsModelCard[filled="true"] {
    border: 1px solid @BORDER@;
}

QPushButton#mpsModelRow {
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#mpsModelRow:hover {
    background: @BG_HOVER@;
}

QLabel#mpsModelName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background: transparent;
}

QLabel#mpsModelId {
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    font-family: "Consolas", "Cascadia Code", monospace;
    background: transparent;
}

QLabel#msdStatusLabel {
    background: transparent;
}

QLineEdit#msdManualEdit {
    background: @BG_MUTED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
    color: @TEXT_PRIMARY@;
}

QLineEdit#msdManualEdit:focus {
    border-color: @PRIMARY@;
}

QScrollArea#msdProviderScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollArea#msdProviderScroll QScrollBar::handle:vertical {
    background: @BORDER_STRONG@;
    border-radius: 3px;
    min-height: 20px;
}

QScrollArea#msdProviderScroll QScrollBar::add-line:vertical,
QScrollArea#msdProviderScroll QScrollBar::sub-line:vertical,
QScrollArea#msdProviderScroll QScrollBar::add-page:vertical,
QScrollArea#msdProviderScroll QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}
