    color: @TEXT_TERTIARY@;
    font-size: 12px;
    min-width: 34px;
    border: none;
}
QLabel#homeSysValue {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    border: none;
}

/* ���ӻ����������㿨Ƭͼ��оƬ */
QLabel#homeIconChip {
    background-color: @PRIMARY_RGBA_38@;
    border-radius: 8px;
}

/* ϵͳ��Ϣ�����Ǳ�˵������ */
QLabel#homeGaugeCaption {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    border: none;
}

/* ʵ������ͳ�� */
QLabel#homeInstCount {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 700;
    border: none;
}
QLabel#homeLegendText {
    background-color: transparent;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    border: none;
}

/* ============================================================
 * 翻译功能样式 (Translation Feature Styles)
 * ============================================================ */

/* 详情页翻译按钮 */
QPushButton#modDetailTranslateBtn {
    background-color: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#modDetailTranslateBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
    border-color: @PRIMARY_RGBA_40@;
}
QPushButton#modDetailTranslateBtn:pressed {
    background-color: @PRIMARY_RGBA_30@;
}
QPushButton#modDetailTranslateBtn:disabled {
    background-color: @BG_SECONDARY@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_DEFAULT@;
}

/* 详情页翻译设置按钮 */
QPushButton#modDetailTranslateSettingsBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#modDetailTranslateSettingsBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 翻译设置对话框 */
QWidget#translationSettingsCard {
    background-color: @BG_CARD@;
    border-radius: 16px;
    border: 1px solid @BORDER_DEFAULT@;
}

QLabel#translationSettingsTitle {
    font-size: 18px;
    font-weight: 700;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
    border: none;
}

QPushButton#translationSettingsCloseBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 4px;
    font-size: 16px;
}
QPushButton#translationSettingsCloseBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

/* 翻译源选择器 */
QWidget#translationSourceSelector {
    background-color: @BG_SECONDARY@;
    border-radius: 12px;
    padding: 4px;
}

QPushButton#translationSourceBtn {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#translationSourceBtn:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}
QPushButton#translationSourceBtn:checked {
    background-color: @PRIMARY_RGBA_15@;
    color: @PRIMARY@;
    font-weight: 600;
}

/* 翻译设置输入框 */
QLabel#translationDesc {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

QLabel#translationFieldLabel {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 500;
    background-color: transparent;
    border: none;
}

QLineEdit#translationInput {
    background-color: @BG_SECONDARY@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: @PRIMARY_RGBA_40@;
}
QLineEdit#translationInput:focus {
    border-color: @PRIMARY@;
}
QLineEdit#translationInput::placeholder {
    color: @TEXT_TERTIARY@;
}

/* DeepL 类型选择按钮 */
QPushButton#translationTypeBtn {
    background-color: @BG_SECONDARY@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
}
QPushButton#translationTypeBtn:hover {
    background-color: @BG_HOVER@;
    border-color: @PRIMARY_RGBA_26@;
}
QPushButton#translationTypeBtn:checked {
    background-color: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
    border-color: @PRIMARY_RGBA_40@;
    font-weight: 600;
}

/* 测试翻译区域 */
QWidget#translationTestSection {
    background-color: @BG_SECONDARY@;
    border-radius: 12px;
    padding: 10px;
}

QLabel#translationTestTitle {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QLineEdit#translationTestInput {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton#translationTestBtn {
    background-color: @PRIMARY_RGBA_12@;
    color: @PRIMARY@;
    border: 1px solid @PRIMARY_RGBA_26@;
    border-radius: 8px;
    padding: 5px 16px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#translationTestBtn:hover {
    background-color: @PRIMARY_RGBA_20@;
}
QPushButton#translationTestBtn:disabled {
    background-color: @BG_SECONDARY@;
    color: @TEXT_DISABLED@;
}

QLabel#translationTestResult {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    background-color: @BG_CARD@;
    border-radius: 8px;
    padding: 8px 10px;
    border: 1px solid @BORDER_DEFAULT@;
}

/* 保存按钮 */
QPushButton#translationSaveBtn {
    background-color: @PRIMARY@;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#translationSaveBtn:hover {
    background-color: @PRIMARY_HOVER@;
}
QPushButton#translationSaveBtn:pressed {
    background-color: @PRIMARY_PRESSED@;
}

/* ===== Section 49: AI 助手设置页服务商列表 ===== */
QListWidget#providerList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#providerList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#providerList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#providerList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QListWidget#providerModelList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#providerModelList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#providerModelList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#providerModelList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}

QListWidget#customModelsList {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 4px 8px;
    outline: none;
}

QListWidget#customModelsList::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    margin: 2px 4px;
}

QListWidget#customModelsList::item:hover {
    background-color: @BG_HOVER@;
}

QListWidget#customModelsList::item:selected {
    background-color: @PRIMARY_BG@;
    color: @TEXT_ACCENT@;
}
