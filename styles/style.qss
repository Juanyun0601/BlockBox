    border: none;
}

QProgressBar#pluginRunnerProgress {
    background-color: @BG_TRACK@;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#pluginRunnerProgress::chunk {
    background-color: @PRIMARY@;
    border-radius: 4px;
}

QLabel#pluginRunnerDetail {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
