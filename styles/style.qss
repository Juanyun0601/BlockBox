/* ============================================================
 * Section 50. OnboardingWizard 新手引导向导
 * objectName 前缀 obw，全部控件跟随全局主题占位�?
 * ============================================================ */

/* --- 50.1 向导卡片容器 --- */
QFrame#OnboardingWizardCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 22px;
}
/* 容器自身透明（让父级页面透出主对话框背景�?*/
QFrame#obwHeader, QWidget#obwStepper, QWidget#obwStepNode,
QStackedWidget#obwStack, QWidget#obwPage0, QWidget#obwPage1, QWidget#obwPage2Import,
QWidget#obwPage2Manual, QWidget#obwPage3, QWidget#obwPage4,
QWidget#obwPage5, QWidget#obwPageDone, QScrollArea#obwScroll,
QFrame#obwFooter {
    background-color: transparent;
}
/* 列表容器：保持不透明（继�?@BG_BASE 浅灰），让卡片（白色 BG_CARD + 边框）有视觉对比 */
QWidget#obwAccountList, QWidget#obwFolderList, QWidget#obwJavaList {
    background-color: @BG_BASE@;
}

/* --- 50.2 头部 --- */
QFrame#obwHeader {
    background-color: transparent;
    border-bottom: 1px solid @BORDER@;
}
QLabel#obwBrandLogo {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 800;
}
QLabel#obwBrandTitle {
    color: @TEXT_PRIMARY@;
    font-size: 16px;
    font-weight: 700;
}
QLabel#obwBrandSub {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}
QPushButton#obwSkipBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    color: @TEXT_TERTIARY@;
    padding: 6px 14px;
    font-size: 12.5px;
    font-weight: 500;
}
QPushButton#obwSkipBtn:hover {
    color: @TEXT_PRIMARY@;
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}

/* --- 50.3 步骤�?--- */
QWidget#obwStepper {
    background-color: transparent;
    border-bottom: 1px solid @BORDER@;
}
QWidget#obwStepNode {
    background-color: transparent;
}
QLabel#obwStepDot {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 17px;
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    font-weight: 700;
}
QLabel#obwStepDot[state="active"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1.5px solid transparent;
    color: @TEXT_ON_PRIMARY@;
}
QLabel#obwStepDot[state="done"] {
    background-color: @PRIMARY_BG@;
    border: 1.5px solid @PRIMARY@;
    color: @PRIMARY@;
}
QLabel#obwStepLabel {
    color: @TEXT_TERTIARY@;
    font-size: 12.5px;
    font-weight: 600;
}
QLabel#obwStepLabel[state="on"] {
    color: @TEXT_PRIMARY@;
}
QLabel#obwStepLabel[state="on"] {
    color: @TEXT_PRIMARY@;
}
QFrame#obwStepLine {
    background-color: @BORDER@;
    border: none;
    border-radius: 1px;
}
QFrame#obwStepLine[state="done"] {
    background-color: @PRIMARY@;
}

/* --- 50.4 页面标题 --- */
QLabel#obwPageTitle {
    color: @TEXT_PRIMARY@;
    font-size: 21px;
    font-weight: 800;
}
QLabel#obwPageDesc {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}
QLabel#obwSectionTitle {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 700;
}
QLabel#obwSectionTitleLabel {
    color: @TEXT_SECONDARY@;
    font-size: 14px;
    font-weight: 700;
}

/* --- 50.5 引导方式卡片（Step1�?--- */
QFrame#obwMethodTopBar {
    background-color: transparent;
    border: none;
    border-radius: 2px;
}
QPushButton#obwMethodCard:checked QFrame#obwMethodTopBar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}
QPushButton#obwMethodCard {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
    text-align: left;
}
QPushButton#obwMethodCard:hover {
    background-color: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}
QPushButton#obwMethodCard:checked {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#obwMethodCheck {
    background-color: transparent;
    border: none;
    border-radius: 11px;
    color: rgba(0, 0, 0, 0);
    font-size: 12px;
    font-weight: 800;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodCheck {
    background-color: @PRIMARY@;
    color: #FFFFFF;
}
/* 图标：默�?accent-soft �?+ accent 字（对齐 HTML）；选中/悬停渐变底白�?*/
QLabel#obwMethodIcon {
    background-color: @PRIMARY_BG@;
    border-radius: 12px;
    color: @PRIMARY@;
    font-size: 19px;
    font-weight: 700;
    border: 1px solid transparent;
}
QPushButton#obwMethodCard:hover QLabel#obwMethodIcon,
QPushButton#obwMethodCard:checked QLabel#obwMethodIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    color: @TEXT_ON_PRIMARY@;
}
QPushButton#obwMethodCard:hover QLabel#obwMethodCheck {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
}
QLabel#obwMethodName {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}
QLabel#obwMethodDesc {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
QLabel#obwMethodTag {
    background-color: @BG_MUTED@;
    border-radius: 9px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
}
QPushButton#obwMethodCard:checked QLabel#obwMethodTag {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY@;
}

/* --- 50.6 提示�?--- */
QLabel#obwTip {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY_MEDIUM@;
    border-radius: 12px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    padding: 10px 14px;
}

/* --- 50.7 启动器卡片（Step2 导入�?--- */
QFrame#obwLauncherCard {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 16px;
}
QLabel#obwLauncherName {
    color: @TEXT_PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}
QLabel#obwLauncherAlias {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwLauncherDesc {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}
QFrame#obwLauncherStatusBox {
    background-color: @BG_MUTED@;
    border-radius: 8px;
}
QLabel#obwLauncherStatus {
    color: @TEXT_TERTIARY@;
    font-size: 7px;
}
QLabel#obwLauncherStatus[state="found"] {
    color: @SUCCESS@;
}
QLabel#obwLauncherStatus[state="scanning"] {
    color: @WARNING@;
}
QLabel#obwLauncherStatusText {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}
QLabel#obwLauncherStatusText[state="found"] {
    color: @SUCCESS@;
}
QLabel#obwImportedBadge {
    background-color: @PRIMARY_BG@;
    border: 1px solid @PRIMARY@;
    border-radius: 6px;
    color: @PRIMARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 0;
}

/* --- 50.8 通用按钮 --- */
QPushButton#obwBtnPrimary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border: 1px solid transparent;
    border-radius: 8px;
    color: @TEXT_ON_PRIMARY@;
    font-size: 12.5px;
    font-weight: 600;
    padding: 7px 16px;
}
QPushButton#obwBtnPrimary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY_HOVER@, stop:1 @PRIMARY_DARK@);
}
QPushButton#obwBtnPrimary:disabled {
    background-color: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
}
QPushButton#obwBtnSecondary {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    font-weight: 500;
    padding: 7px 16px;
}
QPushButton#obwBtnSecondary:hover {
    background-color: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
    border-color: @BORDER_STRONG@;
}

/* --- 50.9 账户管理（Step2 手动�?--- */
QLabel#obwMutedText {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
QLabel#obwEmptyText {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
    padding: 20px;
}
QFrame#obwAccountItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame#obwAccountItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwAccountName {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwAccountMeta {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}
QLabel#obwBadgeDefault {
    background-color: @PRIMARY_BG@;
    border-radius: 10px;
    color: @PRIMARY@;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QLabel#obwBadgeMs {
    background-color: rgba(59, 130, 246, 0.14);
    border-radius: 10px;
    color: #3B82F6;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QLabel#obwBadgeOff {
    background-color: @BG_MUTED@;
    border-radius: 10px;
    color: @TEXT_TERTIARY@;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 8px;
}
QWidget#obwAccountPanel, QWidget#obwFolderPanel {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}
QPushButton#obwAccountTab {
    background-color: @BG_MUTED@;
    border: none;
    border-radius: 6px;
    color: @TEXT_TERTIARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
}
QPushButton#obwAccountTab:checked {
    background-color: @BG_CARD@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
}
QLabel#obwFieldLabel {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}
QLineEdit#obwInput {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    padding: 7px 12px;
    font-size: 13px;
}
QLineEdit#obwInput:focus {
    border-color: @PRIMARY@;
}

/* --- 50.10 Java 管理（Step3�?--- */
QScrollArea#obwScroll {
    background-color: transparent;
    border: none;
}
QFrame#obwJavaItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame#obwJavaItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwJavaIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F97316, stop:1 #C2410C);
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 17px;
}
QLabel#obwJavaVer {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwJavaPath {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}
QFrame#obwDlCard {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame#obwDlCard:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QLabel#obwDlVer {
    color: @TEXT_PRIMARY@;
    font-size: 17px;
    font-weight: 800;
}
QLabel#obwDlTag {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwDlSize {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}

/* --- 50.11 实例文件夹（Step4�?--- */
QFrame#obwFolderItem {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame#obwFolderItem:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QFrame#obwFolderItem[state="default"] {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#obwFolderIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FBBF24, stop:1 #D97706);
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 15px;
}
QLabel#obwFolderName {
    color: @TEXT_PRIMARY@;
    font-size: 13.5px;
    font-weight: 600;
}
QLabel#obwFolderPath {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
}

/* --- 50.12 样式设置（Step5�?--- */
QFrame#obwStyleBlock {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 16px;
}
QLabel#obwStyleBlockTitle {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#obwThemeCard {
    background-color: @BG_MUTED@;
    border: 1.5px solid @BORDER@;
    border-radius: 12px;
}
QPushButton#obwThemeCard:hover {
    border-color: @BORDER_STRONG@;
}
QPushButton#obwThemeCard:checked {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY@;
}
QWidget#obwThemePreview {
    background-color: #F8FAFC;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}
QWidget#obwThemePreview[mode="dark"] {
    background-color: #0F172A;
    border: 1px solid rgba(255,255,255,0.08);
}
QLabel#obwPreviewDot {
    background-color: #64748B;
    border-radius: 4px;
    min-width: 9px; min-height: 9px;
}
QLabel#obwPreviewSide {
    background-color: #CBD5E1;
    border-radius: 3px;
}
QWidget#obwThemePreview[mode="dark"] QLabel#obwPreviewSide {
    background-color: #1E293B;
}
QLabel#obwPreviewLine {
    background-color: #94A3B8;
    border-radius: 3px;
    min-height: 10px;
}
QWidget#obwThemePreview[mode="dark"] QLabel#obwPreviewLine {
    background-color: #475569;
}
QLabel#obwPreviewAccent {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 3px;
}
QLabel#obwThemeCardLabel {
    color: @TEXT_SECONDARY@;
    font-size: 12.5px;
    font-weight: 600;
}
QPushButton#obwThemeCard:checked QLabel#obwThemeCardLabel {
    color: @PRIMARY@;
}
QPushButton#obwBgOption {
    background-color: @BG_CARD@;
    border: 1.5px solid @BORDER@;
    border-radius: 8px;
    padding: 0;
    text-align: left;
    /* 去除系统按钮视觉效果，让内部 layout 内容成为视觉中心 */
    color: transparent;
}
QPushButton#obwBgOption:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QPushButton#obwBgOption:checked {
    background-color: @PRIMARY_BG@;
    border-color: @PRIMARY@;
}
QLabel#obwBgSwatch {
    border: 1px solid @BORDER@;
    border-radius: 5px;
}
QLabel#obwBgSwatch[swatch="solid"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ECFDF5, stop:1 #F8FAFC);
}
QLabel#obwBgSwatch[swatch="gradient"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
}
QLabel#obwBgSwatch[swatch="blur"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0F172A, stop:1 #1E293B);
}
QLabel#obwBgName {
    color: @TEXT_PRIMARY@;
    font-size: 12.5px;
    font-weight: 600;
}
QLabel#obwBgDesc {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwBgRadio {
    background-color: transparent;
    border: 2px solid @BORDER_STRONG@;
    border-radius: 8px;
}
QPushButton#obwBgOption:checked QLabel#obwBgRadio {
    border-color: @PRIMARY@;
    background-color: @PRIMARY@;
}
/* 背景模式 tab：经�?/ 纯色 / 图片 */
QPushButton#obwBgModeBtn {
    background-color: @BG_MUTED@;
    border: 1.5px solid @BORDER@;
    border-radius: 10px;
    color: transparent;
    padding: 0;
}
QPushButton#obwBgModeBtn:hover {
    border-color: @BORDER_STRONG@;
    background-color: @BG_HOVER@;
}
QPushButton#obwBgModeBtn:checked {
    border-color: @PRIMARY@;
    background-color: @PRIMARY_BG@;
}
QLabel#obwBgModeIcon {
    color: @PRIMARY@;
    font-size: 15px;
    font-weight: 700;
}
QLabel#obwBgModeName {
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}
QLabel#obwBgModeHint {
    color: @TEXT_TERTIARY@;
    font-size: 10px;
}
QStackedWidget#obwBgSubStack {
    background-color: transparent;
}
QLabel#obwBgSubDesc {
    color: @TEXT_TERTIARY@;
    font-size: 12px;
}
/* 纯色模式：预设色块（checked 白描边由代码内联控制�?*/
QPushButton#obwColorSwatch {
    border-radius: 15px;
}
QLabel#obwImagePreview {
    background-color: @BG_MUTED@;
    border: 1px dashed @BORDER_STRONG@;
    border-radius: 8px;
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwBgPathLabel {
    color: @TEXT_TERTIARY@;
    font-size: 11px;
}
QLabel#obwAccentName {
    color: @TEXT_TERTIARY@;
    font-size: 11.5px;
}

/* --- 50.13 完成�?--- */
QLabel#obwDoneIcon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @PRIMARY@, stop:1 @PRIMARY_DARK@);
    border-radius: 48px;
    color: #FFFFFF;
    font-size: 44px;
    font-weight: 800;
}
QLabel#obwDoneTitle {
    color: @TEXT_PRIMARY@;
    font-size: 24px;
    font-weight: 800;
}
QLabel#obwDoneDesc {
    color: @TEXT_TERTIARY@;
    font-size: 13px;
}
QLabel#obwDoneChip {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
}

/* --- 50.14 底部导航 --- */
QFrame#obwFooter {
    background-color: transparent;
    border-top: 1px solid @BORDER@;
}
QLabel#obwFooterHint {
