    background-color: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#homeEmptyLabel {
    font-size: 15px;
    color: @TEXT_TERTIARY@;
    background-color: transparent;
    qproperty-alignment: AlignCenter;
}

QScrollArea#modScrollArea {
    background-color: transparent;
