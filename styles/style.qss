}

QPushButton#aiChatSkillBtn {
    background-color: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px 12px;
    color: @TEXT_SECONDARY@;
}

QPushButton#aiChatSkillBtn:hover {
    background-color: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}

QPushButton#aiChatSkillBtn[active="true"] {
    background-color: @PRIMARY_RGBA_18@;
