}

/* 顶栏实例名标�?*/
QLabel#instanceNameLabel {
    font-size: 13px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    background-color: transparent;
    padding: 0 4px;
}

/* 顶栏搜索图标按钮 */
QPushButton#topBarSearchBtn {
    background-color: transparent;
    border: none;
